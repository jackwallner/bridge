    "Bridge Minute, Game Night Prep, endless modes, and %lld more drills across every room": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Bridge Minute, forberedelse til bridgeaftenen, uendelige træningsformer og %lld øvelser mere i alle rum"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bridge Minute, Spielabend-Vorbereitung, Endlosmodi und %lld weitere Übungen in allen Räumen"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Bridge Minute, προετοιμασία για τη βραδιά μπριτζ, ατελείωτες λειτουργίες και %lld ακόμη ασκήσεις σε κάθε αίθουσα"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bridge Minute, Preparación para la partida, modos sin fin y %lld ejercicios extra en todas las áreas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bridge Minute, la préparation personnalisée pour vos soirées bridge, les modes infinis et %lld exercices supplémentaires dans toutes les salles"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Bridge Minute, Prepara la serata, modalità infinite e %lld esercizi in più in tutte le sale"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Bridge Minute、対局前の練習、エンドレスモードに加え、全部屋で%lld件の追加練習ができます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Bridge Minute, 브리지 모임 준비, 무한 모드, 그리고 모든 연습 영역의 추가 문제 %lld개"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bridge Minute, forberedelser til spillekvelden, endeløse økter og %lld flere øvelser i alle rom"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bridge Minute, persoonlijke voorbereiding op je speelavond, eindeloze modi en nog %lld oefeningen verspreid over alle kamers"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Bridge Minute, подготовка к вечеру бриджа, бесконечные режимы и ещё %lld упражнений в разных разделах"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bridge Minute, förberedelser inför spelkvällen, oändliga lägen och %lld extra övningar i alla områden"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Bridge Minute แบบฝึกเตรียมตัวก่อนคืนเล่นบริดจ์ โหมดฝึกไม่จำกัด และแบบฝึกเพิ่มอีก %lld ชุดในทุกห้อง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bridge Minute, briç gecesi hazırlığı, sonsuz modlar ve tüm odalarda %lld alıştırma daha"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Bridge Minute、牌局前練習、無限模式，以及各房間再多 %lld 項練習"
          }
        }
      }
    },
