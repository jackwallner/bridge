    "Bridge Trainer": {
      "shouldTranslate": false
    },
    "Bridge Trainer cannot send reminders until notifications are turned on in iOS Settings.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Bridge Trainer kan ikke sende påmindelser, før notifikationer er slået til i iOS-indstillingerne."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bridge Trainer kann keine Erinnerungen senden, solange Mitteilungen in den iOS-Einstellungen aus sind."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Bridge Trainer δεν μπορεί να στείλει υπενθυμίσεις μέχρι να ενεργοποιηθούν οι ειδοποιήσεις στις Ρυθμίσεις του iOS."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bridge Trainer no puede enviarte recordatorios hasta que actives las notificaciones en Ajustes de iOS."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bridge Trainer ne peut pas envoyer de rappels tant que les notifications ne sont pas activées dans les Réglages iOS."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Bridge Trainer non può inviare promemoria finché non attivi le notifiche nelle Impostazioni di iOS."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iOSの設定で通知をオンにするまで、Bridge Trainerはリマインダーを送れません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 설정에서 알림을 켜야 Bridge Trainer가 리마인더를 보낼 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bridge Trainer kan ikke sende påminnelser før varsler er slått på i iOS-innstillingene."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bridge Trainer kan geen herinneringen sturen zolang meldingen uit staan in de iOS-instellingen."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Bridge Trainer не сможет отправлять напоминания, пока ты не включишь уведомления в настройках iOS."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bridge Trainer kan inte skicka påminnelser förrän du aktiverar aviseringar i iOS-inställningarna."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Bridge Trainer ส่งการเตือนไม่ได้จนกว่าจะเปิดการแจ้งเตือนในการตั้งค่า iOS"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS Ayarları'nda bildirimler açılana kadar Bridge Trainer hatırlatıcı gönderemez."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 iOS 設定中開啟通知前，Bridge Trainer 無法傳送提醒。"
          }
        }
      }
    },
    "Bridge Trainer teaches beginner Standard American bidding, declarer play, and defense. Partnership agreements vary, so always confirm conventions with your partner.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Bridge Trainer lærer dig meldinger, spilføring og modspil efter Standard American for begyndere. Makkeraftaler varierer, så afstem altid konventioner med din makker."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bridge Trainer vermittelt Einsteigern die Reizung nach Standard American sowie Alleinspiel und Gegenspiel. Jedes Bridge-Paar trifft eigene Absprachen. Kläre Konventionen daher immer mit deinem Partner."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Bridge Trainer διδάσκει δηλώσεις, εκτέλεση και άμυνα στο Standard American για αρχάριους. Οι συμφωνίες διαφέρουν ανά ζευγάρι, γι' αυτό επιβεβαιώνετε πάντα τις συμβάσεις με τον συμπαίκτη σας."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bridge Trainer te enseña los fundamentos de Standard American para principiantes: subasta, juego del declarante y defensa. Los acuerdos varían entre parejas, así que confirma siempre las convenciones con tu pareja."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bridge Trainer enseigne aux débutants les enchères du système américain standard, le jeu du déclarant et la défense. Les accords varient selon les partenaires : vérifiez toujours vos conventions ensemble."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Bridge Trainer insegna licita, gioco del dichiarante e difesa secondo lo Standard American per principianti. Gli accordi variano tra le coppie, quindi verifica sempre le convenzioni con il compagno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Bridge Trainerは、初心者向けにスタンダード・アメリカンのビディング、ディクレアラーのプレイ、ディフェンスを教えます。ペアごとに取り決めが異なるため、採用するコンベンションは必ずパートナーと確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Bridge Trainer는 초보자가 Standard American 비딩, 선언자 플레이, 수비를 익히도록 돕습니다. 파트너마다 약속이 다르므로 컨벤션은 항상 파트너와 확인하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bridge Trainer lærer nybegynnere budgivning etter Standard American, spilleføring og motspill. Avtalene varierer fra makkerpar til makkerpar, så avklar alltid konvensjonene med makkeren din."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bridge Trainer leert beginners bieden volgens Standard American, afspelen als leider en verdedigen. Afspraken verschillen per paar, dus bespreek conventies altijd met je partner."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Bridge Trainer помогает новичкам освоить заявки по системе Standard American, розыгрыш и защиту. У каждой пары свои договорённости, поэтому всегда обсуждай конвенции с партнёром."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bridge Trainer lär nybörjare budgivning enligt Standard American, spelföring och försvarsspel. Överenskommelser varierar mellan par, så gå alltid igenom konventionerna med din partner."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Bridge Trainer สอนการประมูลแบบ Standard American สำหรับมือใหม่ รวมถึงการเล่นในฐานะดีแคลร์เรอร์และการป้องกัน ข้อตกลงของแต่ละคู่ต่างกัน ควรยืนยันคอนเวนชันกับคู่ของคุณเสมอ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bridge Trainer, yeni başlayanlara Standard American sisteminde ihale, deklaran oyunu ve savunmayı öğretir. Ortaklık anlaşmaları değişir; konvansiyonları her zaman ortağınızla teyit edin."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Bridge Trainer 以入門標準美式制度教你叫牌、莊家打牌和防守。各搭檔的約定不同，請務必和同伴確認約定叫。"
          }
        }
      }
    },
    "Bridge Trainer uses a beginner Standard American framework. Partnership agreements vary, so confirm conventions with your partner.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Bridge Trainer bruger et Standard American-system for begyndere. Makkeraftaler varierer, så afstem konventioner med din makker."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bridge Trainer nutzt das Standard-American-System für Einsteiger. Jedes Bridge-Paar trifft eigene Absprachen. Kläre Konventionen daher mit deinem Partner."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Bridge Trainer χρησιμοποιεί σύστημα Standard American για αρχάριους. Οι συμφωνίες διαφέρουν ανά ζευγάρι, γι' αυτό επιβεβαιώστε τις συμβάσεις με τον συμπαίκτη σας."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bridge Trainer sigue un enfoque Standard American para principiantes. Los acuerdos varían entre parejas, así que confirma las convenciones con tu pareja."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bridge Trainer utilise une version du système américain standard adaptée aux débutants. Les accords varient selon les partenaires : vérifiez vos conventions ensemble."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Bridge Trainer usa un sistema Standard American per principianti. Gli accordi variano tra le coppie, quindi verifica le convenzioni con il compagno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Bridge Trainerは初心者向けのスタンダード・アメリカンを基本にしています。ペアごとに取り決めが異なるため、コンベンションはパートナーと確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Bridge Trainer는 초보자를 위한 Standard American 방식을 따릅니다. 파트너마다 약속이 다르므로 컨벤션을 서로 확인하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bridge Trainer tar utgangspunkt i Standard American for nybegynnere. Avtalene varierer fra par til par, så avklar konvensjonene med makkeren din."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bridge Trainer gebruikt een Standard American-systeem voor beginners. Afspraken verschillen per paar, dus bespreek conventies met je partner."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Bridge Trainer знакомит с основами Standard American. Договорённости у каждой пары свои, поэтому обсуди конвенции с партнёром."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bridge Trainer utgår från Standard American för nybörjare. Överenskommelser varierar mellan par, så gå igenom konventionerna med din partner."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Bridge Trainer ใช้ระบบ Standard American สำหรับมือใหม่ ข้อตกลงของแต่ละคู่ต่างกัน ควรยืนยันคอนเวนชันกับคู่ของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bridge Trainer, başlangıç düzeyinde Standard American sistemini temel alır. Ortaklık anlaşmaları değişebilir; konvansiyonları ortağınızla teyit edin."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Bridge Trainer 採用入門標準美式制度。各搭檔的約定不同，請和同伴確認約定叫。"
          }
        }
      }
    },
    "Bridge fades fast between games. Bridge Trainer gives you five-minute drills you can run anywhere, whether you are meeting the deck or sharpening instincts you already have.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Bridge glemmes hurtigt mellem spilleaftener. Bridge Trainer giver dig femminutters øvelser, du kan lave overalt, uanset om du lige er begyndt at spille bridge eller vil skærpe dine instinkter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwischen den Spielabenden gerät Bridge schnell in Vergessenheit. Bridge Trainer bietet dir Fünf-Minuten-Übungen für zwischendurch, egal ob du Bridge gerade erst lernst oder dein Gespür schärfst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το μπριτζ ξεχνιέται γρήγορα ανάμεσα στις παρτίδες. Το Bridge Trainer σάς προσφέρει πεντάλεπτες ασκήσεις που μπορείτε να κάνετε οπουδήποτε, είτε τώρα αρχίζετε να παίζετε μπριτζ είτε ακονίζετε το ένστικτό σας."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Entre partidas, el bridge se olvida rápido. Bridge Trainer te ofrece ejercicios de cinco minutos para practicar donde quieras, tanto si empiezas con las cartas como si quieres afinar tu intuición de juego."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le bridge s'oublie vite entre deux parties. Bridge Trainer vous propose des exercices de cinq minutes à faire partout, que vous découvriez le jeu ou affûtiez vos réflexes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tra una partita e l'altra si dimentica in fretta ciò che si è imparato a bridge. Bridge Trainer ti propone esercizi di cinque minuti da fare ovunque, che tu stia imparando a giocare o affinando l'istinto che hai già."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブリッジの感覚はゲームの合間にすぐ鈍ります。Bridge Trainerなら、ブリッジを始めたばかりの人も、経験を積んで感覚を磨きたい人も、どこでも5分で練習できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "브리지는 게임 사이에 금방 잊히기 쉽습니다. Bridge Trainer는 어디서든 할 수 있는 5분 연습을 제공해 카드를 처음 접하는 분도, 이미 익숙한 분도 감각을 다듬을 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bridgekunnskaper forsvinner fort mellom spillekveldene. Med Bridge Trainer kan du øve i fem minutter hvor som helst, enten du er nybegynner eller vil skjerpe spillefølelsen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tussen speelavonden zakt je bridgekennis snel weg. Bridge Trainer geeft je oefeningen van vijf minuten die je overal kunt doen, of je nu net begint of je spelgevoel aanscherpt."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Между играми навыки бриджа быстро забываются. Bridge Trainer предлагает пятиминутные упражнения, которые можно пройти где угодно: освежи основы или оттачивай игровую интуицию."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bridgekunskaper bleknar snabbt mellan spelkvällarna. Med Bridge Trainer kan du öva i fem minuter var du än är, oavsett om du är nybörjare eller vill vässa spelkänslan."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทักษะบริดจ์เลือนหายเร็วเมื่อเว้นช่วงระหว่างเกม Bridge Trainer มีแบบฝึกห้านาทีให้ฝึกได้ทุกที่ ไม่ว่าคุณจะเพิ่งเริ่มเล่นบริดจ์หรืออยากลับคมสัญชาตญาณที่มีอยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Briç, oyun aralarında çabuk unutulur. Bridge Trainer, ister briçe yeni başlayın ister sezgilerinizi geliştirin, her yerde yapabileceğiniz beş dakikalık alıştırmalar sunar."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "兩場牌局之間，牌感很快就會生疏。不論你剛接觸橋牌，還是想磨練已有的牌感，Bridge Trainer 都提供隨時隨地可做的五分鐘練習。"
          }
        }
      }
    },
