    "Ace = 4 points, king = 3, queen = 2, jack = 1. Add those values across your 13 cards to estimate your hand's strength.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Es = 4 point, konge = 3, dame = 2, knægt = 1. Læg værdierne for dine 13 kort sammen for at vurdere din hånds styrke."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ass = 4 Punkte, König = 3, Dame = 2, Bube = 1. Addiere die Werte aller 13 Karten, um die Stärke deiner Hand einzuschätzen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Άσος = 4 πόντοι, ρήγας = 3, ντάμα = 2, βαλές = 1. Προσθέστε τις τιμές στα 13 φύλλα σας για να εκτιμήσετε τη δύναμη του χεριού."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "As = 4 puntos, rey = 3, reina = 2, sota = 1. Suma esos valores en tus 13 cartas para estimar la fuerza de tu mano."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "As = 4 points, roi = 3, dame = 2, valet = 1. Additionnez ces valeurs sur vos 13 cartes pour estimer la force de votre main."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Asso = 4 punti, re = 3, donna = 2, fante = 1. Somma questi valori sulle tue 13 carte per stimare la forza della mano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エース＝4点、キング＝3点、クイーン＝2点、ジャック＝1点。13枚の合計で手の強さを見積もります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에이스 = 4포인트, 킹 = 3, 퀸 = 2, 잭 = 1. 13장의 카드에 해당 값을 추가하여 핸드의 강도를 추정합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ess = 4 poeng, konge = 3, dame = 2, knekt = 1. Legg til disse verdiene på tvers av dine 13 kort for å estimere håndens styrke."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aas = 4 punten, heer = 3, vrouw = 2, boer = 1. Tel de punten van alle 13 kaarten bij elkaar op om de kracht van je hand te schatten."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Туз = 4 очка, король = 3, дама = 2, валет = 1. Сложите эти значения по своим 13 картам, чтобы оценить силу своей руки."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ess = 4 poäng, kung = 3, dam = 2, knekt = 1. Lägg till dessa värden över dina 13 kort för att uppskatta din hands styrka."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เอซ = 4 แต้ม คิง = 3 ควีน = 2 แจ็ค = 1 รวมแต้มไพ่ทั้ง 13 ใบเพื่อประเมินกำลังไพ่ในมือ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "As = 4 puan, papaz = 3, kız = 2, vale = 1. Elinizin gücünü tahmin etmek için elinizdeki 13 kartın puan değerlerini toplayın."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "A = 4 點，K = 3 點，Q = 2 點，J = 1 點。把 13 張牌的點數加起來，就能估算手牌強度。"
          }
        }
      }
    },
