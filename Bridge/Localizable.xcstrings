    "Choose the lowest card that is certain to win the completed trick.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg det laveste kort, der med sikkerhed vinder det færdige stik."
          }
        },
        "de": {
