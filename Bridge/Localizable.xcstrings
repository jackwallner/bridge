    "West leads the 7♥. You hold these four cards. Which card is legal?": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vest spiller 7♥ ud. Du har disse fire kort. Hvilket kort er lovligt?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "West spielt 7♥ aus. Du hältst diese vier Karten. Welche Karte ist regelkonform?"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η Δύση βγάζει το 7♥. Έχετε αυτά τα τέσσερα φύλλα. Ποιο φύλλο είναι νόμιμο;"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouest entame le 7♥. Vous tenez ces quatre cartes. Laquelle est légale ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovest attacca con il 7♥. Hai queste quattro carte. Quale carta puoi giocare?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "西が7♥をリードしました。あなたはこの4枚を持っています。出せるのはどのカード？"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "West komt uit met 7♥. Jij hebt deze vier kaarten. Welke kaart is reglementair?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตะวันตกลีด 7♥ คุณถือไพ่สี่ใบนี้ ใบไหนลงได้ตามกติกา"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Batı 7♥ ile atak yaptı. Bu dört kartınız var. Hangi kart kurala uygundur?"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "西家首攻 7♥。你持有這四張牌。哪張牌可以合法打出？"
          }
        }
      }
    },
