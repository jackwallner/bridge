    "Contract level plus book: 3 + 6 = 9 tricks, with no trump suit in play.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontraktens trin plus bogen: 3 + 6 = 9 stik, uden trumffarve."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontraktstufe plus Buch: 3 + 6 = 9 Stiche, ohne Trumpffarbe."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επίπεδο συμβολαίου συν το βιβλίο: 3 + 6 = 9 λεβέ, χωρίς χρώμα ατού."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Palier plus les six premières : 3 + 6 = 9 levées, sans couleur d'atout."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Livello del contratto più le prime sei: 3 + 6 = 9 prese, senza seme d'atout."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レベルにブックを足して3 + 6 = 9トリック。切り札のスートはありません。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niveau plus het boek: 3 + 6 = 9 slagen, zonder troefkleur."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ระดับสัญญาบวกบุ๊ก: 3 + 6 = 9 ทริก ไม่มีชุดทรัมป์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrat seviyesi artı kitap: 3 + 6 = 9 löve, koz rengi olmadan."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "階數加上基本墩：3 + 6 = 9 墩，沒有王牌花色。"
          }
        }
      }
    },
    "Contract levels count above six. 3NT therefore requires 6 + 3 = 9 tricks.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Trin tæller ud over seks. 3NT kræver derfor 6 + 3 = 9 stik."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontraktstufen zählen über sechs. 3NT verlangt also 6 + 3 = 9 Stiche."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα επίπεδα μετρούν πάνω από το έξι. Τα 3NT απαιτούν λοιπόν 6 + 3 = 9 λεβέ."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les paliers comptent au-delà de six. 3NT demande donc 6 + 3 = 9 levées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I livelli contano oltre le sei. 3NT richiede quindi 6 + 3 = 9 prese."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レベルは6を超える数です。3NTは6 + 3 = 9トリックが必要です。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niveaus tellen boven zes. 3NT vraagt dus 6 + 3 = 9 slagen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ระดับนับเกินหก 3NT จึงต้องทำ 6 + 3 = 9 ทริก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seviyeler altının üzerinden sayılır. 3NT bu yüzden 6 + 3 = 9 löve ister."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "階數從六以上計算，所以 3NT 需要 6 + 3 = 9 墩。"
          }
        }
      }
    },
