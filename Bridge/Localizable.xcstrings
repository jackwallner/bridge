    "1 high-card point, %@. You need about 13 to open at the one level, so pass and wait for your partner.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "1 honnørpoint, %@. Du skal have omkring 13 for at åbne på 1-trinnet, så pas og vent på din makker."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "1 Figurenpunkt, %@. Für eine Eröffnung auf Einerstufe brauchst du etwa 13, also passe und warte auf deinen Partner."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "1 πόντος τιμής, %@. Χρειάζεστε περίπου 13 για άνοιγμα στο επίπεδο του ενός, άρα πάσο και περιμένετε τον συμπαίκτη."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "1 point H, %@. Il faut environ 13 points pour ouvrir au palier de un : passez et laissez parler votre partenaire."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "1 punto onori, %@. Servono circa 13 punti per aprire a livello uno, quindi passa e aspetta il compagno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ハイカードポイント1点、%@。1レベルでオープンするには13点前後が必要なので、パスしてパートナーを待ちます。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "1 honneurpunt, %@. Je hebt ongeveer 13 nodig om op eenniveau te openen, dus pas en wacht op je partner."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แต้มไพ่สูง 1 แต้ม %@ ต้องมีราว 13 แต้มถึงจะเปิดที่ระดับหนึ่ง จึงพาสแล้วรอคู่ของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "1 onör puanı, %@. Birli seviyede açmak için yaklaşık 13 gerekir; pas deyin ve ortağınızı bekleyin."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "1 個大牌點，%@。一階開叫約需 13 點，所以派司，等同伴發言。"
          }
        }
      }
    },
