    "New hand-written questions across the auction, declarer play, defense, and the Master Tables.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Nye specialskrevne spørgsmål om meldinger, spilføring, modspil og mesterbordene."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neue redaktionell verfasste Fragen zu Reizung, Alleinspiel, Gegenspiel und den Meistertischen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Νέες, πρωτότυπες ερωτήσεις για δηλώσεις, εκτέλεση, άμυνα και τα τραπέζια των μάστερ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nuevas preguntas escritas a mano sobre la subasta, el juego del declarante, la defensa y las mesas maestras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des questions inédites sur les enchères, le jeu du déclarant, la défense et les tables des maîtres."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nuove domande scritte appositamente su licita, gioco del dichiarante, difesa e tavoli dei maestri."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オークション、ディクレアラーのプレイ、ディフェンス、マスターテーブルの新しいオリジナル問題。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "경매, 선언자 플레이, 방어 및 마스터 테이블 전반에 걸쳐 직접 작성한 새로운 질문입니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Nye håndskrevne spørsmål på tvers av auksjonen, spilleren, forsvaret og Master-tabellene."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nieuwe, zelfgeschreven vragen over bieden, afspel, verdediging en de meestertafels."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Новые рукописные вопросы по аукциону, игре разыгрывающего, защите и главным столам."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nya handskrivna frågor över auktionen, deklarerarspel, försvar och Master Tables."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คำถามใหม่ที่เขียนเองเกี่ยวกับการประมูล การเล่นของดีแคลร์เรอร์ การป้องกัน และโต๊ะมาสเตอร์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İhale, deklaran oyunu, savunma ve Usta Masaları için yeni, özenle hazırlanmış sorular."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "叫牌、莊家打牌、防守與大師牌桌的全新原創題目。"
          }
        }
      }
    },
