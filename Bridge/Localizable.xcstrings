    "Ninety seconds, as many correct calls as you can manage, and a personal best to chase.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Halvfems sekunder, så mange rigtige meldinger som muligt og en personlig rekord at jagte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neunzig Sekunden, so viele richtige Gebote wie möglich und eine Bestmarke zum Jagen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ενενήντα δευτερόλεπτα, όσες σωστές δηλώσεις προλάβετε και ένα προσωπικό ρεκόρ για κυνήγι."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quatre-vingt-dix secondes, un maximum de bonnes enchères et un record personnel à battre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Novanta secondi, quante più dichiarazioni giuste possibile e un record personale da inseguire."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "90秒で、できるだけ多く正しいビッドを。自己ベストを目指しましょう。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Negentig seconden, zoveel mogelijk goede biedingen en een persoonlijk record om op te jagen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เก้าสิบวินาที ตอบบิดให้ถูกมากที่สุด และไล่ล่าสถิติส่วนตัว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Doksan saniye, yapabildiğiniz kadar doğru deklarasyon ve kovalayacak bir kişisel rekor."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "九十秒內答對越多越好，挑戰個人紀錄。"
          }
        }
      }
    },
