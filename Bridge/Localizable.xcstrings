    "Know tricks and points, still slow in the auction": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeg har styr på stik og point, men er stadig langsom i meldingerne"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kenne Stiche und Punkte, in der Reizung noch langsam"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ξέρω από λεβέ και πόντους, αλλά αργώ στην αγορά"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conozco las bazas y los puntos, pero aún me cuesta la subasta"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je connais les levées et les points, mais les enchères me ralentissent encore"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Conosco prese e punti, ma la licita mi rallenta"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トリックと点数はわかるが、ビッドの判断はまだ遅い"
