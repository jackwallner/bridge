        }
      }
    },
    "Why is leading an unsupported ace against a suit contract usually a poor choice?": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvorfor er udspil af et ubeskyttet es mod en trumfkontrakt som regel et dårligt valg?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Warum ist ein ungestütztes Ass gegen einen Farbkontrakt meist ein schlechtes Ausspiel?"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Γιατί είναι συνήθως κακή επιλογή να κάνετε αντάμ με ακάλυπτο άσο απέναντι σε συμβόλαιο με ατού;"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Por qué suele ser mala idea salir de un as sin apoyo contra un contrato a palo?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pourquoi est-il souvent déconseillé d'entamer d'un as sans autre honneur contre un contrat à la couleur ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Perché attaccare con un asso senza il re contro un contratto a colore è di solito una cattiva scelta?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スートコントラクトに対し、他のオナーに支えられていないエースをリードするのは、なぜ通常よくないのでしょうか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "수트 계약에서 받쳐 주는 고카드가 없는 에이스를 리드하면 보통 왜 좋지 않을까요?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvorfor er det som regel dårlig å spille ut et ess uten kongestøtte mot en fargekontrakt?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Waarom is uitkomen met een ongesteund aas tegen een troefcontract meestal een slechte keuze?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Почему первый выход неподдержанным тузом против контракта в масти обычно плох?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Varför är det oftast dåligt att spela ut ett ess utan stöd mot ett färgkontrakt?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทำไมการลีดเอซที่ไม่มีไพ่หนุนเมื่อเจอสัญญาที่มีทรัมป์มักเป็นตัวเลือกที่ไม่ดี"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kozlu kontrata karşı papazsız as ile atak yapmak neden genellikle kötü bir seçimdir?"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為什麼對抗有王合約時，通常不宜首攻缺少大牌支援的 A？"
          }
        }
      }
    },
