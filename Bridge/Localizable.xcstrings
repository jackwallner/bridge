    "The defender on declarer's left leads to the first trick, before dummy comes down.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Modspilleren til venstre for spilføreren spiller ud til første stik, før bordet lægges op."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Gegenspieler links vom Alleinspieler spielt zum ersten Stich aus, bevor der Dummy aufgelegt wird."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο αμυνόμενος στα αριστερά του εκτελεστή κάνει την αντάμ πριν απλωθεί ο μορ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El defensor a la izquierda del declarante sale a la primera baza antes de que se muestre el muerto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le défenseur à gauche du déclarant entame la première levée, avant que le mort soit étalé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il difensore alla sinistra del dichiarante attacca alla prima presa, prima che il morto venga scoperto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダミーがテーブルに出る前に、ディクレアラーの左のディフェンダーが最初のトリックをリードします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선언자 왼쪽 수비자가 첫 트릭을 리드해요. 그 뒤에 더미가 공개돼요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Motspilleren til venstre for spillefører spiller ut til første stikk før blindemann legger opp kortene."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De verdediger links van de leider komt uit voor de eerste slag, voordat de dummy op tafel komt."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Защитник слева от разыгрывающего делает первый выход до того, как болван откроет карты."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Motspelaren till vänster om spelföraren spelar ut till första sticket innan träkarlen läggs upp."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ฝ่ายป้องกันทางซ้ายของดีแคลร์เรอร์ลีดทริกแรก ก่อนดัมมี่เปิดไพ่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Deklaranın solundaki savunmacı, yer açılmadan ilk atağı yapar."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "莊家左手的防家在夢家攤牌前首攻第一墩。"
          }
        }
      }
    },
    "The director": {
      "extractionState": "manual",
      "localizations": {
