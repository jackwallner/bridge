    "Fifteen points, balanced 4-3-3-3, and no five-card major. That is the 1NT range exactly.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Femten point, jævn 4-3-3-3 og ingen femkorts højfarve. Det er præcis intervallet for en 1NT-åbning."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fünfzehn Punkte, ausgeglichen 4-3-3-3, keine Fünferoberfarbe. Das ist genau der 1NT-Bereich."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεκαπέντε πόντοι, ισόρροπο 4-3-3-3, χωρίς πεντάφυλλο μείζον. Ακριβώς το εύρος του 1NT."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quince puntos, distribución equilibrada 4-3-3-3 y ningún palo mayor de cinco cartas. Es justo el rango para abrir 1NT."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quinze points, une main régulière 4-3-3-3, sans majeure cinquième : c'est exactement la zone du 1NT."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quindici punti, bilanciata 4-3-3-3 e nessun nobile quinto. È esattamente la fascia di 1NT."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "15点の4-3-3-3バランスハンドで、5枚のメジャーはありません。まさに1NTの範囲です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "15점, 균형형 4-3-3-3, 5장 메이저 수트 없음. 정확히 1NT 오프닝 범위예요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "15 poeng, balansert 4-3-3-3-hånd og ingen majorfarge med fem kort. Det er nøyaktig området for 1NT."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vijftien punten, verdeeld 4-3-3-3 en geen vijfkaart hoge kleur. Precies de 1NT-marge."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "15 очков, сбалансированный расклад 4-3-3-3, без пяти карт в старшей масти. Это точный диапазон для открытия 1NT."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "15 poäng, balanserad 4-3-3-3-fördelning och ingen femkortshögfärg. Det är precis 1NT-intervallet."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สิบห้าแต้ม มือสมดุล 4-3-3-3 ไม่มีเมเจอร์ห้าใบ ตรงกับช่วง 1NT พอดี"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "On beş puan, dengeli 4-3-3-3 ve beşli majör yok. Tam 1NT aralığı."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "15 點、4-3-3-3 平均牌型、沒有五張高花，正是 1NT 的範圍。"
          }
        }
      }
    },
