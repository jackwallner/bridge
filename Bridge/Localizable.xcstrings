    "Play low. If you rise with the king, dummy's ace wins and the jack may become good.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Spil lille. Går du op med kongen, vinder bordets es, og knægten kan blive god."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spiel klein. Gehst du mit dem König hoch, gewinnt das Ass des Dummys und der Bube kann hoch werden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Παίξτε μικρό. Αν ανεβείτε με τον ρήγα, κερδίζει ο άσος του μορ και ο βαλές μπορεί να γίνει σίγουρη λεβέ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Juega bajo. Si sube con el rey, el as del muerto gana y la jota puede volverse buena."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jouez petit. Si vous montez du roi, l'as du mort gagne et le valet peut devenir maître."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gioca basso. Se sali con il re, vince l'asso del morto e il fante può diventare buono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "小さく出します。キングを出すとダミーのエースが勝ち、ジャックが勝ち札になるかもしれません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "낮게 재생합니다. 킹과 함께 상승하면 더미의 에이스가 승리하고 잭이 좋아질 수도 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Spill lavt. Hvis du går opp med kongen, vinner blindemanns ess, og knekten kan bli god."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Speel klein. Ga je hoog met de heer, dan wint de aas van de dummy en kan de boer goed worden."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Играйте низко. Если вы подниметесь с королем, туз болвана выиграет, а валет может стать хорошим."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Spela lågt. Om du går upp med kungen vinner träkarlens ess, och knekten kan bli god."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลงใบเล็ก ถ้าลงคิง เอซของดัมมี่จะชนะ และแจ็คอาจกลายเป็นไพ่ชนะ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Küçük oynayın. Papazı koyarsanız yerin ası kazanır ve vale de alıcı hâle gelebilir."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "出小牌。如果你出 K，夢家的 A 會贏，J 就可能成為贏墩。"
          }
        }
      }
    },
