    },
    "You must discard and want a diamond back": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du skal kaste af og vil have ruder tilbage"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du musst abwerfen und willst, dass dein Partner Karo zurückspielt"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πρέπει να πετάξετε φύλλο και θέλετε να σας επιστρέψουν καρό"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous devez défausser et voulez un retour carreau"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Devi scartare e vuoi un ritorno a quadri"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "捨て札が必要で、ダイヤを返してほしい"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je moet afgooien en wilt ruiten terug"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณต้องทิ้งไพ่และอยากให้คู่ลีดข้าวหลามตัดกลับมา"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İskarta yapmanız gerekiyor ve karo dönüşü istiyorsunuz"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你必須墊牌，並希望同伴回方塊"
          }
        }
      }
    },
    "You must follow suit whenever you hold the suit led. Which heart you choose is up to you.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du skal bekende, når du har den spillede farve. Hvilken hjerter du vælger, bestemmer du selv."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du musst bedienen, wann immer du die ausgespielte Farbe hast. Welches Coeur du wählst, ist deine Sache."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πρέπει να ακολουθείτε χρώμα όποτε το έχετε. Ποια κούπα θα διαλέξετε είναι δική σας επιλογή."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous devez fournir dès que vous avez la couleur jouée. Le choix du cœur vous appartient."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Devi rispondere al colore ogni volta che hai il seme giocato. Sta a te scegliere quale carta di cuori giocare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リードされたスートを持っていれば必ず従います。どのハートを出すかは自由です。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je moet bekennen zodra je de gespeelde kleur hebt. Welke harten je kiest, mag je zelf weten."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ต้องตามชุดทุกครั้งที่มีชุดที่ลีด จะลงโพแดงใบไหนขึ้นอยู่กับคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Açılan renk elinizdeyse uymalısınız. Hangi kupayı seçeceğiniz size kalmış."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只要你有這門花色，就必須跟牌。紅心要出哪張由你決定。"
          }
        }
      }
    },
    "You must follow the suit led whenever you can. The card need not be high.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du skal bekende kulør, når du kan. Kortet behøver ikke være højt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du musst die ausgespielte Farbe bedienen, wann immer du kannst. Die Karte muss nicht hoch sein."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πρέπει να ακολουθείτε το χρώμα που βγήκε όποτε μπορείτε. Το φύλλο δεν χρειάζεται να είναι μεγάλο."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous devez fournir dans la couleur jouée dès que vous le pouvez. La carte n'a pas besoin d'être forte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Devi rispondere al colore ogni volta che puoi. La carta non deve essere alta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "出せるときは必ずリードされたスートに従います。高いカードでなくても構いません。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je moet de gespeelde kleur bekennen als je kunt. De kaart hoeft niet hoog te zijn."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ต้องลงตามชุดที่ลีดทุกครั้งที่ทำได้ ไม่จำเป็นต้องเป็นไพ่สูง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Açılan renge her uyabildiğinizde uymalısınız. Kartın büyük olması gerekmez."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只要有這門花色就必須跟牌，不必出大牌。"
          }
        }
      }
    },
