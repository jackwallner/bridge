    "Choose your usual bridge night and get a five-minute session built from your mistakes and weakest room when it matters.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg din faste bridgeaften, og få en femminutters runde bygget på dine fejl og dit svageste rum, når det gælder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle deinen üblichen Bridgeabend und erhalte genau dann eine Fünf-Minuten-Runde, die deine Fehler aufgreift und Übungen aus deinem schwächsten Raum enthält."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Διαλέξτε τη συνηθισμένη σας βραδιά μπριτζ και λάβετε τότε μια πεντάλεπτη συνεδρία εξάσκησης, προσαρμοσμένη στα λάθη σας και στην αίθουσα που σας δυσκολεύει περισσότερο."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez votre soirée bridge habituelle et recevez au bon moment une séance de cinq minutes axée sur vos erreurs et la salle où vous avez le plus de lacunes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli la tua solita serata di bridge e ricevi una sessione di cinque minuti costruita sui tuoi errori e sulla sala più debole, quando serve."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いつものブリッジの夜を選ぶと、ミスと最も苦手な部屋から作った5分のセッションが、ちょうどよいときに届きます。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies je vaste bridgeavond en krijg een sessie van vijf minuten op basis van je fouten en je zwakste kamer, precies wanneer het telt."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกคืนเล่นบริดจ์ประจำของคุณ แล้วรับเซสชันฝึกห้านาทีจากข้อที่พลาดและห้องที่อ่อนที่สุดในช่วงเวลาที่เหมาะ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her zamanki briç gecenizi seçin, hatalarınızdan ve en zayıf odanızdan oluşan beş dakikalık oturumu tam zamanında alın."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選好你平常打橋牌的晚上，需要時就會收到依照錯題和最弱房間安排的五分鐘練習。"
          }
        }
      }
    },
