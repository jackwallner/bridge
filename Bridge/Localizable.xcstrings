            "value": "Un contrat de 4♠ promet 10 levées à l'atout pique."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un contratto di 4♠ promette 10 prese con le picche come atout."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "4♠のコントラクトは、スペードを切り札に10トリックを約束します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "4♣ 계약은 스페이드를 트럼프로 사용하여 10가지 트릭을 약속합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En kontrakt på 4♠ lover 10 stikk med spar som trumf."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een contract van 4♠ belooft 10 slagen met schoppen als troef."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Контракт 4♠ обещает 10 взяток с пиками в качестве козыря."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett kontrakt på 4♠ lovar 10 stick med spader som trumf."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สัญญา 4♠ หมายถึงทำ 10 ทริกโดยมีโพดำเป็นทรัมป์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maça kozlu 4♠ kontratı 10 löve vaat eder."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "4♠ 合約承諾以黑桃為王牌拿 10 墩。"
          }
        }
      }
    },
