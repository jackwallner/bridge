    "At that time each %@, the notification opens directly into your personalized practice session.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hver %@ får du på det tidspunkt en notifikation, der åbner din personlige træningsrunde direkte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Mitteilung führt dich jeden %@ zu dieser Zeit direkt in deine persönliche Übungsrunde."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κάθε %@, την ώρα που έχετε ορίσει, η ειδοποίηση σάς μεταφέρει απευθείας στην εξατομικευμένη συνεδρία εξάσκησής σας."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A esa hora cada %@, la notificación te lleva directamente a tu sesión de práctica personalizada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque %@, à l'heure choisie, la notification vous mène directement à votre séance personnalisée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "A quell'ora, ogni %@, la notifica ti porta direttamente alla tua sessione di allenamento personalizzata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "毎週%@のその時刻に、通知からあなた専用の練習セッションを直接開きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "매번 %@에 알림을 누르면 맞춤 연습 세션이 바로 열려요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hver %@ åpner varselet den personlige øvingsøkten din direkte på det valgte tidspunktet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Op dat tijdstip brengt de melding je elke %@ meteen naar je persoonlijke oefensessie."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В выбранный день недели (%@) уведомление откроет вашу персональную сессию практики."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Samma tid varje %@ öppnar notisen direkt till ditt personliga övningspass."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ในแต่ละ %@ เมื่อถึงเวลานั้น การแจ้งเตือนจะพาคุณเข้าสู่เซสชันฝึกที่ปรับให้เหมาะกับคุณทันที"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her %@ o saatte bildirim doğrudan kişisel alıştırma oturumunuzu açar."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每到 %@ 的這個時間，通知會直接開啟你的個人化練習。"
          }
        }
      }
    },
    "At the same level, bids rank clubs, diamonds, hearts, spades, then notrump.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "På samme trin er rækkefølgen klør, ruder, hjerter, spar og så sans."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf derselben Stufe gilt: Treff, Karo, Coeur, Pik, dann Sans Atout."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Στο ίδιο επίπεδο η σειρά είναι σπαθιά, καρά, κούπες, πίκες και μετά χωρίς ατού."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A igual nivel, el orden de los cantos es tréboles, diamantes, corazones, picas y, por último, sin triunfo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À palier égal, l'ordre est trèfle, carreau, cœur, pique, puis sans-atout."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Allo stesso livello l'ordine è fiori, quadri, cuori, picche, poi senza atout."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じレベルではクラブ、ダイヤ、ハート、スペード、ノートランプの順に高くなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "같은 레벨에서는 클럽, 다이아몬드, 하트, 스페이드, 노트럼프 순으로 비드 순위가 높아져요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "På samme nivå følger meldingene fargerekkefølgen kløver, ruter, hjerter, spar, deretter grand."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Op hetzelfde niveau is de volgorde klaveren, ruiten, harten, schoppen en dan sans atout."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На одном уровне заявки идут по старшинству мастей: трефы, бубны, червы, пики, затем без козыря."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "På samma nivå rangordnas buden klöver, ruter, hjärter, spader och sist sang."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ในระดับเดียวกัน ลำดับคือดอกจิก ข้าวหลามตัด โพแดง โพดำ แล้วจึงเป็นโนทรัมป์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aynı seviyede sıra sinek, karo, kupa, maça ve ardından sanzatudur."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "同一階中，由小到大是梅花、方塊、紅心、黑桃，再來是無王。"
          }
        }
      }
    },
