    "A discard cannot win unless it is trump, and notrump has no trump suit.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Et afkast kan kun vinde, hvis det er trumf, og sans har ingen trumffarve."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Abwurf kann einen Stich nur mit Trumpf gewinnen. Bei Sans Atout gibt es keine Trumpffarbe."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το φύλλο που πετάτε κερδίζει τη λεβέ μόνο αν είναι ατού, ενώ σε συμβόλαιο χωρίς ατού δεν υπάρχει χρώμα ατού."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un descarte no puede ganar la baza salvo que sea triunfo. En un contrato sin triunfo no hay palo de triunfo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une carte jouée hors couleur ne remporte la levée que si c'est un atout. À sans-atout, aucun atout n'est en jeu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Uno scarto non può vincere se non è un atout, e a senza atout non ci sono atout."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "捨て札は切り札でない限り勝てず、ノートランプには切り札のスートがありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "버린 카드는 트럼프가 아닌 한 트릭을 이길 수 없어요. 노트럼프에는 트럼프 수트가 없어요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Et avkast vinner ikke stikket med mindre kortet er trumf. I grand finnes det ingen trumffarge."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een afgooier kan alleen een slag winnen als die een troef is; sans atout heeft geen troefkleur."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сброс не может взять взятку, если только это не козырь. В контракте без козыря козырей нет."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En sakning kan inte vinna sticket om kortet inte är trumf. I sang finns ingen trumffärg."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไพ่ที่ทิ้งชนะไม่ได้เว้นแต่เป็นทรัมป์ และโนทรัมป์ไม่มีชุดทรัมป์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir ıskarta koz değilse kazanamaz ve sanzatuda koz rengi yoktur."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "墊牌除非是王牌否則贏不了，而無王沒有王牌花色。"
          }
        }
      }
    },
