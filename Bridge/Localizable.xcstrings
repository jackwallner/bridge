    "No trump is in play. You are last to a trick of 10♦, 3♦, K♦. Which card wins?": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen trumf i spil. Du er sidst i et stik med 10♦, 3♦, K♦. Hvilket kort vinder?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Trumpf im Spiel. Du bist Letzter in einem Stich mit 10♦, 3♦, K♦. Welche Karte gewinnt?"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν υπάρχει ατού. Είστε τελευταίος σε λεβέ με 10♦, 3♦, K♦. Ποιο φύλλο κερδίζει;"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas d'atout en jeu. Vous jouez en dernier sur 10♦, 3♦, K♦. Quelle carte gagne ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Niente atout in gioco. Sei ultimo in una presa con 10♦, 3♦, K♦. Quale carta vince?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "切り札なし。10♦、3♦、K♦のトリックで最後に出します。勝つカードは？"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen troef in het spel. Je speelt als laatste op 10♦, 3♦, K♦. Welke kaart wint?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีทรัมป์ คุณลงคนสุดท้ายในทริกที่มี 10♦, 3♦, K♦ ไพ่ใบไหนชนะ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Koz yok. 10♦, 3♦, K♦ olan lövede son sizsiniz. Hangi kart kazanır?"
