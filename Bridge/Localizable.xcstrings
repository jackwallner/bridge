    "Learned what I needed": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lærte det, jeg havde brug for"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hab gelernt, was ich brauchte"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Έμαθα ό,τι χρειαζόμουν"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "J'ai appris ce qu'il me fallait"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ho imparato ciò che mi serviva"
          }
