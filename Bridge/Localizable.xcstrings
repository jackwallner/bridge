    "Count the suit before holding up. Do not duck if the contract is in immediate danger elsewhere.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tæl kortene i farven, før du dukker. Duk ikke, hvis kontrakten er i umiddelbar fare i en anden farve."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zähl die Farbe, bevor du duckst. Duck nicht, wenn der Kontrakt anderswo akut gefährdet ist."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μετρήστε πρώτα το χρώμα πριν καθυστερήσετε να πάρετε τη λεβέ. Μην το κάνετε αν το συμβόλαιο κινδυνεύει άμεσα σε άλλο χρώμα."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuenta las cartas del palo antes de dejar pasar. No dejes pasar si el contrato corre peligro inmediato en otro palo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comptez la couleur avant de laisser passer. Ne le faites pas si le contrat est en danger immédiat ailleurs."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Conta le carte del seme prima di lisciare. Non lisciare se il contratto è in pericolo immediato per un altro seme."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ホールドアップの前にスートの枚数を数えます。別のスートでコントラクトがすぐにダウンしそうなら、ダックしないこと。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "멈춰서기 전에 수트 분포를 세어 보세요. 다른 수트에서 바로 계약이 무너질 상황이라면 일부러 낮게 내지 마세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tell fargen før du venter med å ta stikket. Ikke vent hvis kontrakten er i umiddelbar fare i en annen farge."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tel de kleur voor je inhoudt. Duik niet als het contract elders direct in gevaar is."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Посчитайте карты в масти, прежде чем задержать взятку. Не задерживайте её, если в другой масти контракту грозит немедленный проигрыш."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Räkna korten i färgen innan du håller upp esset. Släpp inte sticket om kontraktet hotas direkt i en annan färg."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "นับไพ่ในชุดก่อนโฮลด์อัป อย่าปล่อยผ่านหากสัญญาเสี่ยงเสียทริกจากชุดอื่นอยู่แล้ว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Löveyi bırakmadan önce rengin dağılımını sayın. Kontrat başka bir renkte hemen düşme tehlikesindeyse löveyi bilerek vermeyin."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "忍讓前先算這門花色。若合約在別處有立即危險，就不要忍讓。"
          }
        }
      }
    },
