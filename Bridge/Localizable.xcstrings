    "A low trump outranks a high card in the suit led.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En lav trumf slår et højt kort i den spillede farve."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein kleiner Trumpf schlägt eine hohe Karte der ausgespielten Farbe."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ένα μικρό ατού κερδίζει ακόμη κι ένα μεγάλο φύλλο στο χρώμα που βγήκε."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un triunfo bajo supera a cualquier carta del palo de salida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un petit atout bat une grosse carte de la couleur jouée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un atout basso batte una carta alta del seme giocato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "低い切り札でも、リードされたスートの高いカードに勝ちます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "낮은 트럼프도 리드된 수트의 높은 카드보다 순위가 높아요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En liten trumf slår et høyt kort i utspillsfargen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een lage troef is hoger dan een hoge kaart in de gespeelde kleur."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Даже младший козырь бьёт старшую карту в масти выхода."
          }
        },
        "sv": {
          "stringUnit": {
