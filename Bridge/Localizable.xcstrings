    "A discard cannot win unless it is trump, and notrump has no trump suit.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Et afkast kan kun vinde, hvis det er trumf, og sans har ingen trumffarve."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Abwurf kann nur als Trumpf gewinnen, und Sans Atout hat keine Trumpffarbe."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ένα πέταμα δεν κερδίζει αν δεν είναι ατού, και το χωρίς ατού δεν έχει χρώμα ατού."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une défausse ne gagne que si c'est un atout, et le sans-atout n'a pas d'atout."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Uno scarto non può vincere se non è atout, e il senza atout non ha atout."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "捨て札は切り札でない限り勝てず、ノートランプには切り札のスートがありません。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een afgooier kan alleen winnen als het troef is, en sans atout heeft geen troefkleur."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไพ่ที่ทิ้งชนะไม่ได้เว้นแต่เป็นทรัมป์ และโนทรัมป์ไม่มีชุดทรัมป์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir ıskarta koz değilse kazanamaz ve sanzatuda koz rengi yoktur."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "墊牌除非是王牌否則贏不了，而無王沒有王牌花色。"
          }
        }
      }
    },
