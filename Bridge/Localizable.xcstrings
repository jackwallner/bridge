    "Saved. It will send the next time you open the app with a connection.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemt. Sendes næste gang, du åbner appen med forbindelse."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gespeichert. Wird gesendet, sobald du die App das nächste Mal mit Internetverbindung öffnest."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αποθηκεύτηκε. Θα σταλεί την επόμενη φορά που θα ανοίξετε την εφαρμογή με σύνδεση."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardado. Se enviará la próxima vez que abras la aplicación con una conexión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistré. Le message sera envoyé à votre prochaine ouverture de l'app si vous êtes connecté."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvato. Verrà inviato la prossima volta che apri l'app con una connessione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存しました。次に接続した状態でアプリを開いたときに送信されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가 저장되었습니다. 다음에 연결하여 앱을 열 때 전송됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "lagret. Den sendes neste gang du åpner appen med en tilkobling."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewaard. Wordt verstuurd zodra je de app opent met een internetverbinding."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохранено. Он будет отправлен при следующем открытии приложения с подключением."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sparad. Den skickas nästa gång du öppnar appen med en anslutning."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึกแล้ว จะส่งให้เมื่อคุณเปิดแอปครั้งถัดไปขณะเชื่อมต่ออินเทอร์เน็ต"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaydedildi. İnternet bağlantınız varken uygulamayı bir sonraki açışınızda gönderilecek."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已儲存。下次在連線時開啟 App 就會送出。"
          }
        }
      }
    },
    "Second hand low protects honors that sit in front of dummy.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Anden hånd lavt beskytter honnører, der sidder foran bordet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zweite Hand tief schützt Honneurs, die vor dem Dummy sitzen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το δεύτερο χέρι χαμηλά προστατεύει τα ονέρ που βρίσκονται μπροστά από τον μορ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El segundero bajo protege los honores que se encuentran frente al muñeco."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le petit en second protège les honneurs placés devant le mort."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Giocare basso da secondo di mano protegge gli onori che stanno davanti al morto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セカンドハンド・ローは、ダミーの前にあるオナーを守ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "초침 로우는 더미 앞에 앉은 명예를 보호합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Second hand low beskytter æresbevisninger som sitter foran blindemann."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tweede hand laag beschermt honneurs die voor de dummy zitten."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Низ секонд-хэнда защищает почестей, сидящих перед болваном."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Second hand low skyddar utmärkelser som sitter framför träkarlen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ผู้เล่นคนที่สองลงต่ำช่วยปกป้องออนเนอร์ที่อยู่หน้าดัมมี่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İkinci el küçük oynar, böylece yerin önündeki onörleri korur."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "二家出小，保護位在夢家前面的大牌。"
          }
        }
      }
    },
