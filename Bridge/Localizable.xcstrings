    "Book is the first six tricks. Contract levels name the number of tricks required beyond book.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Bogen er de første seks stik. Kontraktens trin angiver, hvor mange stik der kræves ud over bogen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Buch umfasst die ersten sechs Stiche. Die Kontraktstufe gibt an, wie viele Stiche über das Buch hinaus nötig sind."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι πρώτες έξι λεβέ αποτελούν τη βάση. Το επίπεδο του συμβολαίου δείχνει πόσες επιπλέον λεβέ απαιτούνται."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El libro son los primeros seis bazas. Los niveles de contrato nombran la cantidad de bazas necesarios más allá del libro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les six premières levées constituent la base. Le palier du contrat indique le nombre de levées à réaliser en plus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le prime sei prese sono la base. Il livello del contratto indica quante prese servono in più."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブックとは最初の6トリックのことです。コントラクトのレベルは、ブックを超えて必要なトリック数を表します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Book은 처음 6가지 트릭입니다. 계약 수준은 책 외에 필요한 트릭의 수를 지정합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Book er de seks første stikkene. Kontraktsnivåer navngir antall stikk som kreves utover boken."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het boek is de eerste zes slagen. Het contractniveau geeft aan hoeveel slagen je boven het boek moet halen."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Книга ,  первые шесть трюков. Уровни контракта определяют количество трюков, необходимых сверх книги."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Book är de sex första knepen. Kontraktsnivåer anger antalet stick som krävs utöver boken."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บุ๊กคือหกทริกแรก ระดับสัญญาบอกจำนวนทริกที่ต้องทำเกินบุ๊ก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İlk altı löve temel alınır. Kontrat seviyesi, bunun üzerine gereken ek löve sayısını belirtir."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "基本墩就是前六墩。合約階數代表基本墩之外還需要幾墩。"
          }
        }
      }
    },
