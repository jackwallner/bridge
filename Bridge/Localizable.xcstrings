          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Svar på noen spørsmål her for å begynne å følge utviklingen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Beantwoord hier een paar vragen om te beginnen met bijhouden."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
