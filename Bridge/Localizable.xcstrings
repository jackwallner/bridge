          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금 이용 중인 기능은 계속 무료입니다. %@에서는 무제한으로 연습할 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Alt du har nå, forblir gratis. %@ gir deg ubegrenset øving."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles wat je hebt blijft gratis. %@ maakt onbeperkt oefenen mogelijk."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всё, что у вас уже есть, останется бесплатным. %@ добавит безлимитную практику."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Allt du redan har förblir gratis. Med %@ får du obegränsad övning."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทุกอย่างที่คุณมียังฟรี %@ เพิ่มการฝึกที่ไม่มีวันหมด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sahip olduğunuz her şey ücretsiz kalır. %@ hiç bitmeyen alıştırma ekler."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你現有的一切仍然免費。%@ 帶來永遠練不完的題目。"
          }
        }
      }
    },
