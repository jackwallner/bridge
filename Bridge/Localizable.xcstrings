    "Delay drawing trumps only when you need dummy's trumps for ruffing first.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Udskyd kun trumftrækket, hvis du først skal bruge bordets trumfer til at trumfe."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verzögere das Trumpfziehen nur, wenn du die Trümpfe des Dummys zuerst zum Schnappen brauchst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Καθυστερήστε το μάζεμα των ατού μόνο όταν χρειάζεστε πρώτα τα ατού του μορ για κοψίματα."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Retrasa el arrastre del triunfo solo si antes necesitas fallar con los triunfos del muerto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne retardez le tirage des atouts que si vous avez d'abord besoin des atouts du mort pour couper."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ritarda la battuta d'atout solo se prima ti servono gli atout del morto per tagliare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "切り札を抜くのを遅らせるのは、先にダミーの切り札でラフが必要なときだけです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼저 더미의 트럼프로 자를 계획이 있을 때만 트럼프 뽑기를 미루세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vent med å trekke trumfen bare hvis du først trenger blindemanns trumf til stjeling."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stel het troeftrekken alleen uit als je de troeven van de dummy eerst nodig hebt om in te troeven."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отложите вытягивание козырей, только если сначала нужно убить козырями из короткой руки болвана."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vänta med att dra ut trumfen bara om du först behöver träkarlens trumf för att stjäla."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลื่อนการดึงทรัมป์เฉพาะเมื่อต้องใช้ทรัมป์ของดัมมี่ตัดก่อน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Koz çekmeyi yalnızca önce yerin kozlarıyla çakmanız gerekiyorsa erteleyin."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只有需要先讓夢家王吃時，才延後清王。"
          }
        }
      }
    },
