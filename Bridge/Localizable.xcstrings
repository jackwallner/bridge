        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "트릭과 점수는 알지만 비딩은 아직 느려요"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan stikk og poeng, men bruker fortsatt tid på meldinger"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik ken slagen en punten, maar bied nog traag"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Знаю взятки и очки, но пока неуверенно участвую в торговле"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan stick och poäng, men är fortfarande långsam i budgivningen"
