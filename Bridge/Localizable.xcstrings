    "Your streak, completed drills, and practice history will be cleared. Purchases are not affected.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din stime, gennemførte øvelser og træningshistorik slettes. Køb påvirkes ikke."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Serie, erledigte Übungen und dein Übungsverlauf werden gelöscht. Käufe sind nicht betroffen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το σερί, οι ολοκληρωμένες ασκήσεις και το ιστορικό εξάσκησης θα διαγραφούν. Οι αγορές δεν επηρεάζονται."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre série, vos exercices terminés et votre historique seront effacés. Vos achats ne sont pas concernés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Serie, esercizi completati e storico verranno cancellati. Gli acquisti non sono coinvolti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "連続記録、完了した練習、練習履歴が消去されます。購入には影響しません。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je reeks, voltooide oefeningen en oefengeschiedenis worden gewist. Aankopen blijven onaangetast."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สถิติต่อเนื่อง แบบฝึกที่ทำเสร็จ และประวัติการฝึกจะถูกลบ การซื้อไม่ได้รับผลกระทบ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seriniz, tamamlanan alıştırmalar ve alıştırma geçmişiniz silinecek. Satın alımlar etkilenmez."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的連續天數、已完成的練習和練習紀錄都會清除。購買不受影響。"
          }
        }
      }
    },
