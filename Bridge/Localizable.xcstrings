    "Accuracy for every room, your weakest area, and how much you have practiced overall.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Træfsikkerhed for hvert rum, dit svageste område og hvor meget du har øvet i alt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Trefferquote für jeden Raum, dein schwächster Bereich und wie viel du insgesamt geübt hast."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ακρίβεια για κάθε αίθουσα, το πιο αδύναμο σημείο σας και πόση εξάσκηση κάνατε συνολικά."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Consulta tus aciertos en cada área de práctica, tu punto más débil y cuánto has practicado en total."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La précision pour chaque salle, votre point faible et votre volume d'entraînement total."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Precisione per ogni sala, l'area più debole e quanto ti sei allenato in tutto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "部屋ごとの正答率、最も苦手な分野、これまでの練習量。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 연습 영역의 정확도, 가장 약한 영역, 전체 연습량을 확인할 수 있어요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Treffsikkerhet i hvert rom, det svakeste området ditt og hvor mye du har øvd totalt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nauwkeurigheid per kamer, je zwakste onderdeel en hoeveel je in totaal hebt geoefend."
