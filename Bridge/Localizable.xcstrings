    "%lld high-card points with %lld spades. With 12 or more and a five-card major, open the major: 1♠. Holding five of each major, start with the higher ranking suit.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld honnørpoint med %2$lld spar. Med 12 eller flere og en femkorts højfarve åbner du højfarven: 1♠. Med fem kort i begge højfarver starter du med den højeste."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld Figurenpunkte mit %2$lld Pik. Mit 12 oder mehr und einer Fünferoberfarbe eröffnest du die Oberfarbe: 1♠. Mit fünf Karten in beiden Oberfarben beginnst du mit der höheren."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld πόντοι τιμής με %2$lld πίκες. Με 12 ή περισσότερους και πεντάφυλλο μείζον, ανοίξτε το μείζον: 1♠. Με πέντε φύλλα σε κάθε μείζον, ξεκινήστε από το ψηλότερο."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld points H avec %2$lld piques. Avec 12 ou plus et une majeure cinquième, ouvrez la majeure : 1♠. Avec cinq cartes dans chaque majeure, commencez par la plus chère."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld punti onori con %2$lld picche. Con 12 o più e un nobile quinto, apri il nobile: 1♠. Con cinque carte in entrambi i nobili, inizia dal più alto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ハイカードポイント%1$lld点でスペード%2$lld枚。12点以上で5枚のメジャーがあれば、メジャーでオープン：1♠。両メジャーが5枚ずつなら、高いほうから始めます。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld honneurpunten met %2$lld schoppen. Met 12 of meer en een vijfkaart hoge kleur open je de hoge kleur: 1♠. Met vijf kaarten in beide hoge kleuren begin je met de hoogste."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แต้มไพ่สูง %1$lld แต้ม มีโพดำ %2$lld ใบ ถ้ามี 12 แต้มขึ้นไปและเมเจอร์ห้าใบ ให้เปิดเมเจอร์: 1♠ ถ้ามีเมเจอร์ชุดละห้าใบ ให้เริ่มจากชุดที่สูงกว่า"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$lld maça ile %1$lld onör puanı. 12 veya üzeri ve beşli majörle majörü açın: 1♠. İki majörde de beşer kart varsa büyük renkle başlayın."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld 個大牌點，黑桃 %2$lld 張。12 點以上又有五張高花，就開叫高花：1♠。兩門高花都是五張時，先叫較高的那門。"
          }
        }
      }
    },
    "%lld high-card points, %@, no five-card major and outside the 15 to 17 notrump range. Open your longer minor: %@.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld honnørpoint, %2$@, ingen femkorts højfarve og uden for 1NT-intervallet på 15 til 17. Åbn din længste lavfarve: %3$@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld Figurenpunkte, %2$@, keine Fünferoberfarbe und außerhalb des 1NT-Bereichs von 15 bis 17. Eröffne deine längere Unterfarbe: %3$@."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld πόντοι τιμής, %2$@, χωρίς πεντάφυλλο μείζον και εκτός του εύρους 15 έως 17. Ανοίξτε το μακρύτερο ελάσσον: %3$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld points H, %2$@, pas de majeure cinquième et hors de la zone 15 à 17 du sans-atout. Ouvrez votre plus longue mineure : %3$@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld punti onori, %2$@, nessun nobile quinto e fuori dalla fascia 15-17 del senza. Apri il minore più lungo: %3$@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ハイカードポイント%1$lld点、%2$@、5枚のメジャーなし、ノートランプの15〜17点の範囲外。長いほうのマイナーでオープン：%3$@。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld honneurpunten, %2$@, geen vijfkaart hoge kleur en buiten de 1NT-zone van 15 tot 17. Open je langste lage kleur: %3$@."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แต้มไพ่สูง %1$lld แต้ม %2$@ ไม่มีเมเจอร์ห้าใบ และอยู่นอกช่วงโนทรัมป์ 15 ถึง 17 เปิดไมเนอร์ที่ยาวกว่า: %3$@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld onör puanı, %2$@, beşli majör yok ve 15-17 sanzatu aralığının dışında. Uzun minörünüzü açın: %3$@."
          }
        },
        "zh-Hant": {
          "stringUnit": {
