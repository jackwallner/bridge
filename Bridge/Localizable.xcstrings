    "7 days free, then %@. Auto-renews until canceled.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "7 dage gratis, derefter %@. Fornyes automatisk, indtil du opsiger det."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "7 Tage gratis, danach %@. Verlängert sich bis zur Kündigung."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "7 μέρες δωρεάν, μετά %@. Ανανεώνεται αυτόματα μέχρι να ακυρωθεί."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "7 días gratis y después %@. Se renueva automáticamente hasta que canceles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "7 jours gratuits, puis %@. Renouvellement automatique jusqu'à résiliation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "7 giorni gratis, poi %@. Si rinnova fino alla disdetta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "7日間無料、その後%@。解約するまで自動更新されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "7일 무료 체험 후 %@에 결제돼요. 취소할 때까지 자동 갱신돼요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "7 dager gratis, deretter %@. Fornyes automatisk til du sier opp."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "7 dagen gratis, daarna %@. Je abonnement wordt automatisch verlengd tot je opzegt."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "7 дней бесплатно, затем %@. Автопродление до отмены."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "7 dagar gratis, sedan %@. Förnyas automatiskt tills du säger upp."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ฟรี 7 วัน จากนั้น %@ ต่ออายุอัตโนมัติจนกว่าจะยกเลิก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "7 gün ücretsiz, ardından %@. İptal edene kadar yenilenir."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "免費 7 天，之後 %@。取消前會自動續訂。"
          }
        }
      }
    },
