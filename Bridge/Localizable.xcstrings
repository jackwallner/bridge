    "Includes 7 days free. Auto-renews until canceled.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Inkluderer 7 dage gratis. Fornyes, indtil du opsiger."
          }
        },
        "de": {
