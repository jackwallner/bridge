    "A trump lead can remove dummy's ruffing power and cut down declarer's crossruff.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Et trumfudspil kan fratage bordet muligheden for at trumfe og begrænse spilførerens krydstrumf."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Trumpfausspiel kann dem Dummy die Schnappmöglichkeiten nehmen und das Kreuzschnappen des Alleinspielers einschränken."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η έξοδος με ατού μπορεί να στερήσει από τον μορ τη δυνατότητα να κόψει και να περιορίσει τα διασταυρούμενα κοψίματα του εκτελεστή."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Salir de triunfo puede quitarle al muerto la posibilidad de fallar y limitar los fallos cruzados del declarante."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une entame à l'atout peut priver le mort de ses possibilités de coupe et limiter les coupes croisées du déclarant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un attacco in atout può togliere al morto la possibilità di tagliare e limitare il taglio incrociato del dichiarante."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "切り札をリードすると、ダミーのラフを封じ、ディクレアラーのクロスラフも抑えられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "트럼프 리드는 더미의 트럼프 자르기를 막고 선언자의 크로스러프를 줄일 수 있어요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Utspill i trumf kan fjerne blindemanns mulighet til å stjele og begrense spilleførerens krysstjeling."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een troefuitkomst kan de troefkracht van de dummy wegnemen en de kruistroef van de leider afremmen."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выход с козыря может лишить болвана возможности убить и помешать разыгрывающему выполнить перекрёстные убитки."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett trumfutspel kan ta bort träkarlens möjlighet att stjäla och begränsa spelförarens korsstöld."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การลีดทรัมป์ช่วยให้ดัมมี่ตัดไพ่ได้น้อยลง และจำกัดการครอสรัฟของดีแคลร์เรอร์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Koz atağı yerin koz çakma gücünü azaltabilir ve deklaranın çapraz koz çakmasını kesebilir."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "領出王牌能削弱夢家的王吃能力，減少莊家的交叉王吃。"
          }
        }
      }
    },
