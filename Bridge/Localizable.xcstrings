    "New hand-written questions across the auction, declarer play, defense, and the Master Tables.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Nye håndskrevne spørgsmål om meldinger, spilføring, modspil og mesterbordene."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
