    "Any five days count. Miss one, catch up from the archive, and keep the week alive.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fem vilkårlige dage tæller. Missede du én, så tag den fra arkivet og hold ugen i live."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fünf beliebige Tage zählen. Einen verpasst? Hol ihn im Archiv nach und halte die Woche am Leben."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μετράνε οποιεσδήποτε πέντε μέρες. Χάσατε μία; Καλύψτε την από το αρχείο και κρατήστε την εβδομάδα ζωντανή."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cinq jours au choix suffisent. Un jour manqué ? Rattrapez-le dans les archives et gardez la semaine en vie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Valgono cinque giorni qualsiasi. Ne salti uno? Recuperalo dall'archivio e tieni viva la settimana."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どの5日でもOK。1日逃してもアーカイブで取り戻して、週を続けましょう。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke vijf dagen tellen. Een dag gemist? Haal hem in vanuit het archief en houd de week levend."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ห้าวันไหนก็นับ พลาดไปวัน? ตามเก็บจากคลังแล้วรักษาสัปดาห์ไว้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Herhangi beş gün sayılır. Bir günü kaçırdınız mı? Arşivden telafi edin ve haftayı canlı tutun."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "任意五天都算。錯過一天？從紀錄補上，讓這週持續下去。"
          }
        }
      }
    },
    "Any five days keep the rhythm going.": {
      "extractionState": "manual",
      "localizations": {
