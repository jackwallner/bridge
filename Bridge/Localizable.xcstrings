    "Thanks for saying. It helps more than you'd think.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tak for din tilbagemelding. Det hjælper mere, end du tror."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Danke für deine Offenheit. Das hilft mehr, als du denkst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ευχαριστούμε που το είπατε. Βοηθά περισσότερο απ' όσο νομίζετε."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gracias por contarlo. Ayuda más de lo que imaginas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Merci de nous le dire. Ça aide plus que vous ne le pensez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Grazie di avercelo detto. Aiuta più di quanto pensi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "教えてくれてありがとうございます。思っている以上に役立ちます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "의견을 보내 주셔서 감사해요. 큰 도움이 돼요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Takk for at du sa fra. Det hjelper mer enn du tror."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bedankt dat je het laat weten. Het helpt meer dan je denkt."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Спасибо, что рассказали. Это важнее, чем кажется."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tack för att du berättar. Det hjälper mer än du tror."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ขอบคุณที่บอกเรา ช่วยได้มากกว่าที่คิด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Söylediğiniz için teşekkürler. Sandığınızdan çok işe yarar."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "謝謝你告訴我們。這比你想的更有幫助。"
          }
        }
      }
    },
    "Thanks. It went straight to the developer.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tak. Det gik direkte til udvikleren."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Danke. Deine Nachricht ging direkt an den Entwickler."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ευχαριστούμε. Πήγε απευθείας στον προγραμματιστή."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gracias. Tu mensaje llegó directamente al desarrollador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Merci. C'est parti directement chez le développeur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Grazie. È arrivato direttamente allo sviluppatore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ありがとうございます。開発者に直接届きました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "고마워요. 개발자에게 바로 전달했어요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Takk. Meldingen gikk rett til utvikleren."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bedankt. Je bericht is rechtstreeks naar de ontwikkelaar gegaan."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Спасибо. Сообщение отправлено разработчику."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tack. Ditt meddelande gick direkt till utvecklaren."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ขอบคุณ ส่งถึงนักพัฒนาแล้ว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Teşekkürler. Doğrudan geliştiriciye gitti."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "謝謝。已直接送到開發者手上。"
          }
        }
      }
    },
    "That didn't go through. Try again, or copy your message and email it to %@.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det gik ikke igennem. Prøv igen, eller kopiér din besked og send den til %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das hat nicht geklappt. Versuch es erneut oder kopiere deine Nachricht und schick sie an %@."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν στάλθηκε. Δοκιμάστε ξανά ή αντιγράψτε το μήνυμα και στείλτε το στο %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo enviar. Inténtalo de nuevo o copia tu mensaje y envíalo por correo a %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'envoi a échoué. Réessayez, ou copiez votre message et envoyez-le à %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Invio non riuscito. Riprova, oppure copia il messaggio e invialo a %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "送信できませんでした。もう一度試すか、メッセージをコピーして%@へメールしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전송되지 않았어요. 다시 시도하거나 메시지를 복사해 %@로 이메일을 보내세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det gikk ikke. Prøv igjen, eller kopier meldingen og send den på e-post til %@."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dat lukte niet. Probeer het opnieuw, of kopieer je bericht en mail het naar %@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось отправить. Попробуйте снова или скопируйте сообщение и отправьте его по адресу %@."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det gick inte att skicka. Försök igen eller kopiera meddelandet och mejla det till %@."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ส่งไม่สำเร็จ ลองอีกครั้ง หรือคัดลอกข้อความแล้วอีเมลไปที่ %@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gönderilemedi. Tekrar deneyin ya da mesajınızı kopyalayıp şu adrese e-postayla gönderin: %@."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "傳送失敗。請再試一次，或複製訊息後寄到 %@。"
          }
        }
      }
    },
