        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pourquoi est-il souvent déconseillé d'entamer d'un as sans autre honneur contre un contrat à la couleur ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Perché attaccare con un asso senza il re contro un contratto a colore è di solito una cattiva scelta?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スートコントラクトに対し、他のオナーに支えられていないエースをリードするのは、なぜ通常よくないのでしょうか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "수트 계약에 맞서 지원되지 않는 에이스를 이끄는 것이 일반적으로 좋지 않은 선택인 이유는 무엇입니까?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvorfor er det vanligvis et dårlig valg å føre et ikke-støttet ess mot en fargekontrakt?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Waarom is uitkomen met een ongesteund aas tegen een troefcontract meestal een slechte keuze?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Почему ведение туза без поддержки против костюмного контракта обычно является плохим выбором?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Varför är det vanligtvis ett dåligt val att leda ett ess som inte stöds mot ett färgkontrakt?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทำไมการลีดเอซที่ไม่มีไพ่หนุนเมื่อเจอสัญญาที่มีทรัมป์มักเป็นตัวเลือกที่ไม่ดี"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kozlu kontrata karşı papazsız as ile atak yapmak neden genellikle kötü bir seçimdir?"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為什麼對抗有王合約時，通常不宜首攻缺少大牌支援的 A？"
