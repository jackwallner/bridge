    "The defender on declarer's left leads to the first trick, before dummy comes down.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Modspilleren til venstre for spilføreren spiller ud til første stik, før bordet lægges op."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Gegenspieler links vom Alleinspieler spielt zum ersten Stich aus, bevor der Dummy aufgelegt wird."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο αμυνόμενος αριστερά του εκτελεστή βγάζει στην πρώτη λεβέ, πριν απλωθεί ο μορ."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le défenseur à gauche du déclarant entame la première levée, avant que le mort soit étalé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il difensore alla sinistra del dichiarante attacca alla prima presa, prima che il morto venga scoperto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダミーが開かれる前に、ディクレアラーの左のディフェンダーが最初のトリックをリードします。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De verdediger links van de leider komt uit voor de eerste slag, voordat de dummy op tafel komt."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ฝ่ายป้องกันทางซ้ายของดีแคลร์เรอร์ลีดทริกแรก ก่อนที่ดัมมี่จะวางไพ่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Deklaranın solundaki savunmacı, yer açılmadan önce ilk löveye atak yapar."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "莊家左手的防家在夢家攤牌前首攻第一墩。"
          }
        }
      }
    },
    "The director": {
      "extractionState": "manual",
      "localizations": {
