    "Protect the outside ace. Without an entry the established clubs are unreachable and the whole plan collapses.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas på esset uden for farven. Uden en indgang kan de frispillede klør ikke nås, og hele planen falder sammen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schütze das Ass in der Nebenfarbe. Ohne Übergang sind die hochgespielten Treffs unerreichbar, und der ganze Plan bricht zusammen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Προστατέψτε τον άσο στο άλλο χρώμα. Χωρίς είσοδο, τα σπαθιά που ελευθερώσατε δεν φτάνονται και όλο το σχέδιο καταρρέει."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Protégez l'as extérieur. Sans reprise, les trèfles affranchis sont inaccessibles et tout le plan s'effondre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Proteggi l'asso esterno. Senza un rientro i fiori affrancati sono irraggiungibili e tutto il piano crolla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ほかのスートのエースを守ります。エントリーがなければ確立したクラブに届かず、計画全体が崩れます。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bescherm de aas buiten de kleur. Zonder ingang zijn de vrijgespeelde klaveren onbereikbaar en valt het hele plan in duigen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รักษาเอซนอกชุดไว้ ถ้าไม่มีทางเข้า ดอกจิกที่ทำให้ชนะได้แล้วจะไปไม่ถึง และแผนทั้งหมดจะพัง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yan renkteki ası koruyun. Giriş olmadan kurduğunuz sinek lövelerine ulaşamazsınız ve bütün plan çöker."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "保住旁門的 A。沒有進手，就無法兌現已建立的梅花贏墩，整個計畫就會失敗。"
          }
        }
      }
    },
