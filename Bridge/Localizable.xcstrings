          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τις πρώτες έξι λεβέ"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les six premières levées"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le prime sei prese"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最初の6トリック"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De eerste zes slagen"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หกทริกแรก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İlk altı löve"
          }
        },
        "zh-Hant": {
