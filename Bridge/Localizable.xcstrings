    "Count the suit before holding up. Do not duck if the contract is in immediate danger elsewhere.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tæl farven, før du dukker. Duk ikke, hvis kontrakten er i umiddelbar fare andetsteds."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zähl die Farbe, bevor du duckst. Duck nicht, wenn der Kontrakt anderswo akut gefährdet ist."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μετρήστε το χρώμα πριν κρατήσετε. Μην το κάνετε αν το συμβόλαιο κινδυνεύει άμεσα αλλού."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comptez la couleur avant de laisser passer. Ne le faites pas si le contrat est en danger immédiat ailleurs."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Conta il seme prima di lisciare. Non farlo se il contratto è in pericolo immediato altrove."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ホールドアップの前にスートを数えます。ほかの場所でコントラクトが差し迫った危険にあるならダックしないこと。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tel de kleur voor je duikt. Duik niet als het contract elders direct in gevaar is."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
