    "Fix My Mistakes brings back what you miss": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ret mine fejl viser spørgsmål, du svarer forkert på, igen"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Fehler beheben“ bringt falsch beantwortete Fragen zurück"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η Διόρθωση λαθών επαναφέρει τις ερωτήσεις που απαντάτε λάθος"
