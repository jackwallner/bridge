    "Count the suit before holding up. Do not duck if the contract is in immediate danger elsewhere.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tæl farven, før du dukker. Duk ikke, hvis kontrakten er i umiddelbar fare andetsteds."
          }
        },
        "de": {
