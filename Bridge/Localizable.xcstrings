    "Play low. If you rise with the king, dummy's ace wins and the jack may become good.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Spil lille. Går du op med kongen, vinder bordets es, og knægten kan blive god."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spiel klein. Gehst du mit dem König hoch, gewinnt das Ass des Dummys und der Bube kann hoch werden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Παίξτε μικρό. Αν ανεβείτε με τον ρήγα, κερδίζει ο άσος του μορ και ο βαλές μπορεί να γίνει καλός."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jouez petit. Si vous montez du roi, l'as du mort gagne et le valet peut devenir maître."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gioca piccola. Se sali con il re, vince l'asso del morto e il fante può diventare buono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "小さく出します。キングを出すとダミーのエースが勝ち、ジャックが勝ち札になるかもしれません。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Speel klein. Ga je hoog met de heer, dan wint de aas van de dummy en kan de boer goed worden."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลงใบเล็ก ถ้าลงคิง เอซของดัมมี่จะชนะ และแจ็คอาจกลายเป็นไพ่ชนะ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Küçük oynayın. Papazla çıkarsanız yerin ası kazanır ve vale kurulabilir."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "出小牌。如果你出 K，夢家的 A 會贏，J 可能就成為大牌。"
          }
        }
      }
    },
