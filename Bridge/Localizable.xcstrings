    "Lead the top of a touching honor sequence. It describes the holding and avoids giving away a cheap trick.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Spil det øverste kort fra en honnørsekvens ud. Det beskriver holdingen og forærer ikke et billigt stik væk."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spiel die oberste Karte einer Honneursequenz aus. Sie beschreibt die Haltung und verschenkt keinen billigen Stich."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Βγάλτε το πάνω φύλλο από σεκάνς τιμών. Περιγράφει το χρώμα και δεν χαρίζει φτηνή λεβέ."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Entamez le haut d'une séquence d'honneurs. Cela décrit la tenue et évite d'offrir une levée bon marché."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attacca con la più alta di una sequenza di onori. Descrive la tenuta ed evita di regalare una presa a buon mercato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "連続したオナーのシークエンスのトップをリードします。持ち札を伝え、安いトリックを与えません。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kom uit met de hoogste van een aansluitende honneursequentie. Dat beschrijft je kleur en geeft geen goedkope slag weg."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลีดใบบนสุดของออนเนอร์ที่เรียงติดกัน บอกลักษณะไพ่และไม่เสียทริกง่าย ๆ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitişik onör sekansının en üstüyle atak yapın. Durumu anlatır ve ucuz bir löve vermekten kaçınır."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "首攻相連大牌連張的最上面那張。能描述持牌，也不會送出便宜的一墩。"
          }
        }
      }
    },
