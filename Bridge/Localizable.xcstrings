    "%lld high-card points, %@, no five-card major and outside the 15 to 17 notrump range.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld honnørpoint, %2$@, ingen femkorts højfarve og uden for sans-intervallet på 15 til 17."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld Figurenpunkte, %2$@, keine Fünferoberfarbe und außerhalb des 1NT-Bereichs von 15 bis 17."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld πόντοι τιμής, %2$@, χωρίς πεντάφυλλο μείζον και εκτός του εύρους 15 έως 17 για χωρίς ατού."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld puntos de honor, %@, sin palo mayor de cinco cartas y fuera del rango de 15–17 para 1NT."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld points H, %2$@, pas de majeure cinquième et hors de la zone 15 à 17 du sans-atout."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld punti onori, %2$@, senza un nobile quinto e fuori dalla fascia da 15 a 17 punti per l'apertura di 1NT."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ハイカードポイント%1$lld点、%2$@、5枚のメジャーなし、ノートランプの15〜17点の範囲外。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "HCP %1$lld점, %2$@이고 5장 메이저 수트가 없으며 노트럼프 15~17점 범위 밖이에요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld honnørpoeng, %2$@, uten fem kort i en majorfarge og utenfor grandområdet på 15–17 poeng."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld honneurpunten, %2$@, geen vijfkaart hoge kleur en buiten het sans-atoutbereik van 15 tot 17."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld очков за старшие карты, %2$@, без пяти карт в старшей масти и вне диапазона 15–17 для 1NT."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld honnörspoäng, %2$@, utan femkortshögfärg och utanför sangintervallet 15–17."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แต้มไพ่สูง %1$lld แต้ม %2$@ ไม่มีเมเจอร์ห้าใบ และอยู่นอกช่วง 15 ถึง 17 แต้มสำหรับเปิด 1NT"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld onör puanı, %2$@, beşli majör yok ve 15-17 sanzatu aralığının dışında."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld 個大牌點，%2$@，沒有五張高花，也不在 15 到 17 的無王範圍內。"
          }
        }
      }
    },
