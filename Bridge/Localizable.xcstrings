    "Knew it? Swipe right · Again? Swipe left": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vidste du det? Stryg til højre · Igen? Stryg til venstre"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gewusst? Nach rechts · Nochmal? Nach links"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το ξέρατε; Σύρετε δεξιά · Ξανά; Σύρετε αριστερά"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Lo sabías? Desliza a la derecha. ¿Otra vez? Desliza a la izquierda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous le saviez ? Glissez à droite · Encore ? Glissez à gauche"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo sapevi? Scorri a destra · Ancora? Scorri a sinistra"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "わかった？右にスワイプ · もう一度？左にスワイプ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "맞혔나요? 오른쪽으로 스와이프 · 다시 볼까요? 왼쪽으로 스와이프"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Visste du det? Sveip til høyre. Øve igjen? Sveip til venstre."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wist je het? Veeg naar rechts · Nog eens? Veeg naar links"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Знали? Смахните вправо · Опять? Проведите пальцем влево"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunde du det? Svep åt höger. Vill du se igen? Svep åt vänster."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รู้แล้ว? ปัดขวา · อีกครั้ง? ปัดซ้าย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildiniz mi? Sağa kaydırın · Tekrar mı? Sola kaydırın"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "會了？右滑 · 再來一次？左滑"
          }
        }
      }
    },
