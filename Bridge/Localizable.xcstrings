    "Book is the first six tricks. Contract levels name the number of tricks required beyond book.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Bogen er de første seks stik. Kontraktens trin angiver, hvor mange stik der kræves ud over bogen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Buch sind die ersten sechs Stiche. Die Kontraktstufe nennt die Zahl der Stiche, die über das Buch hinaus nötig sind."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το βιβλίο είναι οι πρώτες έξι λεβέ. Το επίπεδο του συμβολαίου δείχνει πόσες λεβέ χρειάζονται πάνω από το βιβλίο."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le livre, ce sont les six premières levées. Le palier indique le nombre de levées à faire en plus du livre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il libro sono le prime sei prese. Il livello del contratto indica quante prese servono oltre il libro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブックとは最初の6トリックのことです。コントラクトのレベルは、ブックを超えて必要なトリック数を表します。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het boek is de eerste zes slagen. Het niveau noemt het aantal slagen dat je boven het boek moet halen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บุ๊กคือหกทริกแรก ระดับสัญญาบอกจำนวนทริกที่ต้องทำเกินบุ๊ก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kitap ilk altı lövedir. Kontrat seviyesi kitabın üzerinde gereken löve sayısını belirtir."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "基本墩就是前六墩。合約階數代表基本墩之外還需要幾墩。"
          }
        }
      }
    },
