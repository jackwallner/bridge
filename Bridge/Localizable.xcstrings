        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sårbarhet endrer hvilke to ting mest direkte?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Welke twee dingen verandert kwetsbaarheid het meest direct?"
