    "The defender on declarer's left leads to the first trick, before dummy comes down.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Modspilleren til venstre for spilføreren spiller ud til første stik, før bordet lægges op."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Gegenspieler links vom Alleinspieler spielt zum ersten Stich aus, bevor der Dummy aufgelegt wird."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο αμυνόμενος στα αριστερά του εκτελεστή κάνει την αντάμ πριν απλωθεί ο μορ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El defensor a la izquierda del declarante lidera la primera baza, antes de que baje el muerto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le défenseur à gauche du déclarant entame la première levée, avant que le mort soit étalé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il difensore alla sinistra del dichiarante attacca alla prima presa, prima che il morto venga scoperto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダミーがテーブルに出る前に、ディクレアラーの左のディフェンダーが最初のトリックをリードします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선언자의 왼쪽에 있는 수비수가 더미가 내려오기 전에 첫 번째 트릭을 시도합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Forsvareren til venstre for spilleren fører til det første stikket, før dummyen kommer ned."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De verdediger links van de leider komt uit voor de eerste slag, voordat de dummy op tafel komt."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Защитник слева от разыгрывающего делает первую взятку, прежде чем болван упадет."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Försvararen till vänster på deklaranten leder till det första sticket, innan träkarlen faller."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ฝ่ายป้องกันทางซ้ายของดีแคลร์เรอร์ลีดทริกแรก ก่อนดัมมี่เปิดไพ่"
          }
        },
        "tr": {
