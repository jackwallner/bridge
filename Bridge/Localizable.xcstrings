    "Fifteen points, balanced 4-3-3-3, and no five-card major. That is the 1NT range exactly.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Femten point, jævn 4-3-3-3 og ingen femkorts højfarve. Præcis 1NT-intervallet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fünfzehn Punkte, ausgeglichen 4-3-3-3, keine Fünferoberfarbe. Das ist genau der 1NT-Bereich."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεκαπέντε πόντοι, ισοκατανεμημένο 4-3-3-3, χωρίς πεντάφυλλο μείζον. Ακριβώς το εύρος του 1NT."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quinze points, régulière 4-3-3-3, pas de majeure cinquième. C'est exactement la zone du 1NT."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quindici punti, bilanciata 4-3-3-3 e nessun nobile quinto. È esattamente la fascia di 1NT."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "15点、バランスの4-3-3-3で5枚のメジャーなし。まさに1NTの範囲です。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vijftien punten, verdeeld 4-3-3-3 en geen vijfkaart hoge kleur. Precies de 1NT-zone."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สิบห้าแต้ม มือสมดุล 4-3-3-3 ไม่มีเมเจอร์ห้าใบ ตรงกับช่วง 1NT พอดี"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "On beş puan, dengeli 4-3-3-3 ve beşli majör yok. Tam 1NT aralığı."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "15 點、4-3-3-3 平均牌、沒有五張高花，正是 1NT 的範圍。"
          }
        }
      }
    },
