    "After 1NT, a Jacoby transfer primarily lets which hand become declarer?": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Efter 1NT, hvilken hånd bliver primært spilfører ved en Jacoby-transfer?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Welche Hand wird nach 1NT durch einen Jacoby-Transfer vor allem Alleinspieler?"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μετά το 1NT, ένα τρανσφέρ Jacoby κάνει κυρίως ποιο χέρι εκτελεστή;"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Après 1NT, un transfert Jacoby permet surtout à quelle main de devenir déclarant ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
