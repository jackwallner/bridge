    "A heart is led and you hold a heart. What must you do?": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der spilles hjerter, og du har hjerter. Hvad skal du gøre?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Coeur wird ausgespielt und du hältst eine Coeur-Karte. Was musst du tun?"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Βγαίνει κούπα και έχετε κούπα. Τι πρέπει να κάνετε;"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se lleva un corazón y tú sostiene un corazón. ¿Qué debes hacer?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "On entame à cœur et vous avez un cœur. Que devez-vous faire ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'attacco è a cuori e hai una carta di cuori. Cosa devi fare?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ハートがリードされ、あなたはハートを持っています。どうする？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마음은 이끌리고 마음은 붙잡는다. 당신은 무엇을 해야 합니까?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Et hjerte ledes og du holder et hjerte. Hva må du gjøre?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er wordt met harten uitgekomen en je hebt harten. Wat moet je doen?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сердце ведомо, и вы держите сердце. Что вам нужно сделать?"
          }
        },
        "sv": {
          "stringUnit": {
