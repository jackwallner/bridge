    "Keep going. Sharp means nearly everything here is holding.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fortsæt. Skarp betyder, at du har styr på næsten alt her."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Weiter so. Bei „Sicher“ sitzt hier fast alles."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Συνεχίστε. Το «Σε φόρμα» σημαίνει ότι σχεδόν όλα όσα μαθαίνετε εδώ έχουν εμπεδωθεί."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigue adelante. Sharp significa que casi todo aquí se mantiene."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuez. Le niveau « Solide » signifie que vous maîtrisez presque tout."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Continua così. «Solido» significa che hai quasi tutto sotto controllo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その調子です。「好調」は、この部屋の内容をほぼ身につけている状態です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계속하세요. 샤프(Sharp)는 여기 있는 거의 모든 것이 유지된다는 뜻입니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fortsett. Sharp betyr at nesten alt her holder."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ga zo door. Scherp betekent dat bijna alles hier blijft hangen."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Продолжайте. Острый означает, что здесь почти все держится."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fortsätt. Sharp betyder att nästan allt här håller."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไปต่อ! ระดับคล่องหมายถึงคุณจำเนื้อหาเกือบทุกข้อในห้องนี้ได้แล้ว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Devam edin. Keskin, buradakilerin neredeyse tamamının oturduğu anlamına gelir."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "繼續加油。「熟練」表示這裡幾乎都記牢了。"
          }
        }
      }
    },
