          }
        }
      }
    },
    "Answer a few questions and your accuracy for every room shows up here.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Svar på et par spørgsmål, så vises din træfsikkerhed for hvert rum her."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beantworte ein paar Fragen, dann erscheint hier deine Trefferquote für jeden Raum."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Απαντήστε σε μερικές ερωτήσεις και η ακρίβειά σας για κάθε αίθουσα θα εμφανιστεί εδώ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Responde algunas preguntas y aquí verás tus aciertos en cada área de práctica."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Répondez à quelques questions et votre précision pour chaque salle s'affichera ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rispondi a qualche domanda e qui vedrai la precisione per ogni sala."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いくつか問題に答えると、部屋ごとの正答率がここに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "문제를 몇 개 풀면 각 연습 영역의 정확도가 여기에 표시돼요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Svar på noen spørsmål, så vises treffsikkerheten din for hvert rom her."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Beantwoord een paar vragen en hier verschijnt je nauwkeurigheid per kamer."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ответьте на несколько вопросов, и здесь появится ваша точность по каждому разделу."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Svara på några frågor så visas din träffsäkerhet i varje övningsområde här."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตอบคำถามสักหน่อย ความแม่นยำของแต่ละห้องจะแสดงที่นี่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Birkaç soruyu yanıtlayın; her odadaki doğruluk oranınız burada görünür."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "回答幾題後，每個房間的正確率就會顯示在這裡。"
          }
        }
      }
    },
    "Answer a few questions here to start tracking.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Svar på et par spørgsmål her for at følge din udvikling."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beantworte hier ein paar Fragen, damit deine Fortschritte erfasst werden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Απαντήστε σε μερικές ερωτήσεις εδώ για να ξεκινήσει η καταγραφή."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
