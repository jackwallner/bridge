            "value": "Das Ausspiel"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το πρώτο βγάλσιμο"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'entame"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'attacco"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オープニングリード"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De uitkomst"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การลีดเปิด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İlk atak"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "首攻"
          }
        }
      }
    },
    "The opponents' ace may take the first round, but your remaining honors can become winners. Giving up one trick can create several later.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Modparternes es tager måske første runde, men dine øvrige honnører kan blive vindere. At afgive ét stik kan skabe flere senere."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Ass der Gegner nimmt vielleicht die erste Runde, aber deine übrigen Honneurs können Gewinner werden. Ein abgegebener Stich kann später mehrere bringen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο άσος των αντιπάλων ίσως πάρει τον πρώτο γύρο, αλλά οι υπόλοιπες τιμές σας μπορούν να γίνουν σίγουρες λεβέ. Δίνοντας μία λεβέ μπορεί να δημιουργήσετε αρκετές αργότερα."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'as adverse prendra peut-être le premier tour, mais vos honneurs restants peuvent devenir maîtres. Céder une levée peut en créer plusieurs ensuite."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'asso avversario può prendere il primo giro, ma i tuoi onori rimasti possono diventare vincenti. Cedere una presa può crearne diverse dopo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "相手のエースに最初の1巡を取られても、残りのオナーは勝ち札になれます。1トリックを譲ることで後に複数のトリックが生まれます。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De aas van de tegenpartij neemt misschien de eerste ronde, maar je overige honneurs kunnen winnaars worden. Eén slag afgeven kan er later meerdere opleveren."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เอซของคู่แข่งอาจชนะรอบแรก แต่ออนเนอร์ที่เหลือของคุณจะกลายเป็นไพ่ชนะ ยอมเสียหนึ่งทริกอาจได้หลายทริกในภายหลัง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rakiplerin ası ilk turu alabilir ama kalan onörleriniz kazanan olabilir. Bir löve vermek sonra birkaç löve yaratabilir."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "對手的 A 也許拿下第一輪，但你其餘的大牌可以成為贏墩。讓出一墩可能換來之後好幾墩。"
          }
        }
      }
    },
