    "%@ unlocks the extra sets here and in every other room, the Master Tables, Bridge Minute, Game Night Prep, and Endless Practice. Everything you already have stays free.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ låser ekstrasættene op her og i alle andre rum, mesterbordene, Bridge Minute, forberedelse til bridgeaftenen og endeløs træning. Alt, hvad du allerede har, forbliver gratis."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ schaltet hier und in allen anderen Räumen Zusatzübungen sowie die Meistertische, Bridge Minute, Spielabend-Vorbereitung und Endlos-Training frei. Alles, was du schon hast, bleibt kostenlos."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το %@ ξεκλειδώνει τα επιπλέον σετ εδώ και σε κάθε άλλη αίθουσα, τα τραπέζια των μάστερ, το Bridge Minute, την προετοιμασία για τη βραδιά μπριτζ και την ατελείωτη εξάσκηση. Ό,τι έχετε ήδη παραμένει δωρεάν."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ desbloquea los ejercicios extra aquí y en las demás salas, las Mesas avanzadas, Bridge Minute, la Preparación para la partida y la Práctica sin fin. Todo lo que ya tienes sigue siendo gratis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ débloque les séries bonus ici et dans toutes les salles, les tables des maîtres, Bridge Minute, la préparation personnalisée pour vos soirées bridge et l'entraînement infini. Tout ce que vous avez reste gratuit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ sblocca gli esercizi extra qui e in ogni altra sala, i tavoli dei maestri, Bridge Minute, Prepara la serata e l'allenamento infinito. Tutto ciò che hai resta gratis."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@なら、この部屋とほかの全部屋の追加セット、マスターテーブル、Bridge Minute、対局前の練習、エンドレス練習が使えます。今あるものはずっと無料です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@는 이곳과 다른 모든 방의 추가 연습 세트와 마스터 테이블, Bridge Minute, 게임 준비, 끝없는 연습을 잠금 해제합니다. 이미 이용 중인 기능은 계속 무료입니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ låser opp ekstra øvingssett her og i alle andre rom, de viderekomne bordene, Bridge Minute, forberedelse til spillekvelden og uendelig øving. Alt du allerede har, forblir gratis."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ontgrendelt extra oefenreeksen in alle kamers, oefentafels voor gevorderden, Bridge Minute, persoonlijke voorbereiding op je speelavond en Eindeloos oefenen. Alles wat je al hebt, blijft gratis."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ открывает дополнительные упражнения здесь и во всех остальных разделах, продвинутые столы, Bridge Minute, подготовку к игре и бесконечную практику. Всё, что у вас уже есть, останется бесплатным."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ låser upp extra övningsset här och i alla andra rum, de avancerade borden, Bridge Minute, förberedelser inför spelkvällen och oändlig övning. Allt du redan har är fortsatt gratis."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ปลดล็อกชุดฝึกเพิ่มในห้องนี้และทุกห้อง โต๊ะมาสเตอร์ Bridge Minute แบบฝึกเตรียมตัวก่อนคืนเล่นบริดจ์ และการฝึกไม่จำกัด ทุกอย่างที่คุณมีอยู่ยังฟรีเหมือนเดิม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ bu odadaki ve diğer tüm odalardaki ek setleri, Usta Masaları'nı, Bridge Minute'u, briç gecesi hazırlığını ve sonsuz alıştırmayı açar. Zaten sahip olduğunuz her şey ücretsiz kalır."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 可解鎖這裡和其他所有房間的加練題組、大師牌桌、Bridge Minute、牌局前練習和無限練習。你現有的一切仍然免費。"
          }
        }
      }
    },
    "%@%lld": {
      "shouldTranslate": false
    },
    "%@, billed today. Auto-renews until canceled.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, betales i dag. Fornyes automatisk, indtil du opsiger det."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, Zahlung heute. Verlängert sich bis zur Kündigung."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, χρέωση σήμερα. Ανανεώνεται αυτόματα μέχρι να ακυρωθεί."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, facturado hoy. Se renueva automáticamente hasta que se cancele."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, facturé aujourd'hui. Renouvellement automatique jusqu'à résiliation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, addebito oggi. Si rinnova fino alla disdetta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@、本日請求されます。解約するまで自動更新されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, 오늘 청구됩니다. 취소할 때까지 자동 갱신됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, fakturert i dag. Fornyes automatisk til avbestilling."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, vandaag gefactureerd. Je abonnement wordt automatisch verlengd tot je opzegt."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, счет выставлен сегодня. Автоматическое продление до отмены."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, faktureras idag. Förnyas automatiskt tills den avbryts."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ชำระวันนี้ ต่ออายุอัตโนมัติจนกว่าจะยกเลิก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, bugün ödenir. İptal edene kadar yenilenir."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@，今天付款。取消前會自動續訂。"
          }
        }
      }
    },
