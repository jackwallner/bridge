    "When is second hand high right rather than second hand low?": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvornår er anden hånd højt rigtigt frem for anden hånd lavt?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
