    "The 52-card deck is dealt equally, so each of four players receives 13 cards.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "De 52 kort deles ligeligt, så hver af de fire spillere får 13 kort."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die 52 Karten werden gleichmäßig verteilt, also bekommt jeder der vier Spieler 13 Karten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η τράπουλα των 52 φύλλων μοιράζεται εξίσου, άρα καθένας από τους τέσσερις παίρνει 13 φύλλα."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La baraja de 52 cartas se reparte por igual: cada uno de los cuatro jugadores recibe 13 cartas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les 52 cartes sont distribuées à parts égales : chacun des quatre joueurs en reçoit 13."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il mazzo da 52 carte viene distribuito in parti uguali, quindi ognuno dei quattro giocatori riceve 13 carte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "52枚を均等に配るので、4人それぞれが13枚ずつ受け取ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "52장 덱을 네 플레이어에게 고르게 나누면 각자 13장씩 받아요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kortstokken har 52 kort og deles likt, så hver av de fire spillerne får 13 kort."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De 52 kaarten worden gelijk verdeeld, dus elk van de vier spelers krijgt 13 kaarten."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Колоду из 52 карт делят поровну, поэтому каждый из четырёх игроков получает по 13 карт."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kortleken med 52 kort delas jämnt, så att var och en av de fyra spelarna får 13 kort."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไพ่ 52 ใบแจกเท่ากัน ผู้เล่นทั้งสี่คนจึงได้คนละ 13 ใบ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "52 kartlık deste eşit dağıtılır, yani dört oyuncunun her biri 13 kart alır."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "52 張牌平均發給四位玩家，每人 13 張。"
          }
        }
      }
    },
    "The App Store isn't reachable right now. Check your connection and try again.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store kan ikke nås lige nu. Tjek din forbindelse, og prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der App Store ist gerade nicht erreichbar. Prüfe deine Verbindung und versuche es erneut."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το App Store δεν είναι διαθέσιμο τώρα. Ελέγξτε τη σύνδεσή σας και δοκιμάστε ξανά."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede acceder a App Store ahora. Comprueba tu conexión e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'App Store est injoignable pour le moment. Vérifiez votre connexion et réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'App Store non è raggiungibile ora. Controlla la connessione e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在App Storeに接続できません。接続を確認してもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금은 App Store에 연결할 수 없어요. 인터넷 연결을 확인하고 다시 시도하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store er ikke tilgjengelig akkurat nå. Sjekk tilkoblingen og prøv igjen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De App Store is nu niet bereikbaar. Controleer je verbinding en probeer het opnieuw."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сейчас App Store недоступен. Проверьте подключение и попробуйте снова."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store går inte att nå just nu. Kontrollera internetanslutningen och försök igen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตอนนี้เชื่อมต่อ App Store ไม่ได้ ตรวจสอบการเชื่อมต่อแล้วลองใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store'a şu an ulaşılamıyor. Bağlantınızı kontrol edip tekrar deneyin."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前無法連上 App Store。請檢查網路連線後再試一次。"
          }
        }
      }
    },
