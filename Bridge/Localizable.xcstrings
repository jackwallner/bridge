    "Six high-card points and no long suit. This is below ordinary opening strength, so pass.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Seks honnørpoint og ingen lang farve. Det er under almindelig åbningsstyrke, så pas."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sechs Figurenpunkte und keine lange Farbe. Das liegt unter der normalen Eröffnungsstärke, also passe."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Έξι πόντοι ονέρ και κανένα μακρύ χρώμα. Δεν αρκούν για κανονικό άνοιγμα, οπότε πάσο."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Seis puntos de honor y ningún palo largo. No basta para una apertura habitual, así que pasa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Six points H et aucune couleur longue. Cette main est en dessous de la force d'ouverture habituelle, donc passez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sei punti onori e nessun seme lungo. È sotto la normale forza d'apertura, quindi passa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ハイカードポイント6点で長いスートもなし。通常のオープンの強さに届かないのでパスです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "HCP 6점이고 긴 수트가 없어요. 보통 오프닝 점수보다 낮으니 패스하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Seks honnørpoeng og ingen langfarge. Det er under vanlig åpningsstyrke, så pass."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zes honneurpunten en geen lange kleur. Dat is onder de gewone openingskracht, dus pas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Шесть очков за старшие карты, нет длинной масти. Этого недостаточно для обычного открытия, поэтому пасуйте."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sex honnörspoäng och ingen lång färg. Det räcker inte för ett vanligt öppningsbud, så passa."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หกแต้มไพ่สูงและไม่มีชุดยาว มือยังไม่แข็งพอเปิดตามปกติ จึงพาส"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu elde altı onör puanı ve uzun renk yok. Normal açış gücünün altında kaldığı için pas geçin."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "6 個大牌點，沒有長套。低於一般開叫牌力，所以不叫。"
          }
        }
      }
    },
    "Six spades and 13 HCP make 1♠ the clear opening.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Seks spar og 13 HP gør 1♠ til den klare åbning."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sechs Pik und 13 FP machen 1♠ zur klaren Eröffnung."
