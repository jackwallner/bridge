    "We're still checking your purchases. Try again in a moment.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi tjekker stadig dine køb. Prøv igen om lidt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir prüfen noch deine Käufe. Versuch es gleich noch einmal."
