    "%@ right across %lld questions, your lowest so far.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ rigtige på %2$lld spørgsmål, din laveste indtil nu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ richtig bei %lld Fragen, dein schwächster Wert bisher."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ σωστές σε %2$lld ερωτήσεις, το χαμηλότερό σας ως τώρα."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ de bonnes réponses sur %2$lld questions, votre plus faible score."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ di risposte giuste su %2$lld domande, il tuo dato più basso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$lld問で正答率%1$@、現時点で最も低い部屋です。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ goed bij %2$lld vragen, je laagste tot nu toe."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ถูก %1$@ จาก %2$lld คำถาม ต่ำที่สุดจนถึงตอนนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$lld soruda %1$@ doğru, şimdiye kadarki en düşüğünüz."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$lld 題中答對 %1$@，是目前最低的。"
          }
        }
