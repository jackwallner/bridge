    "Streaks make it stick": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Træning på stribe får det til at hænge ved"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Serien helfen dranzubleiben"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
