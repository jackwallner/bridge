    "%@ one-time. Not a subscription, nothing renews.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Engangsbetaling på %@. Intet abonnement, intet fornyes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ einmalig. Kein Abo, nichts verlängert sich."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ εφάπαξ. Χωρίς συνδρομή, τίποτα δεν ανανεώνεται."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ en un solo pago. No es una suscripción y no se renueva."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ en une fois. Pas d'abonnement, rien ne se renouvelle."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ una tantum. Nessun abbonamento, niente rinnovi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@の買い切り。サブスクリプションではなく、更新されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
