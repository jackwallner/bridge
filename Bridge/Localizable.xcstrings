        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มีโพแดงห้าใบและมือแข็งพอเปิด จึงควรเปิด 1♥"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
