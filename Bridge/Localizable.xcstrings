          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "I grand spiller du sist i et stikk med 4♣, 6♣ og 9♣, i den rekkefølgen. Hvilket kort vinner med lavest mulig rang?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "In sans atout speel je als vierde na 4♣, 6♣ en 9♣. Welke kaart wint het goedkoopst?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В контракте без козыря вы играете последним после 4♣, 6♣ и 9♣. Какой картой дешевле всего взять взятку?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "I sang har 4♣, 6♣ och 9♣ spelats i den ordningen och du spelar sist. Vilket kort ska du använda för att vinna så billigt som möjligt?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ในโนทรัมป์ มีการลง 4♣, 6♣, 9♣ ตามลำดับ และคุณเป็นคนที่สี่ ไพ่ใบไหนใช้ชนะทริกได้ด้วยไพ่ต่ำที่สุด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
