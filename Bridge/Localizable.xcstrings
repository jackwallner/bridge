    "Thanks for saying. It helps more than you'd think.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tak for din tilbagemelding. Det hjælper mere, end du tror."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Danke für deine Offenheit. Das hilft mehr, als du denkst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ευχαριστούμε που το είπατε. Βοηθά περισσότερο απ' όσο νομίζετε."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gracias por decirlo. Ayuda más de lo que piensas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Merci de nous le dire. Ça aide plus que vous ne le pensez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Grazie di avercelo detto. Aiuta più di quanto pensi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "教えてくれてありがとうございます。思っている以上に役立ちます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "말씀해주셔서 감사합니다. 생각보다 도움이 됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Takk for at du sa. Det hjelper mer enn du tror."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bedankt dat je het laat weten. Het helpt meer dan je denkt."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Спасибо, что сказали. Это помогает больше, чем вы думаете."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tack för att du sa. Det hjälper mer än du tror."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ขอบคุณที่บอกเรา ช่วยได้มากกว่าที่คิด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Söylediğiniz için teşekkürler. Sandığınızdan çok işe yarar."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "謝謝你告訴我們。這比你想的更有幫助。"
          }
        }
      }
    },
    "Thanks. It went straight to the developer.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tak. Det gik direkte til udvikleren."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Danke. Deine Nachricht ging direkt an den Entwickler."
