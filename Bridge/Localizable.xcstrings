    "Your purchase went through, but %@ hasn't unlocked yet. Give it a moment, then tap Restore.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit køb gik igennem, men %@ er ikke låst op endnu. Vent et øjeblik, og tryk så på Gendan."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Kauf war erfolgreich, aber %@ ist noch nicht freigeschaltet. Warte einen Moment und tippe dann auf „Wiederherstellen“."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η αγορά σας ολοκληρώθηκε, αλλά το %@ δεν έχει ξεκλειδωθεί ακόμη. Περιμένετε λίγο και πατήστε Επαναφορά."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre achat a abouti, mais %@ n'est pas encore débloqué. Patientez un instant, puis touchez Restaurer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'acquisto è andato a buon fine, ma %@ non è ancora sbloccato. Attendi un momento, poi tocca Ripristina."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "購入は完了しましたが、%@がまだ有効になっていません。少し待ってから「復元」をタップしてください。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je aankoop is gelukt, maar %@ is nog niet ontgrendeld. Wacht even en tik dan op Herstel."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การซื้อสำเร็จแล้ว แต่ %@ ยังไม่ปลดล็อก รอสักครู่แล้วแตะกู้คืน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Satın alma tamamlandı ama %@ henüz açılmadı. Biraz bekleyin, sonra Geri yükle'ye dokunun."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "購買已完成，但 %@ 尚未開通。請稍候，再點一下「恢復」。"
          }
        }
      }
    },
    "Your purchase went through, but %@ hasn't unlocked yet. Give it a moment, then tap Restore. You will not be charged twice.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit køb gik igennem, men %@ er ikke låst op endnu. Vent et øjeblik, og tryk så på Gendan. Du bliver ikke opkrævet to gange."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Kauf war erfolgreich, aber %@ ist noch nicht freigeschaltet. Warte einen Moment und tippe dann auf „Wiederherstellen“. Dir wird nichts doppelt berechnet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η αγορά σας ολοκληρώθηκε, αλλά το %@ δεν έχει ξεκλειδωθεί ακόμη. Περιμένετε λίγο και πατήστε Επαναφορά. Δεν θα χρεωθείτε δύο φορές."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre achat a abouti, mais %@ n'est pas encore débloqué. Patientez un instant, puis touchez Restaurer. Vous ne serez pas facturé deux fois."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'acquisto è andato a buon fine, ma %@ non è ancora sbloccato. Attendi un momento, poi tocca Ripristina. Non ti verrà addebitato due volte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "購入は完了しましたが、%@がまだ有効になっていません。少し待ってから「復元」をタップしてください。二重に請求されることはありません。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je aankoop is gelukt, maar %@ is nog niet ontgrendeld. Wacht even en tik dan op Herstel. Je betaalt niet dubbel."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การซื้อสำเร็จแล้ว แต่ %@ ยังไม่ปลดล็อก รอสักครู่แล้วแตะกู้คืน คุณจะไม่ถูกเรียกเก็บเงินซ้ำ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Satın alma tamamlandı ama %@ henüz açılmadı. Biraz bekleyin, sonra Geri yükle'ye dokunun. İki kez ücret alınmaz."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "購買已完成，但 %@ 尚未開通。請稍候，再點一下「恢復」。不會重複收費。"
          }
        }
      }
    },
