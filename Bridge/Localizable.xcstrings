    "No trump is in play. You are last to a trick of 10♦, 3♦, K♦. Which card wins?": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen trumf i spil. Du er sidst i et stik med 10♦, 3♦, K♦. Hvilket kort vinder?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Trumpf im Spiel. Du spielst als Letzter zu einem Stich mit 10♦, 3♦, K♦. Welche Karte gewinnt?"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν υπάρχει ατού. Είστε τελευταίος σε λεβέ με 10♦, 3♦, K♦. Ποιο φύλλο κερδίζει;"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se juega sin triunfo. Juegas último tras 10♦, 3♦ y K♦. ¿Qué carta gana?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas d'atout en jeu. Vous jouez en dernier sur 10♦, 3♦, K♦. Quelle carte gagne ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Niente atout in gioco. Sei ultimo in una presa con 10♦, 3♦, K♦. Quale carta vince?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ノートランプです。10♦、3♦、K♦の順に出たトリックで、最後に出すのはあなたです。勝つカードは？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "노트럼프 계약이에요. 10♦, 3♦, K♦ 순으로 카드가 나왔고 나는 마지막 차례예요. 어떤 카드가 이길까요?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen trumf er i spill. Du spiller sist etter 10♦, 3♦ og K♦. Hvilket kort vinner?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen troef in het spel. Je speelt als laatste op 10♦, 3♦, K♦. Welke kaart wint?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Козырей нет. Вы играете последним после 10♦, 3♦ и K♦. Какая карта выиграет взятку?"
          }
        },
        "sv": {
