            "state": "translated",
            "value": "Was zählt bei Matchpoints am meisten?"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Στα ματσπόιντ, τι μετρά περισσότερο;"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En matchpoints, qu'est-ce qui compte le plus ?"
          }
        },
        "it": {
