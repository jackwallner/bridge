          }
        }
      }
    },
    "All four players pass before any bid. What is the duplicate board score?": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle fire spillere passer, før nogen melder. Hvad er spillets score i turneringen?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle vier Spieler passen, bevor jemand bietet. Wie lautet das Ergebnis auf diesem Board?"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Και οι τέσσερις παίκτες λένε πάσο πριν από οποιαδήποτε δήλωση. Ποιο είναι το σκορ της διανομής στο ντουπλικάτ;"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los cuatro jugadores pasan sin que nadie haya cantado. ¿Qué puntuación obtiene la mano en bridge duplicado?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les quatre joueurs passent avant toute enchère. Quel est le score de la donne en duplicate ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutti e quattro i giocatori passano senza aprire. Qual è il punteggio della smazzata nel bridge duplicato?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "誰もビッドせずに4人全員がパスしました。デュプリケートでのボードのスコアは？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아무도 비드하지 않고 네 명 모두 패스했어요. 중복 보드 점수는 얼마일까요?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle fire spillerne passer før noen melder. Hva blir scoren på spillet i duplikatbridge?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle vier spelers passen voordat er geboden is. Wat is de wedstrijdscore van het spel?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все четыре игрока спасовали до первой заявки. Каков результат этой сдачи в дубликатном бридже?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Alla fyra spelare passar utan att någon hinner bjuda. Vad blir brickans resultat i partävling?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ผู้เล่นทั้งสี่คนพาสก่อนมีการประมูล คะแนนบอร์ดแบบดูพลิเคตคือเท่าไร"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dört oyuncu da hiçbir deklarasyon yapılmadan pas geçer. Düplikede bu boardun skoru nedir?"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "四家都不叫時，這副牌的複式賽分數是多少？"
          }
        }
      }
    },
    "Always play an ace": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Spil altid et es"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Immer ein Ass spielen"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Παίζετε πάντα άσο"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Juega siempre un as"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toujours jouer un as"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Giocare sempre un asso"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "必ずエースを出す"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에이스를 항상 내세요"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Spill alltid et ess"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Altijd een aas spelen"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всегда ходите тузом."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Spela alltid ett ess"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลงเอซเสมอ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her zaman as oynamak"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一定出 A"
          }
        }
      }
    },
    "An ace cannot be beaten, so it is a sure winner. A queen or a small card only wins once the higher cards in its suit are gone, so you cannot count it yet.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Et es kan ikke slås, så det er en sikker vinder. En dame eller et lille kort vinder først, når de højere kort i farven er væk, så du kan ikke tælle det endnu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Ass ist unschlagbar und macht sicher einen Stich. Eine Dame oder eine kleine Karte gewinnt erst, wenn die höheren Karten ihrer Farbe weg sind, also kannst du sie noch nicht als sicheren Stich zählen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο άσος δεν κερδίζεται, άρα είναι σίγουρη λεβέ. Μια ντάμα ή ένα μικρό φύλλο κερδίζει μόνο όταν φύγουν τα ψηλότερα φύλλα του χρώματος, οπότε δεν μπορείτε να το μετρήσετε ακόμη."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El as no puede ser superado, así que es una baza segura. La dama y las cartas bajas solo ganan cuando ya han salido las cartas superiores de su palo, así que todavía no puedes contarlas como ganadoras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un as ne peut pas être battu : c'est donc une levée sûre. Une dame ou une petite carte ne gagne qu'une fois les cartes plus fortes de sa couleur tombées ; vous ne pouvez donc pas encore la compter."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un asso non si può battere, quindi è una vincente sicura. Una donna o una cartina vince solo quando le carte più alte del seme sono uscite, quindi non puoi ancora contarla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エースは負けないので確実な勝ち札です。クイーンや小さいカードは、そのスートの上のカードがなくなって初めて勝てるので、まだ数えられません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에이스보다 높은 카드는 없으므로 확실한 승자예요. 퀸이나 낮은 카드는 같은 수트의 더 높은 카드가 빠져야 이길 수 있으니 아직 승자로 셀 수 없어요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Et ess kan ikke slås, så det er en sikker stikkvinner. En dame eller et lavt kort vinner først når de høyere kortene i fargen er spilt, så du kan ikke regne det som en vinner ennå."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een aas kan niet worden verslagen, dus is het een zekere slag. Een vrouw of een kleine kaart wint pas als de hogere kaarten in die kleur weg zijn, dus die kun je nog niet tellen."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Туз всегда выигрывает, поэтому это гарантированная взятка. Дама или мелкая карта возьмёт взятку, только когда старшие карты этой масти уже вышли, поэтому пока не считайте её взяткой."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett ess kan inte slås och är därför en säker vinnare. En dam eller ett lågt kort vinner först när de högre korten i färgen är borta, så du kan inte räkna det som vinnare än."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เอซไม่มีใครชนะได้ จึงเป็นไพ่ชนะแน่นอน ควีนหรือไพ่ใบเล็กจะชนะก็ต่อเมื่อไพ่ที่สูงกว่าในชุดออกไปหมดแล้ว จึงยังนับไม่ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "As yenilmez, dolayısıyla kesin löve alır. Kız ya da küçük bir kart ancak rengindeki daha büyük kartlar bittikten sonra löve kazanabilir; bu yüzden henüz kesin löve sayılmaz."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "A 不會被壓過，所以是穩贏的牌。Q 或小牌要等同花色更大的牌都出完才贏得到，所以還不能算。"
          }
        }
      }
    },
    "An ace is worth 4 HCP. Kings are 3, queens 2, and jacks 1.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Et es er 4 HP værd. Konger tæller 3, damer 2 og knægte 1."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Ass ist 4 FP wert. Könige zählen 3, Damen 2 und Buben 1."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ένας άσος αξίζει 4 πόντους τιμής. Οι ρηγάδες αξίζουν 3, οι ντάμες 2 και οι βαλέδες 1."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El as vale 4 HCP; el rey, 3; la dama, 2; y la sota, 1."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un as vaut 4 points H. Les rois valent 3, les dames 2 et les valets 1."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un asso vale 4 punti. I re valgono 3, le donne 2 e i fanti 1."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エースは4点。キングは3点、クイーンは2点、ジャックは1点です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에이스는 4 HCP, 킹은 3점, 퀸은 2점, 잭은 1점이에요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Et ess er verdt 4 HCP. Konger gir 3, damer 2 og knekter 1."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een aas is 4 punten waard. Heren tellen 3, vrouwen 2 en boeren 1."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Туз приносит 4 очка за старшие карты, король 3, дама 2, валет 1."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett ess är värt 4 HCP. Kungar är värda 3, damer 2 och knektar 1."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เอซมีค่า 4 แต้ม คิง 3 ควีน 2 และแจ็ค 1"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir as 4 puan eder. Papazlar 3, kızlar 2, valeler 1 sayılır."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "A 值 4 點，K 3 點，Q 2 點，J 1 點。"
          }
        }
      }
    },
    "An ace with no king behind it usually wins only small cards, and it can turn declarer's king into a winner. Save the ace to capture an honor.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Et es uden konge i farven vinder som regel kun småkort og kan gøre spilførerens konge til en vinder. Gem esset til at fange en honnør."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Ass ohne König dahinter gewinnt meist nur gegen kleine Karten und kann den König des Alleinspielers zum Gewinner machen. Heb das Ass auf, um einen Honneur zu fangen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ένας άσος χωρίς ρήγα από πίσω συνήθως πιάνει μόνο μικρά φύλλα και μπορεί να κάνει τον ρήγα του εκτελεστή λεβέ. Κρατήστε τον άσο για να πιάσετε μια τιμή."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un as sin el rey suele ganar solo cartas bajas y puede convertir el rey del declarante en ganador. Guarda el as para capturar un honor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un as sans le roi derrière ne prend en général que des petites cartes, et il peut transformer le roi du déclarant en levée. Gardez l'as pour capturer un honneur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un asso senza il re dietro di solito prende solo cartine e può trasformare il re del dichiarante in una vincente. Conserva l'asso per catturare un onore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キングを伴わないエースは、たいてい小さいカードしか取れず、ディクレアラーのキングを勝ち札にしてしまうこともあります。エースはオナーを捕まえるために取っておきます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "뒤에 킹이 없는 에이스는 보통 낮은 카드만 잡고, 선언자의 킹을 승자로 만들 수 있어요. 에이스를 아껴 상대의 고카드를 잡으세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Et ess uten kongen bak seg tar ofte bare småkort, og det kan gjøre spilleførerens konge til et stikk. Spar esset til å ta en honnør."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een aas zonder heer erachter wint meestal alleen kleine kaarten en kan van de heer van de leider een winnende kaart maken. Bewaar de aas om een honneur te vangen."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Туз без короля обычно забирает только мелкие карты, а его выход может подставить короля разыгрывающего под туза. Поберегите туза, чтобы взять фигуру соперника."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett ess utan kung bakom vinner oftast bara låga kort och kan göra spelförarens kung till en vinnare. Spara esset för att ta en honnör."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เอซที่ไม่มีคิงหนุนมักชนะได้แค่ไพ่ใบเล็ก และอาจทำให้คิงของดีแคลร์เรอร์กลายเป็นไพ่ชนะ เก็บเอซไว้จับออนเนอร์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arkasında papaz olmayan bir as genellikle yalnızca küçük kartları alır ve deklaranın papazına löve kazandırabilir. Bir onörü yakalamak için ası saklayın."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有 K 支援的 A 通常只能吃到小牌，也可能讓莊家的 K 變成贏張。把 A 留著抓大牌。"
          }
        }
      }
    },
    "An unsupported ace is often more valuable as an entry or capture later. Do not automatically cash aces on opening lead.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Et es uden konge er ofte mere værd senere som indgang eller til at fange en honnør. Indkassér ikke automatisk esser ved udspillet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein ungestütztes Ass ist später oft wertvoller, weil es als Übergang dienen oder einen Honneur fangen kann. Ziehe beim Ausspiel nicht automatisch Asse ab."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ένας ακάλυπτος άσος συχνά αξίζει περισσότερο αργότερα, ως είσοδος ή για να πιάσει μια τιμή. Μην εισπράττετε άσους αυτόματα στην αντάμ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un as sin apoyo suele ser más valioso como entrada o para capturar un honor más adelante. No cobres los ases automáticamente en la salida inicial."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un as sans soutien est souvent plus utile plus tard comme reprise ou pour capturer un honneur. N'encaissez pas automatiquement vos as à l'entame."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un asso senza il re spesso è più utile in seguito, come rientro o per catturare un onore. Non incassare automaticamente gli assi all'attacco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キングを伴わないエースは、後のエントリーやオナー取りに使うほうが価値があることが多いです。オープニングリードで機械的にエースを出さないこと。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "받쳐 주는 고카드가 없는 에이스는 나중에 엔트리로 쓰거나 상대 고카드를 잡는 데 더 유용할 수 있어요. 오프닝 리드 때 무조건 에이스를 내지는 마세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Et ess uten støtte fra andre honnører kan ofte brukes bedre som inntak eller til å ta en honnør senere. Ikke ta essene automatisk på utspill."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een aas zonder dekking is later vaak meer waard als entree of om een honneur te vangen. Kom niet automatisch met een aas uit."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Туз без поддержки часто ценнее как переход или возможность позже забрать фигуру. Не спешите сразу ходить тузом."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett ostött ess är ofta mer värdefullt som ingång eller för att ta en honnör senare. Spela inte automatiskt ut ess på öppningsutspel."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เอซที่ไม่มีไพ่สูงหนุนมักมีค่ามากกว่าเมื่อเก็บไว้เป็นทางเข้าหรือใช้จับไพ่สูงในภายหลัง อย่ารีบลงเอซเก็บทริกทันทีตอนลีดเปิด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Desteksiz bir as, daha sonra giriş veya bir onörü yakalama kartı olarak daha değerlidir. İlk atakta asları otomatik olarak çekmeyin."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有大牌支援的 A 留到後面通常更有價值，可以用來進手或抓大牌。首攻時別急著兌現 A。"
          }
        }
      }
    },
    "Announcing your points aloud": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "At sige sine point højt"
          }
        },
        "de": {
