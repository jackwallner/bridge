    "Playing cards in an order that shows how many you hold": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "At spille kort i en rækkefølge, der viser, hvor mange du har"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Karten in einer Reihenfolge spielen, die die Anzahl zeigt"
          }
        },
        "el": {
          "stringUnit": {
