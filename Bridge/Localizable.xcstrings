    "Know tricks and points, still slow in the auction": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeg har styr på stik og point, men er stadig langsom i meldingerne"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kenne Stiche und Punkte, in der Reizung noch langsam"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ξέρω από λεβέ και πόντους, αλλά αργώ στην αγορά"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conozco las bazas y los puntos, pero aún me cuesta la subasta"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je connais les levées et les points, mais les enchères me ralentissent encore"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Conosco prese e punti, ma la licita mi rallenta"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トリックと点数はわかるが、ビッドの判断はまだ遅い"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "트릭과 점수는 알지만 비딩은 아직 느려요"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan stikk og poeng, men er fortsatt treg i meldingsforløpet"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik ken slagen en punten, maar bied nog traag"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Знаю взятки и очки, но медлю в торговле"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Jag kan stick och poäng, men budgivningen går fortfarande långsamt."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รู้เรื่องทริกและแต้ม แต่ยังช้าตอนประมูล"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Löve ve puanları biliyorum, ihalede hâlâ yavaşım"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "懂墩數和點數，叫牌還不熟"
          }
        }
      }
    },
