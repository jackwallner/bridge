    "All four players pass before any bid. What is the duplicate board score?": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle fire spillere passer, før nogen melder. Hvad er spillets score i turneringen?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle vier Spieler passen, bevor jemand bietet. Wie lautet das Ergebnis auf diesem Board?"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Και οι τέσσερις παίκτες λένε πάσο πριν από οποιαδήποτε δήλωση. Ποιο είναι το σκορ της διανομής στο ντουπλικάτ;"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los cuatro jugadores pasan antes de cualquier voz. ¿Cuál es la puntuación del tablero duplicado?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les quatre joueurs passent avant toute enchère. Quel est le score de la donne en duplicate ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutti e quattro i giocatori passano senza aprire. Qual è il punteggio della smazzata nel bridge duplicato?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "誰もビッドせずに4人全員がパスしました。デュプリケートでのボードのスコアは？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "4명의 플레이어 모두 비드 전에 통과합니다. 중복보드 점수란 무엇인가요?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle fire spillere passerer før et bud. Hva er det dupliserte brettresultatet?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle vier spelers passen voordat er geboden is. Wat is de wedstrijdscore van het spel?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все четыре игрока пасуют до любой заявки. Какова двойная оценка доски?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Alla fyra spelarna passerar före något bud. Vad är dubblettbrädets poäng?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ผู้เล่นทั้งสี่คนพาสก่อนมีการประมูล คะแนนบอร์ดแบบดูพลิเคตคือเท่าไร"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dört oyuncu da hiçbir deklarasyon yapılmadan pas geçer. Düplikede bu boardun skoru nedir?"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "四家都不叫時，這副牌的複式賽分數是多少？"
          }
        }
      }
    },
    "Always play an ace": {
