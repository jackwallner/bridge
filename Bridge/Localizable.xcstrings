    "Following suit comes before every defensive signal.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "At bekende kommer før ethvert modspilssignal."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bedienen geht jedem Gegenspielsignal vor."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πρέπει να ακολουθείτε χρώμα πριν δώσετε οποιοδήποτε αμυντικό σινιάλο."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hacer lo mismo viene antes de cada señal defensiva."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fournir d'abord, signaler ensuite."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rispondere al colore viene prima di ogni segnale difensivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スートへのフォローは、どのディフェンスシグナルよりも優先されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다음 수트는 모든 방어 신호보다 먼저 나타납니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Følgende farge kommer før hvert forsvarssignal."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekennen gaat voor elk verdedigingssignaal."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Следование примеру происходит перед каждым защитным сигналом."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Följande färg kommer före varje defensiv signal."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การตามชุดมาก่อนสัญญาณป้องกันทุกแบบ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Renge uymak her savunma sinyalinden önce gelir."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "跟牌優先於任何防守信號。"
          }
        }
      }
    },
    "Following suit comes first. You may ruff only when you hold no cards in the suit led.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "At bekende kommer først. Du må kun trumfe, når du ikke har kort i den spillede farve."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bedienen geht vor. Trumpfen darfst du nur, wenn du keine Karte der ausgespielten Farbe hast."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πρώτα ακολουθείτε χρώμα. Κόβετε μόνο όταν δεν έχετε φύλλα στο χρώμα που βγήκε."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Primero debes servir al palo. Solo puedes fallar si no tienes cartas del palo de salida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il faut d'abord fournir. Vous ne pouvez couper que si vous êtes chicane dans la couleur entamée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prima di tutto si risponde al colore. Puoi tagliare solo se non hai carte nel seme giocato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォローが先です。ラフできるのは、リードされたスートがボイドのときだけです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가능하면 리드된 수트의 카드를 내야 합니다. 그 수트가 없을 때만 러프할 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du må følge fargen hvis du kan. Du kan bare stjele når du ikke har kort i utspillsfargen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekennen gaat voor. Je mag alleen introeven als je geen kaarten in de uitgekomen kleur hebt."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сначала нужно ходить в масть. Козырять можно, только если у вас нет карт масти выхода."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Följ färg först. Du får bara stjäla när du saknar kort i utspelsfärgen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การตามชุดมาก่อน ตัดทรัมป์ได้เฉพาะเมื่อไม่มีไพ่ชุดที่ลีด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önce renge uyulur. Açılan renkten kartınız yoksa koz çakabilirsiniz."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "跟牌優先。只有在該花色缺門時，才能王吃。"
          }
        }
      }
    },
    "Following suit is mandatory. Winning the trick is not.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du skal bekende kulør, men du behøver ikke vinde stikket."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du musst Farbe bedienen, aber nicht den Stich gewinnen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Είναι υποχρεωτικό να ακολουθείτε χρώμα. Δεν χρειάζεται όμως να κερδίσετε τη λεβέ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hacer lo mismo es obligatorio. Ganar la baza no lo es."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fournir est obligatoire. Gagner la levée ne l'est pas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rispondere al colore è obbligatorio. Vincere la presa no."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォローは義務です。トリックを取るのは義務ではありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다음 슈트는 필수입니다. 트릭에서 승리하는 것은 아닙니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Følgende farge er obligatorisk. Å vinne stikket er det ikke."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je moet bekennen, maar je hoeft de slag niet te winnen."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Соблюдение масти является обязательным. Выиграть взятка – нет."
          }
        },
        "sv": {
