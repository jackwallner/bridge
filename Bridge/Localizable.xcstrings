          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "五張紅心且有開叫牌力，應開叫 1♥。"
          }
        }
      }
    },
    "The guideline is strongest when partner may hold the next lower honor.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Retningslinjen er stærkest, når makker kan have den nærmeste lavere honnør."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Regel greift am stärksten, wenn der Partner den nächstniedrigeren Honneur haben könnte."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η οδηγία είναι πιο χρήσιμη όταν ο συμπαίκτης μπορεί να κρατά το αμέσως κατώτερο ονέρ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La pauta funciona mejor si tu pareja puede tener el siguiente honor inferior."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le principe vaut surtout quand le partenaire peut tenir l'honneur juste en dessous."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La regola vale di più quando il compagno può avere l'onore immediatamente inferiore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この指針は、パートナーがすぐ下のオナーを持っている可能性があるときに最も有効です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파트너가 바로 아래 고카드를 가질 수 있을 때 이 원칙이 가장 효과적이에요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Retningslinjen er best når makker kan ha neste lavere honnørkort."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De richtlijn is het sterkst als partner de eerstvolgende lagere honneur kan hebben."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это правило особенно полезно, если у партнёра может быть следующая по рангу фигура."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Regeln fungerar bäst när partnern kan ha nästa lägre honnör."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หลักนี้ได้ผลที่สุดเมื่อคู่อาจถือออนเนอร์ที่ต่ำลงมาหนึ่งขั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kural, ortağın bir alttaki onöre sahip olabileceği durumda en güçlüdür."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "同伴可能持有下一張較小的大牌時，這個原則最有效。"
          }
        }
      }
    },
