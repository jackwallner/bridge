    "When is second hand high right rather than second hand low?": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvornår er anden hånd højt rigtigt frem for anden hånd lavt?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wann ist zweite Hand hoch richtig statt zweite Hand tief?"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πότε το δεύτερο χέρι ψηλά είναι σωστό αντί για δεύτερο χέρι χαμηλά;"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand faut-il jouer gros en second plutôt que petit en second ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando il secondo di mano alto è giusto invece del secondo basso?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セカンドハンド・ローではなくハイが正しいのはいつ？"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wanneer speel je als tweede hand hoog in plaats van laag?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อไหร่ผู้เล่นคนที่สองควรลงสูงแทนลงต่ำ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İkinci el ne zaman küçük yerine büyük oynamalı?"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "什麼時候二家該出大，而不是出小？"
          }
        }
      }
    },
    "When opponents' trumps are the danger": {
      "extractionState": "manual",
      "localizations": {
        "da": {
