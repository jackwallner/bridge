    "Choose your usual bridge night and get a five-minute session built from your mistakes and weakest room when it matters.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg din faste bridgeaften, og få en femminutters runde bygget på dine fejl og dit svageste rum, når det gælder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle deinen üblichen Bridgeabend und erhalte genau dann eine Fünf-Minuten-Runde, die deine Fehler aufgreift und Übungen aus deinem schwächsten Raum enthält."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Διαλέξτε τη συνηθισμένη σας βραδιά μπριτζ και λάβετε τότε μια πεντάλεπτη συνεδρία εξάσκησης, προσαρμοσμένη στα λάθη σας και στην αίθουσα που σας δυσκολεύει περισσότερο."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige tu noche bridge habitual y disfruta de una sesión de cinco minutos construida a partir de tus errores y tu punto más débil cuando sea necesario."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez votre soirée bridge habituelle et recevez au bon moment une séance de cinq minutes axée sur vos erreurs et la salle où vous avez le plus de lacunes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli la tua solita serata di bridge e ricevi, quando serve, una sessione di cinque minuti basata sui tuoi errori e sulla sala in cui fai più fatica."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いつものブリッジの曜日を選ぶと、ミスや最も苦手な部屋をもとにした5分の練習が、必要なタイミングで届きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "평소 bridge 밤을 선택하고 중요한 순간에 실수와 가장 약한 방을 토대로 5분 세션을 구성하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg din vanlige bridge natt og få en fem-minutters økt bygget fra dine feil og svakeste rom når det gjelder."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies je vaste bridgeavond en krijg een sessie van vijf minuten op basis van je fouten en je zwakste kamer, precies wanneer het telt."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите свой обычный вечер bridge и получите пятиминутную сессию, построенную на ваших ошибках и самой слабой комнате, когда это важно."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj din vanliga bridge-natt och få en fem minuters session byggd av dina misstag och svagaste rummet när det gäller."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกคืนเล่นบริดจ์ประจำของคุณ แล้วรับเซสชันฝึกห้านาทีจากข้อที่พลาดและห้องที่อ่อนที่สุดในช่วงเวลาที่เหมาะ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her zamanki briç gecenizi seçin; hatalarınıza ve en zayıf olduğunuz odaya göre hazırlanmış beş dakikalık bir oturumu tam zamanında alın."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選好你平常打橋牌的晚上，需要時就會收到根據錯題和待加強項目安排的五分鐘練習。"
          }
        }
      }
    },
