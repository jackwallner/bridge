        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "捨て札が必要で、ダイヤを返してほしい"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "버리고 다이아몬드를 돌려받아야 합니다"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du må kaste og vil ha en diamant tilbake"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je moet afgooien en wilt dat partner ruiten terugspeelt"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы должны сбросить и потребовать вернуть бриллиант."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du måste kassera och vill ha tillbaka en diamant"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณต้องทิ้งไพ่และอยากให้คู่ลีดข้าวหลามตัดกลับมา"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İskarta yapmanız gerekiyor ve karo dönüşü istiyorsunuz"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你必須墊牌，並希望同伴回方塊"
          }
        }
      }
    },
    "You must follow suit whenever you hold the suit led. Which heart you choose is up to you.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du skal bekende, når du har den spillede farve. Hvilken hjerter du vælger, bestemmer du selv."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du musst bedienen, wann immer du die ausgespielte Farbe hast. Welches Coeur du wählst, ist deine Sache."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πρέπει να ακολουθείτε χρώμα όποτε το έχετε. Ποια κούπα θα διαλέξετε είναι δική σας επιλογή."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Debes hacer lo mismo siempre que mantengas el palo de salida. El corazón que elijas depende de ti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous devez fournir dès que vous avez la couleur jouée. À vous de choisir quel cœur jouer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Devi rispondere al colore ogni volta che hai il seme giocato. Sta a te scegliere quale carta di cuori giocare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リードされたスートを持っていれば必ずフォローします。どのハートを出すかは自由です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "슈트 리드를 잡을 때마다 슈트를 따라야 합니다. 어떤 마음을 선택할지는 당신에게 달려 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du må følge etter hver gang du holder utspillsfargen. Hvilket hjerte du velger er opp til deg."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je moet bekennen zodra je de gespeelde kleur hebt. Welke harten je kiest, mag je zelf weten."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы должны следовать его примеру всякий раз, когда держите масть во главе. Какое сердце вы выберете, зависит от вас."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du måste följa efter när du håller i utspelsfärg. Vilket hjärta du väljer är upp till dig."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ถ้ามีไพ่ในชุดที่ถูกลีด ต้องลงชุดนั้น แต่จะเลือกโพแดงใบไหนก็ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Açılan renk elinizdeyse uymalısınız. Hangi kupayı seçeceğiniz size kalmış."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只要你有這門花色，就必須跟牌。紅心要出哪張由你決定。"
          }
        }
      }
    },
    "You must follow the suit led whenever you can. The card need not be high.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du skal bekende kulør, når du kan. Kortet behøver ikke være højt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du musst die ausgespielte Farbe bedienen, wann immer du kannst. Die Karte muss nicht hoch sein."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πρέπει να ακολουθείτε το χρώμα που βγήκε όποτε μπορείτε. Το φύλλο δεν χρειάζεται να είναι μεγάλο."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Debes seguir el palo dirigido siempre que puedas. La tarjeta no tiene por qué ser alta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous devez fournir dans la couleur jouée dès que vous le pouvez. La carte n'a pas besoin d'être forte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Devi rispondere al colore ogni volta che puoi. La carta non deve per forza essere alta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リードされたスートを持っていれば必ずフォローします。高いカードでなくても構いません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "당신은 가능할 때마다 이끄는 수트을 따라야 합니다. 카드가 높을 필요는 없습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du må følge utspillsfargen når du kan. Kortet trenger ikke være høyt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je moet de gespeelde kleur bekennen als je kunt. De kaart hoeft niet hoog te zijn."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы должны следовать указаниям, когда можете. Карта не обязательно должна быть высокой."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du måste följa färglampan när du kan. Kortet behöver inte vara högt."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ต้องลงตามชุดที่ลีดทุกครั้งที่ทำได้ ไม่จำเป็นต้องเป็นไพ่สูง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Açılan renge her uyabildiğinizde uymalısınız. Kartın büyük olması gerekmez."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只要有這門花色就必須跟牌，不必出大牌。"
          }
        }
      }
    },
