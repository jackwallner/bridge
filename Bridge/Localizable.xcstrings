    "You must discard and want a diamond back": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du skal kaste af og vil have ruder tilbage"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du musst abwerfen und willst, dass dein Partner Karo zurückspielt"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πρέπει να πετάξετε φύλλο και θέλετε να σας επιστρέψουν καρό"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Debes descartar y quieres que te devuelvan diamantes"
