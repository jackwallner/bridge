        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Mitgliedschaft verlängert sich nicht. Was hätte dich zum Bleiben bewegt?"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η συνδρομή σας δεν θα ανανεωθεί. Τι θα σας έκανε να συνεχίσετε;"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu membresía no se renovará. ¿Qué te habría animado a seguir?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre abonnement ne sera pas renouvelé. Qu'est-ce qui vous aurait fait rester ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo abbonamento non si rinnoverà. Cosa ti avrebbe fatto restare?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メンバーシップは更新されません。何があれば続けていましたか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "멤버십이 갱신되지 않아요. 계속 이용하게 만들 만한 점은 무엇이었나요?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Medlemskapet fornyes ikke. Hva ville fått deg til å bli?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je lidmaatschap wordt niet verlengd. Wat had je kunnen overhalen om te blijven?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Членство не будет продлено. Что могло бы удержать вас?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ditt medlemskap förnyas inte. Vad hade fått dig att stanna?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การสมัครสมาชิกของคุณจะไม่ต่ออายุ อะไรจะทำให้คุณอยู่ต่อ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Üyeliğiniz yenilenmeyecek. Üyeliğinizi sürdürmeniz için ne gerekirdi?"
          }
        },
