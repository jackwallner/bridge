            "value": "เมื่อเจอสัญญามีทรัมป์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kozlu kontrata karşı"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "對有王合約"
          }
        }
      }
    },
    "Against notrump": {
      "extractionState": "manual",
      "localizations": {
