            "value": "Ένα σινγκλετόν μπορεί να φέρει κόψιμο όταν ο συμπαίκτης πάρει το χέρι και επιστρέψει το χρώμα."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un semifallo puede crear una oportunidad de fallo cuando tu compañero gana la mano y vuelve a ese palo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un singleton peut créer une coupe quand le partenaire prend la main et rejoue la couleur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un singolo può creare un taglio quando il compagno prende la mano e ritorna nel seme."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パートナーがリードを取ってそのスートを返せば、シングルトンからラフが生まれます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "싱글톤은 파트너가 리드를 잡고 그 수트를 다시 냈을 때 러프 기회를 만들 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En singleton kan gi mulighet for stjeling når makker kommer inn og spiller ut fargen igjen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een singleton kan een introefkans opleveren als partner aan slag komt en de kleur terugspeelt."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Синглет может дать возможность убить козырем, когда партнёр получит ход и продолжит эту масть."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En singelton kan skapa en stöld när partnern kommer in och spelar färgen en gång till."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ซิงเกิลตันอาจเปิดโอกาสให้ตัดได้ เมื่อคู่ได้ลีดแล้วเล่นชุดนั้นกลับมา"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Singleton, ortak eli alıp rengi geri oynadığında bir koz çakma fırsatı yaratabilir."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有單張時，若同伴拿到出牌權並回攻這門花色，你就有機會王吃。"
          }
        }
      }
    },
    "A singleton in any suit": {
      "extractionState": "manual",
      "localizations": {
