          "stringUnit": {
            "state": "translated",
            "value": "Det opgiver kontrollen og kan spille spilførerens konge fri"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es gibt die Kontrolle ab und kann den König des Alleinspielers hochspielen"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Παραδίδει τον έλεγχο και μπορεί να ελευθερώσει τον ρήγα του εκτελεστή"
          }
        },
        "fr": {
          "stringUnit": {
