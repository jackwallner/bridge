          "stringUnit": {
            "state": "translated",
            "value": "Den som vinner sticket spelar ut till nästa."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ผู้ชนะทริกจะเป็นคนลีดทริกถัดไป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Löveyi kazanan sonrakini açar."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "贏得這墩的人先出下一墩的牌。"
          }
        }
      }
    },
