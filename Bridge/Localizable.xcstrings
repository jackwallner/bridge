            "value": "Eerst %1$lld eerder fout beantwoorde vragen opnieuw oefenen, daarna extra oefenstof in %2$@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld Сначала из-за ошибок, затем дополнительная работа в %2$@."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld på grund av misstag först, sedan extraarbete i %2$@."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เริ่มจากข้อที่พลาด %1$lld ข้อ แล้วฝึกเพิ่ม: %2$@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önce tekrar sırası gelen %1$lld hatayı gözden geçirin, ardından %2$@ odasında ek alıştırma yapın."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "先複習 %1$lld 道錯題，再加練：%2$@。"
          }
        }
      }
    },
