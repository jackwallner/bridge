            "value": "So wird gespielt"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πώς παίζεται"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comment jouer"
          }
        },
        "it": {
