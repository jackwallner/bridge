          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj det lägsta kortet som säkert kommer att vinna det färdiga sticket."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกไพ่ใบต่ำที่สุดที่ยังชนะทริกนี้ได้แน่นอน"
          }
        },
        "tr": {
