        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η ακολουθία χρώματος είναι υποχρεωτική. Δεν χρειάζεται όμως να κερδίσετε τη λεβέ."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
