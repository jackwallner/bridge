    "%lld high-card points and a balanced %@ with no five-card major. That is the 15 to 17 notrump range, so open 1NT and describe the whole hand in one call.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld honnørpoint og en jævn %2$@ uden femkorts højfarve. Det er 1NT-intervallet på 15 til 17, så åbn 1NT og beskriv hele hånden i én melding."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld Figurenpunkte und eine ausgeglichene %2$@ ohne Fünferoberfarbe. Das ist der 1NT-Bereich von 15 bis 17, also eröffne 1NT und beschreibe die ganze Hand mit einem Gebot."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld πόντοι τιμής και ισοκατανεμημένο %2$@ χωρίς πεντάφυλλο μείζον. Αυτό είναι το εύρος 15 έως 17 πόντων για άνοιγμα 1NT, άρα ανοίξτε 1NT και περιγράψτε όλο το χέρι με μία δήλωση."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld puntos de cartas altas y un %2$@ equilibrado sin mayores de cinco cartas. Ese es el rango de 15 a 17 sin triunfo, así que abra 1NT y describa la mano completa en una sola voz."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld points H et une main régulière %2$@ sans majeure cinquième. C'est la zone 15 à 17 du sans-atout : ouvrez 1NT et décrivez toute la main en une enchère."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld punti onori e una mano bilanciata %2$@ senza un nobile quinto. Rientra nella fascia da 15 a 17 punti per l'apertura di 1NT, quindi apri 1NT e descrivi tutta la mano con una sola dichiarazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ハイカードポイント%1$lld点、5枚のメジャーがないバランス型の%2$@。ノートランプの15〜17点の範囲なので、1NTでオープンし、1回のビッドで手全体を伝えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld 하이 카드 포인트와 5카드 메이저가 없는 균형 잡힌 %2$@입니다. 그것은 15에서 17까지의 트럼프 범위이므로 1NT를 열고 한 번의 입찰로 전체 핸드를 설명하십시오."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld høykortpoeng og en balansert %2$@ uten femkorts major. Det er 15 til 17 ingen trumf-området, så åpne 1NT og beskriv hele hånden i ett bud."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld honneurpunten en een evenwichtige %2$@-verdeling, zonder vijfkaart hoge kleur. Dat is de 1NT-zone van 15 tot 17, dus open 1NT en beschrijf de hele hand in één bod."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld с высокими картами и сбалансированный %2$@ без пятикарточной мажорной карты. Это диапазон от 15 до 17 без козыря, поэтому откройте 1NT и опишите всю руку в одной заявке."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld högkortspoäng och en balanserad %2$@ utan femkorts major. Det är intervallet 15 till 17 i sang, så öppna 1NT och beskriv hela handen i ett bud."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แต้มไพ่สูง %1$lld แต้มและมือสมดุลแบบ %2$@ ที่ไม่มีเมเจอร์ห้าใบ อยู่ในช่วง 15 ถึง 17 แต้มสำหรับเปิด 1NT จึงเปิด 1NT เพื่อบอกลักษณะมือทั้งหมดในคำประมูลเดียว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld onör puanı ve beşli majörü olmayan dengeli %2$@. Bu, 15-17 sanzatu aralığı; 1NT açın ve tüm eli tek deklarasyonla anlatın."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld 個大牌點，平均牌型 %2$@，沒有五張高花。這是 15 到 17 點的無王範圍，開叫 1NT，一次描述整手牌。"
          }
        }
      }
    },
