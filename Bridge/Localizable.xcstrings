    "%lld high-card points, %@. You need about 13 to open at the one level, so pass and wait for your partner.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld honnørpoint, %2$@. Du skal have omkring 13 for at åbne på 1-trinnet, så pas og vent på din makker."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld Figurenpunkte, %2$@. Für eine Eröffnung auf Einerstufe brauchst du etwa 13, also passe und warte auf deinen Partner."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld πόντοι τιμής, %2$@. Χρειάζεστε περίπου 13 για άνοιγμα στο επίπεδο του ενός, άρα πάσο και περιμένετε τον συμπαίκτη."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld points H, %2$@. Il faut environ 13 points pour ouvrir au palier de un : passez et laissez parler votre partenaire."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld punti onori, %2$@. Servono circa 13 punti per aprire a livello uno, quindi passa e aspetta il compagno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ハイカードポイント%1$lld点、%2$@。1レベルでオープンするには13点前後が必要なので、パスしてパートナーを待ちます。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld honneurpunten, %2$@. Je hebt ongeveer 13 nodig om op eenniveau te openen, dus pas en wacht op je partner."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แต้มไพ่สูง %1$lld แต้ม %2$@ ต้องมีราว 13 แต้มถึงจะเปิดที่ระดับหนึ่ง จึงพาสแล้วรอคู่ของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld onör puanı, %2$@. Birli seviyede açmak için yaklaşık 13 gerekir; pas deyin ve ortağınızı bekleyin."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld 個大牌點，%2$@。一階開叫約需 13 點，所以派司，等同伴發言。"
          }
        }
      }
    },
