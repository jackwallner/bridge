            "value": "遊び方"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zo speel je"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วิธีเล่น"
          }
        },
        "tr": {
