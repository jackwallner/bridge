        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld πόντοι τιμής, %2$@, χωρίς πεντάφυλλο μείζον. Ανοίξτε το μακρύτερο ελάσσον: %3$@. Με ισομήκη ελάσσονα, ανοίξτε το ψηλότερο."
          }
        },
        "fr": {
