    "Delay drawing trumps only when you need dummy's trumps for ruffing first.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Udskyd trumftrækket, kun når du først skal bruge bordets trumf til at trumfe med."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verzögere das Trumpfziehen nur, wenn du die Trümpfe des Dummys zuerst zum Schnappen brauchst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Καθυστερήστε το μάζεμα των ατού μόνο όταν χρειάζεστε πρώτα τα ατού του μορ για κοψίματα."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne retardez le tirage des atouts que si vous avez d'abord besoin des atouts du mort pour couper."
          }
        },
        "it": {
