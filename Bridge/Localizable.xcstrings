          "stringUnit": {
            "state": "translated",
            "value": "ซื้อครั้งเดียว ไม่ใช่การสมัครสมาชิก ไม่มีการต่ออายุ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tek seferlik satın alma. Abonelik yok, yenilenmez."
          }
