    "With a minor of the same length, start with the higher ranking suit.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis lavfarverne er lige lange, åbner du den højest rangerede."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ist eine Unterfarbe gleich lang, eröffnest du die höhere Farbe."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αν τα ελάσσονα έχουν το ίδιο μήκος, ανοίξτε το ψηλότερο χρώμα."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con un menor de la misma longitud, comience con el palo de mayor rango."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avec une mineure de même longueur, commencez par la couleur la plus chère."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Con un minore di pari lunghezza, apri il seme di rango superiore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じ長さのマイナーがあるなら、高いスートから始めます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "같은 길이의 마이너로 더 높은 순위의 슈트부터 시작하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Med en moll av samme lengde, start med den høyere rangerte fargen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bij gelijke lengte open je de hoogste van de twee lage kleuren."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если минор такой же длины, начните с масти более высокого ранга."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Med en moll av samma längd, börja med den högre rankade färgen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ถ้ามีไมเนอร์ที่ยาวเท่ากัน ให้เริ่มจากชุดที่สูงกว่า"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aynı uzunluktaki minörler arasında sıralamada üstte olanla başlayın."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "兩門低花一樣長時，開叫階級較高的那門。"
          }
        }
      }
    },
