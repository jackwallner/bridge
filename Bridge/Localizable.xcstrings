    "Lead a singleton side suit?": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Spille en singleton i en sidefarve ud?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
