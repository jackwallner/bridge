    "%lld high-card points, %@, no five-card major and outside the 15 to 17 notrump range. Open your longer minor: %@. With three of each minor the convention is the short club.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld honnørpoint, %2$@, ingen femkorts højfarve og uden for 1NT-intervallet på 15 til 17. Åbn din længste lavfarve: %3$@. Med tre kort i hver lavfarve er konventionen kort klør."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld Figurenpunkte, %2$@, keine Fünferoberfarbe und außerhalb des 1NT-Bereichs von 15 bis 17. Eröffne deine längere Unterfarbe: %3$@. Mit je drei Karten in beiden Unterfarben ist die Konvention das kurze Treff."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld πόντοι τιμής, %2$@, χωρίς πεντάφυλλο μείζον και εκτός του εύρους 15 έως 17. Ανοίξτε το μακρύτερο ελάσσον: %3$@. Με τρία φύλλα σε κάθε ελάσσον, η σύμβαση είναι το κοντό σπαθί."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld points H, %2$@, pas de majeure cinquième et hors de la zone 15 à 17 du sans-atout. Ouvrez votre plus longue mineure : %3$@. Avec trois cartes dans chaque mineure, la convention est le trèfle court."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld punti onori, %2$@, nessun nobile quinto e fuori dalla fascia 15-17 del senza. Apri il minore più lungo: %3$@. Con tre carte in ogni minore la convenzione è il fiori corto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ハイカードポイント%1$lld点、%2$@、5枚のメジャーなし、ノートランプの15〜17点の範囲外。長いほうのマイナーでオープン：%3$@。マイナーが3枚ずつなら、約束はショートクラブです。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld honneurpunten, %2$@, geen vijfkaart hoge kleur en buiten de 1NT-zone van 15 tot 17. Open je langste lage kleur: %3$@. Met drie kaarten in elke lage kleur is de afspraak de korte klaveren."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แต้มไพ่สูง %1$lld แต้ม %2$@ ไม่มีเมเจอร์ห้าใบ และอยู่นอกช่วงโนทรัมป์ 15 ถึง 17 เปิดไมเนอร์ที่ยาวกว่า: %3$@ ถ้ามีไมเนอร์ชุดละสามใบ ข้อตกลงคือดอกจิกสั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld onör puanı, %2$@, beşli majör yok ve 15-17 sanzatu aralığının dışında. Uzun minörünüzü açın: %3$@. Her minörde üçer kart varsa konvansiyon kısa sinektir."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld 個大牌點，%2$@，沒有五張高花，也不在 15 到 17 點的無王範圍。開叫較長的低花：%3$@。兩門低花各三張時，慣例是短梅花。"
          }
        }
      }
    },
