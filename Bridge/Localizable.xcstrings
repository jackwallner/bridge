        },
        "da": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Først %lld fejl til gentagelse, derefter stof, du ikke har set endnu."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Først %lld fejl til gentagelse, derefter stof, du ikke har set endnu."
