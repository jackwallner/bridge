    "High-card points": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Honnørpoint"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Figurenpunkte"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πόντοι τιμής"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Points d'honneur"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Punti onori"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ハイカードポイント"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Honneurpunten"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แต้มไพ่สูง"
          }
        },
        "tr": {
