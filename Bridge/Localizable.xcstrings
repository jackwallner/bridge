    "A trump lead can remove dummy's ruffing power and cut down declarer's crossruff.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Et trumfudspil kan fjerne bordets trumfkraft og bremse spilførerens krydstrumf."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Trumpfausspiel kann dem Dummy die Schnappmöglichkeiten nehmen und das Kreuzschnappen des Alleinspielers einschränken."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η έξοδος με ατού μπορεί να στερήσει από τον μορ τη δυνατότητα να κόψει και να περιορίσει τα διασταυρούμενα κοψίματα του εκτελεστή."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une entame atout peut priver le mort de ses possibilités de coupe et limiter les coupes croisées du déclarant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un attacco in atout può togliere al morto la forza di taglio e ridurre il doppio taglio del dichiarante."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "切り札のリードでダミーのラフする力を奪い、ディクレアラーのクロスラフを減らせます。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een troefuitkomst kan de troefkracht van de dummy wegnemen en de kruistroef van de leider afremmen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การลีดทรัมป์ช่วยให้ดัมมี่ตัดไพ่ได้น้อยลง และจำกัดการครอสรัฟของดีแคลร์เรอร์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Koz atağı yerin koz çakma gücünü azaltabilir ve deklaranın çapraz koz çakmasını kesebilir."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "領出王牌能削弱夢家的王吃能力，減少莊家的交叉王吃。"
          }
        }
      }
    },
