            "value": "Acquisto una tantum. Nessun abbonamento, niente rinnovi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "買い切り。サブスクリプションではなく、更新されません。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eenmalige aankoop. Geen abonnement, er wordt niets verlengd."
