    "A singleton can create a ruff when partner gets the lead and returns the suit.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En singleton kan give en trumfning, når makker kommer ind og spiller farven tilbage."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Single kann einen Schnapper bringen, wenn der Partner ans Spiel kommt und die Farbe zurückspielt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ένα σινγκλετόν μπορεί να φέρει κόψιμο όταν ο συμπαίκτης πάρει το χέρι και επιστρέψει το χρώμα."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un semifallo puede darte la oportunidad de fallar cuando tu pareja gana la mano y vuelve a ese palo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un singleton peut créer une coupe quand le partenaire prend la main et rejoue la couleur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un singolo può creare un taglio quando il compagno prende la mano e ritorna nel seme."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パートナーがリードを取ってそのスートを返せば、シングルトンからラフが生まれます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "싱글톤은 파트너가 리드를 잡고 그 수트를 다시 냈을 때 트럼프로 자를 기회를 만들 수 있어요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En singelton kan gi mulighet til å stjele når makker kommer inn og spiller fargen tilbake."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een singleton kan een introefkans opleveren als partner aan slag komt en de kleur terugspeelt."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Синглет может позволить убить козырем, когда партнёр получит ход и продолжит этой мастью."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En singelton kan ge en stöld när partnern kommer in och spelar färgen tillbaka."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ซิงเกิลตันอาจเปิดโอกาสให้ตัดได้ เมื่อคู่ได้ลีดแล้วเล่นชุดนั้นกลับมา"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Singleton, ortak eli alıp rengi geri oynadığında bir koz çakma fırsatı yaratabilir."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有單張時，若同伴拿到出牌權並回攻這門花色，你就有機會王吃。"
          }
        }
      }
    },
    "A singleton in any suit": {
