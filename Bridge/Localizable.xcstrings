    "Biggest jump in %@. Keep that pace and it holds.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Største fremgang i %@. Fortsæt i samme tempo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Größter Sprung: %@. Bleib dran, dann hält es."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η μεγαλύτερη βελτίωση στην αίθουσα %@. Συνεχίστε στον ίδιο ρυθμό για να τη διατηρήσετε."
          }
