          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Βγάλσιμο σινγκλετόν σε πλευρικό χρώμα;"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Entamer un singleton ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attaccare con un singolo laterale?"
          }
        },
        "ja": {
          "stringUnit": {
