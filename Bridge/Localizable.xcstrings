    "%lld high-card points, %@, no five-card major and outside the 15 to 17 notrump range.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld honnørpoint, %2$@, ingen femkorts højfarve og uden for sans-intervallet på 15 til 17."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld Figurenpunkte, %2$@, keine Fünferoberfarbe und außerhalb des 1NT-Bereichs von 15 bis 17."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld πόντοι τιμής, %2$@, χωρίς πεντάφυλλο μείζον και εκτός του εύρους 15 έως 17 για χωρίς ατού."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld points H, %2$@, pas de majeure cinquième et hors de la zone 15 à 17 du sans-atout."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld punti onori, %2$@, nessun nobile quinto e fuori dall'intervallo 15-17 del senza."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ハイカードポイント%1$lld点、%2$@、5枚のメジャーなし、ノートランプの15〜17点の範囲外。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld honneurpunten, %2$@, geen vijfkaart hoge kleur en buiten het sans-atoutbereik van 15 tot 17."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แต้มไพ่สูง %1$lld แต้ม %2$@ ไม่มีเมเจอร์ห้าใบ และอยู่นอกช่วงโนทรัมป์ 15 ถึง 17"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld onör puanı, %2$@, beşli majör yok ve 15-17 sanzatu aralığının dışında."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld 個大牌點，%2$@，沒有五張高花，也不在 15 到 17 的無王範圍內。"
          }
        }
      }
    },
    "%lld high-card points, %@, no five-card major.": {
      "extractionState": "manual",
      "localizations": {
