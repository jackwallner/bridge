        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sì, se puoi"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "はい、できるときに"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ja, als het kan"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช่ ถ้าทำได้"
          }
        },
