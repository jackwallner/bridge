            "state": "translated",
            "value": "Dat zijn samen %lld honneurpunten. Azen 4, heren 3, vrouwen 2, boeren 1."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Итого %lld очков за старшие карты. Тузы 4, короли 3, дамы 2, валеты 1."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det blir %lld honnörspoäng: ess 4, kung 3, dam 2 och knekt 1."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รวม %lld แต้มไพ่สูง เอซ 4 คิง 3 ควีน 2 แจ็ค 1"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toplamda %lld onör puanı eder. Aslar 4, papazlar 3, kızlar 2, valeler 1."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "合計 %lld 個大牌點。A 4、K 3、Q 2、J 1。"
          }
        }
      }
    },
    "The 10♣ beats the 9♣. Save the king and ace for later tricks.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "10♣ slår 9♣. Gem kongen og esset til senere stik."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die 10♣ schlägt die 9♣. Heb König und Ass für spätere Stiche auf."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το 10♣ νικά το 9♣. Κρατήστε τον ρήγα και τον άσο για τις επόμενες λεβέ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "10♣ supera a 9♣. Guarda el rey y el as para bazas posteriores."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le 10♣ bat le 9♣. Gardez le roi et l'as pour plus tard."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il 10♣ batte il 9♣. Tieni re e asso per le prese successive."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "10♣が9♣に勝ちます。キングとエースは後のトリックのために温存します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "10♣가 9♣보다 높아요. 킹과 에이스는 다음 트릭을 위해 아껴 두세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "10♣ slår 9♣. Spar kongen og esset til senere stikk."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De 10♣ slaat de 9♣. Bewaar heer en aas voor latere slagen."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "10♣ бьёт 9♣. Сохраните короля и туза для следующих взяток."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "10♣ slår 9♣. Spara kung och ess till senare stick."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "10♣ ชนะ 9♣ เก็บคิงและเอซไว้สำหรับทริกต่อไป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "10♣ ile 9♣ yenilir. Papaz ve ası sonraki löveler için saklayın."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "10♣ 大過 9♣。把 K 和 A 留給之後的墩。"
          }
        }
      }
    },
