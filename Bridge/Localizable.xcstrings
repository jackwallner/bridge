    "Come back now and then so it stays sharp.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kig forbi en gang imellem, så det sidder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schau ab und zu vorbei, damit es sitzt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιστρέφετε πού και πού για να μένετε σε φόρμα."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve de vez en cuando para que se mantenga nítido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Revenez de temps en temps pour garder la main."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Torna ogni tanto per restare in forma."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ときどき戻って、感覚を保ちましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가끔씩 돌아와서 날카로움을 유지하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kom tilbake nå og da så den forblir skarp."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kom af en toe terug om scherp te blijven."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Возвращайтесь время от времени, чтобы он оставался острым."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kom tillbaka då och då så att den förblir skarp."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กลับมาฝึกเป็นระยะเพื่อให้ทักษะยังเฉียบคม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Beceriniz körelmesin diye ara sıra geri dönün."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "偶爾回來練習，保持手感。"
          }
        }
      }
    },
    "Comfortable, want sharper instincts": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Har styr på det, vil skærpe instinkterne"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sicher, möchte mein Gespür schärfen"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Άνετος, θέλω καλύτερο ένστικτο"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Me manejo bien, pero quiero afinar mi intuición"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À l'aise, je veux plus de réflexes"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mi sento a mio agio, ma voglio affinare l'istinto"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "慣れているので、感覚を磨きたい"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "편하게 플레이하지만 판단력을 더 키우고 싶어요"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Spiller trygt, men vil skjerpe vurderingene mine"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gaat goed, maar ik wil scherper spelen"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Играю уверенно, но хочу быстрее принимать решения"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Spelar tryggt men vill vässa min blick"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เล่นคล่อง อยากเล่นให้เฉียบคมขึ้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rahatım, sezgilerimi keskinleştirmek istiyorum"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "打得還行，想更有牌感"
          }
        }
      }
    },
    "Compare only cards in the suit led when there is no trump.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
