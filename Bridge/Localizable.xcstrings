    "Twelve points with this shape meet the Rule of 20 guideline: points plus your two longest suits make %lld.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tolv point med denne fordeling opfylder 20-reglen: point plus dine to længste farver giver %lld."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwölf Punkte mit dieser Verteilung erfüllen die Zwanzigerregel: Punkte plus deine zwei längsten Farben ergeben %lld."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δώδεκα πόντοι με αυτή τη διανομή πληρούν τον κανόνα του 20: οι πόντοι μαζί με τα μήκη των δύο μακρύτερων χρωμάτων σας δίνουν %lld."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Douze points avec cette distribution respectent la règle des 20 : les points plus vos deux plus longues couleurs font %lld."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodici punti con questa distribuzione rispettano la regola del 20: i punti più i tuoi due semi più lunghi fanno %lld."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この形の12点は「20のルール」を満たします：点数と最も長い2スートの枚数を足すと%lldです。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twaalf punten met deze verdeling voldoen aan de regel van 20: je punten plus de lengtes van je twee langste kleuren komen samen op %lld."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สิบสองแต้มกับรูปมือนี้ผ่านเกณฑ์กฎ 20: แต้มบวกจำนวนไพ่สองชุดที่ยาวที่สุดได้ %lld"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu dağılımla on iki puan 20 kuralını karşılar: puanlar artı en uzun iki renginiz %lld eder."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這種牌型的 12 點符合二十法則：點數加上最長兩門花色的張數共 %lld。"
          }
        }
      }
    },
