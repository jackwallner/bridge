          "stringUnit": {
            "state": "translated",
            "value": "Un singolo può creare un taglio quando il compagno prende la mano e ritorna nel seme."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パートナーがリードを取ってそのスートを返せば、シングルトンからラフが生まれます。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een singleton kan een introever opleveren als partner aan slag komt en de kleur terugspeelt."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ซิงเกิลตันอาจได้ตัดทรัมป์เมื่อคู่ได้ลีดและคืนชุดนั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Singleton, ortak eli alıp rengi geri oynadığında bir koz çakma fırsatı yaratabilir."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有單張時，若同伴拿到出牌權並回攻這門花色，你就有機會王吃。"
          }
        }
      }
    },
