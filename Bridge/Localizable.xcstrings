        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa mano ha forza d'apertura, cinque quadri e nessun nobile quinto. Apri il minore più lungo, 1♦."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この手はオープンの強さがあり、ダイヤが5枚で5枚のメジャーはありません。長いほうのマイナー、1♦でオープンします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오프닝 점수에 다이아몬드 5장, 5장 메이저 수트가 없어요. 더 긴 마이너 수트 1♦로 오프닝하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne hånden har åpningsstyrke, fem ruter og ingen majorfarge med fem kort. Åpne med den lengste minorfargen, 1♦."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze hand heeft openingskracht, vijf ruiten en geen vijfkaart hoog. Open de langste lage kleur, 1♦."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта рука подходит для открытия: пять бубен, без пяти карт в старшей масти. Откройте более длинную младшую масть, 1♦."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här handen har öppningsstyrka, fem ruter och ingen femkortshögfärg. Öppna med den längre lågfärgen, 1♦."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มือนี้แข็งพอเปิด มีข้าวหลามตัดห้าใบและไม่มีเมเจอร์ห้าใบ จึงเปิดไมเนอร์ที่ยาวกว่า คือ 1♦"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu elde açış gücü ve beş karo var, beşli majör yok. Uzun minörünüzü açın, 1♦."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這手牌有開叫實力、五張方塊、沒有五張高花。開叫較長的低花 1♦。"
          }
        }
      }
    },
    "This is an interior sequence. The jack is safe, describes the holding to partner, and keeps the king guarding the suit.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det er en indre sekvens. Knægten er sikker, fortæller makker, hvilke kort du har, og lader kongen beskytte farven."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ist eine innere Sequenz. Der Bube ist sicher, beschreibt dem Partner die Haltung und lässt den König die Farbe schützen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Είναι εσωτερική σεκάνς. Ο βαλές είναι ασφαλής, δείχνει στον συμπαίκτη το κράτημά σας και διατηρεί τον ρήγα ως φύλακα του χρώματος."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta es una secuencia interna. La sota es segura, describe tu tenencia a tu pareja y deja al rey protegiendo el palo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C'est une séquence intérieure. Le valet peut être joué sans risque, décrit la tenue au partenaire et garde le roi pour protéger la couleur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È una sequenza interna. Il fante è una carta sicura, descrive la tenuta al compagno e lascia il re a guardia del seme."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インテリアシークエンスです。ジャックは安全で、パートナーに持ち札を伝え、キングをスートの守りに残せます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이너 시퀀스예요. 잭을 내면 안전하게 손의 모양을 파트너에게 알리면서 킹으로 수트를 지킬 수 있어요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette er en indre sekvens. Knekten er trygg, viser kortene dine til makker og lar kongen vokte fargen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit is een binnensequentie. De boer is veilig om te spelen en vertelt partner iets over je kleur, terwijl de heer de kleur bewaakt."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это внутренняя последовательность. Валет безопасен, показывает партнёру комбинацию и сохраняет короля для защиты масти."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det här är en inre sekvens. Knekten är säker, visar partnern vad du har och låter kungen skydda färgen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "นี่คือไพ่เรียงภายใน แจ็คปลอดภัย บอกลักษณะไพ่ให้คู่ และเก็บคิงไว้คุ้มกันชุด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu bir iç sekans. Vale güvenlidir, elinizdeki kartları ortağa gösterir ve papazın rengi korumasını sağlar."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這是內連張。J 很安全，能向同伴描述持牌，也讓 K 留著保護這門花色。"
          }
        }
      }
    },
