    "It gives up control and may set up declarer's king": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det opgiver kontrollen og kan spille spilførerens konge fri"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
