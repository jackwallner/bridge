    "The guideline is strongest when partner may hold the next lower honor.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Retningslinjen er stærkest, når makker kan have den nærmeste lavere honnør."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Regel greift am stärksten, wenn der Partner den nächstniedrigeren Honneur haben könnte."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η οδηγία είναι πιο χρήσιμη όταν ο συμπαίκτης μπορεί να κρατά το αμέσως κατώτερο ονέρ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La pauta es más fuerte cuando el compañero puede tener el siguiente honor inferior."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le principe vaut surtout quand le partenaire peut tenir l'honneur juste en dessous."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La regola vale di più quando il compagno può avere l'onore immediatamente inferiore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この指針は、パートナーがすぐ下のオナーを持っている可能性があるときに最も有効です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파트너가 차상위 명예를 보유할 수 있을 때 지침이 가장 강력합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Retningslinjen er sterkest når partner kan ha neste lavere ære."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De richtlijn is het sterkst als partner de eerstvolgende lagere honneur kan hebben."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это правило является наиболее сильным, если партнер может иметь следующую более низкую награду."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Riktlinjen är starkast när partner kan ha nästa lägre ära."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หลักนี้ได้ผลที่สุดเมื่อคู่อาจถือออนเนอร์ที่ต่ำลงมาหนึ่งขั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
