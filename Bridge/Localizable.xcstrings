    "With 14 HCP and five hearts, open 1♥.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Med 14 HP og fem hjerter åbner du 1♥."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit 14 FP und fünf Coeur eröffnest du 1♥."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Με 14 πόντους και πέντε κούπες, ανοίξτε 1♥."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avec 14 H et cinq cœurs, ouvrez 1♥."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Con 14 punti e cinque cuori, apri 1♥."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
