        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "리드를 포기해 선언자의 킹을 굳혀 줄 수 있어요"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du gir fra deg innspillet og kan godspille spilleførerens konge."
