    "Come back now and then so it stays sharp.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kig forbi en gang imellem, så det sidder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schau ab und zu vorbei, damit es sitzt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιστρέφετε πού και πού για να μείνει κοφτερό."
          }
