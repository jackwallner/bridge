    "Declarer has shown five spades and four hearts, and held exactly two clubs. How many diamonds do they hold?": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Spilføreren har vist fem spar og fire hjerter og havde præcis to klør. Hvor mange ruder har spilføreren?"
