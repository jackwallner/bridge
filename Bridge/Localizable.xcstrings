    "Six high-card points and no long suit. You need about 13 to open at the one level, so pass.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Seks honnørpoint og ingen lang farve. Du skal have omkring 13 for at åbne på 1-trinnet, så pas."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sechs Figurenpunkte und keine lange Farbe. Für eine Eröffnung auf Einerstufe brauchst du etwa 13, also passe."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Έξι πόντοι τιμής και κανένα μακρύ χρώμα. Χρειάζεστε περίπου 13 για άνοιγμα στο επίπεδο του ενός, άρα πάσο."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Six points H et pas de longue. Il faut environ 13 pour ouvrir au palier de un, donc passez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sei punti onori e nessun seme lungo. Servono circa 13 punti per aprire a livello uno, quindi passa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ハイカードポイント6点で長いスートもなし。1レベルでオープンするには13点前後が必要なのでパスです。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zes honneurpunten en geen lange kleur. Je hebt ongeveer 13 nodig om op eenniveau te openen, dus pas."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หกแต้มไพ่สูงและไม่มีชุดยาว ต้องมีราว 13 แต้มถึงจะเปิดที่ระดับหนึ่ง จึงพาส"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Altı onör puanı ve uzun renk yok. Birli seviyede açmak için yaklaşık 13 gerekir, o yüzden pas."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "6 個大牌點，沒有長門。一階開叫約需 13 點，所以派司。"
          }
        }
      }
    },
    "Six spades and 13 HCP make 1♠ the clear opening.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Seks spar og 13 HP gør 1♠ til den klare åbning."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sechs Pik und 13 FP machen 1♠ zur klaren Eröffnung."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Έξι πίκες και 13 πόντοι κάνουν το 1♠ το προφανές άνοιγμα."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Six piques et 13 H font de 1♠ l'ouverture évidente."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sei picche e 13 punti fanno di 1♠ l'apertura ovvia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スペード6枚と13点なら1♠が明快なオープンです。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zes schoppen en 13 punten maken 1♠ de duidelijke opening."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โพดำหกใบและ 13 แต้มทำให้ 1♠ เป็นการเปิดที่ชัดเจน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Altı maça ve 13 puan 1♠'yi açık bir açış yapar."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
