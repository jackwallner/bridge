    "%@ unlocks the extra sets here and in every other room, the Master Tables, Bridge Minute, Game Night Prep, and Endless Practice. Everything you already have stays free.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ låser ekstrasættene op her og i alle andre rum, mesterbordene, Bridge Minute, klar til bridgeaften og endeløs træning. Alt, hvad du allerede har, forbliver gratis."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ schaltet die Extrasets hier und in jedem anderen Raum frei, dazu die Meistertische, Bridge Minute, Spielabend-Vorbereitung und Endlos-Training. Alles, was du schon hast, bleibt kostenlos."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το %@ ξεκλειδώνει τα επιπλέον σετ εδώ και σε κάθε άλλη αίθουσα, τα τραπέζια των μάστερ, το Bridge Minute, την προετοιμασία βραδιάς και την ατελείωτη εξάσκηση. Ό,τι έχετε ήδη μένει δωρεάν."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ débloque les séries bonus ici et dans toutes les salles, les tables des maîtres, Bridge Minute, la prépa soirée bridge et l'entraînement infini. Tout ce que vous avez reste gratuit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ sblocca i set extra qui e in ogni altra sala, i tavoli dei maestri, Bridge Minute, Prepara la serata e l'allenamento infinito. Tutto ciò che hai resta gratis."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@なら、この部屋とほかの全部屋の追加セット、マスターテーブル、Bridge Minute、ブリッジの夜の準備、エンドレス練習が使えます。今あるものはずっと無料です。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ontgrendelt de extra sets hier en in elke andere kamer, de meestertafels, Bridge Minute, speelavond-prep en eindeloos oefenen. Alles wat je al hebt blijft gratis."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ปลดล็อกชุดฝึกเพิ่มในห้องนี้และทุกห้อง โต๊ะมาสเตอร์ Bridge Minute การเตรียมคืนบริดจ์ และการฝึกไม่จำกัด ทุกอย่างที่คุณมีอยู่ยังฟรีเหมือนเดิม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ bu odadaki ve diğer tüm odalardaki ek setleri, Usta Masaları'nı, Bridge Minute'u, briç gecesi hazırlığını ve sonsuz alıştırmayı açar. Zaten sahip olduğunuz her şey ücretsiz kalır."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 可解鎖這裡和其他所有房間的加練題組、大師牌桌、Bridge Minute、牌局夜準備和無限練習。你現有的一切仍然免費。"
          }
        }
      }
    },
    "%@%lld": {
      "shouldTranslate": false
    },
    "%@, then %@. Auto-renews until canceled.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, derefter %2$@. Fornyes, indtil du opsiger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, danach %2$@. Verlängert sich bis zur Kündigung."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, μετά %2$@. Ανανεώνεται μέχρι την ακύρωση."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, puis %2$@. Renouvellement automatique jusqu'à résiliation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, poi %2$@. Si rinnova fino alla disdetta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@、その後%2$@。解約するまで自動更新されます。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, daarna %2$@. Verlengt tot je opzegt."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ จากนั้น %2$@ ต่ออายุอัตโนมัติจนกว่าจะยกเลิก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, ardından %2$@. İptal edene kadar yenilenir."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@，之後 %2$@。取消前會自動續訂。"
          }
        }
      }
    },
