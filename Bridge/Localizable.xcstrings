    "Left-hand opponent opens 1♥. A takeout double usually asks partner to do what?": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Venstre modstander åbner 1♥. Hvad beder en oplysningsdobling som regel makker om?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der linke Gegner eröffnet 1♥. Worum bittet ein Informationskontra den Partner meist?"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο αριστερός αντίπαλος ανοίγει 1♥. Τι ζητά συνήθως από τον συμπαίκτη η κόντρα πληροφορίας;"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El rival de tu izquierda abre 1♥. ¿Qué suele pedirle a tu pareja un doblo informativo?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'adversaire de gauche ouvre 1♥. Que demande en général un contre d'appel au partenaire ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'avversario di sinistra apre 1♥. Cosa chiede di solito al compagno un contro informativo?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "左隣の相手が1♥でオープンしました。テイクアウトダブルはふつうパートナーに何を求める？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "왼쪽 상대가 1♥로 오프닝했어요. 테이크아웃 더블은 보통 파트너에게 무엇을 요청할까요?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Motspilleren til venstre åpner 1♥. Hva ber en opplysende dobling vanligvis makker om å gjøre?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De linkertegenstander opent 1♥. Wat vraagt een informatiedoublet meestal van partner?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Соперник слева открыл 1♥. О чём обычно просит партнёра контра на вынос?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vänstermotståndaren öppnar med 1♥. Vad ber en upplysningsdubbling vanligtvis partnern att göra?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คู่แข่งทางซ้ายเปิด 1♥ เทคเอาต์ดับเบิลมักขอให้คู่ทำอะไร"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Soldaki rakip 1♥ açtı. Konuşma kontru genellikle ortaktan ne yapmasını ister?"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "左手對手開叫 1♥。技術性加倍通常要同伴做什麼？"
          }
        }
      }
    },
    "Let's try a real one": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lad os prøve en rigtig hånd"
