    "Following suit comes before every defensive signal.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "At bekende kommer før ethvert modspilssignal."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bedienen geht jedem Gegenspielsignal vor."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η ακολουθία χρώματος προηγείται κάθε αμυντικού σινιάλου."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fournir passe avant tout signal de défense."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rispondere al colore viene prima di ogni segnale difensivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォローはどのディフェンスのシグナルよりも優先です。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekennen gaat voor elk verdedigingssignaal."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การตามชุดมาก่อนสัญญาณป้องกันทุกแบบ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Renge uymak her savunma sinyalinden önce gelir."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "跟牌優先於任何防守信號。"
          }
        }
      }
    },
    "Following suit comes first. You may ruff only when you hold no cards in the suit led.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "At bekende kommer først. Du må kun trumfe, når du ikke har kort i den spillede farve."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bedienen geht vor. Trumpfen darfst du nur, wenn du keine Karte der ausgespielten Farbe hast."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πρώτα ακολουθείτε χρώμα. Κόβετε μόνο όταν δεν έχετε φύλλα στο χρώμα που βγήκε."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fournir passe avant tout. Vous ne pouvez couper que sans carte dans la couleur jouée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rispondere al colore viene prima. Puoi tagliare solo se non hai carte nel seme giocato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まずスートに従います。リードされたスートを持っていないときだけラフできます。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekennen gaat voor. Je mag alleen introeven als je geen kaarten in de gespeelde kleur hebt."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การตามชุดมาก่อน ตัดทรัมป์ได้เฉพาะเมื่อไม่มีไพ่ชุดที่ลีด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önce renge uyulur. Açılan renkten kartınız yoksa koz çakabilirsiniz."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "跟牌優先。只有手上沒有首引花色時才能王吃。"
          }
        }
      }
    },
    "Following suit is mandatory. Winning the trick is not.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "At bekende er pligt. At vinde stikket er ikke."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bedienen ist Pflicht. Den Stich gewinnen nicht."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η ακολουθία χρώματος είναι υποχρεωτική. Η νίκη στη λεβέ όχι."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fournir est obligatoire. Gagner la levée ne l'est pas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rispondere al colore è obbligatorio. Vincere la presa no."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォローは義務です。トリックを取るのは義務ではありません。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekennen is verplicht. De slag winnen niet."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การตามชุดเป็นข้อบังคับ การชนะทริกไม่ใช่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Renge uymak zorunludur. Löveyi kazanmak değil."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "跟牌是義務，贏墩不是。"
          }
        }
      }
    },
