    "Practice at the table with a native iPad layout in portrait or landscape.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Øv ved bordet med et iPad-layout, der er tilpasset både stående og liggende visning."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Übe am Tisch mit einem für das iPad optimierten Layout im Hoch- oder Querformat."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εξασκηθείτε στο τραπέζι με διάταξη φτιαγμένη για iPad, κάθετα ή οριζόντια."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Practica en la mesa con un diseño nativo de iPad en vertical u horizontal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Entraînez-vous à la table avec une interface conçue pour iPad, en portrait ou en paysage."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Allenati al tavolo con l'interfaccia nativa per iPad, in verticale o in orizzontale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPad向けのレイアウトで、縦向きでも横向きでもテーブルで練習できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "세로 또는 가로의 기본 iPad 레이아웃을 사용하여 테이블에서 연습하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Øv ved bordet med en innfødt iPad-layout i stående eller liggende format."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oefen aan tafel met een speciaal voor iPad ontworpen indeling, staand of liggend."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Потренируйтесь за столом, используя стандартную для iPad книжную или альбомную ориентацию."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Öva vid bordet med en inbyggd iPad-layout i stående eller liggande."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ฝึกที่โต๊ะด้วยเลย์เอาต์สำหรับ iPad โดยเฉพาะ ทั้งแนวตั้งและแนวนอน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Masada, iPad'e özel dikey veya yatay düzende çalışın."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在牌桌上用 iPad 原生介面練習，直向或橫向都可以。"
