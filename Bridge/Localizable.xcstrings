    "Stayman asks the 1NT opener whether they hold a four-card major.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Stayman spørger, om 1NT-åbneren har en firkorts højfarve."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stayman fragt den 1NT-Eröffner, ob er eine Viereroberfarbe hält."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Stayman ρωτά αυτόν που άνοιξε 1NT αν έχει τετράφυλλο μείζον."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Stayman pregunta a quien abre 1NT si tiene un palo mayor de cuatro cartas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le Stayman demande à l'ouvreur de 1NT s'il tient une majeure quatrième."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La Stayman chiede a chi ha aperto 1NT se ha un nobile quarto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ステイマンは、1NTでオープンした人に4枚のメジャーがあるかを尋ねます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Stayman은 1NT 오프너에게 메이저 수트가 4장인지 물어요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Stayman spør åpneren av 1NT om hen har en majorfarge med fire kort."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stayman vraagt de 1NT-openaar of hij een vierkaart hoog heeft."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Конвенция Стейман спрашивает у открывшего 1NT, есть ли у него четыре карты в старшей масти."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Stayman frågar om den som öppnat med 1NT har en fyrkortshögfärg."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สเตย์แมนถามผู้เปิด 1NT ว่ามีเมเจอร์สี่ใบหรือไม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Stayman, 1NT açan oyuncuya elinde dörtlü majör olup olmadığını sorar."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "斯台曼詢問 1NT 開叫者是否有四張高花。"
          }
        }
      }
    },
    "Still checking what this Apple Account owns. Try again in a moment, or tap Restore.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi tjekker stadig, hvad denne Apple-konto ejer. Prøv igen om lidt, eller tryk på Gendan."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir prüfen noch, was zu diesem Apple Account gehört. Versuch es gleich noch einmal oder tippe auf Wiederherstellen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ελέγχουμε ακόμη ποιες αγορές συνδέονται με αυτόν τον λογαριασμό Apple. Δοκιμάστε ξανά σε λίγο ή πατήστε Επαναφορά."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún estamos comprobando las compras de esta cuenta de Apple. Inténtalo de nuevo en un momento o toca Restaurar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous vérifions encore ce que possède ce compte Apple. Réessayez dans un instant ou touchez Restaurer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Stiamo ancora verificando cosa possiede questo Account Apple. Riprova tra un attimo o tocca Ripristina."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このApple Accountの購入内容を確認中です。少し待ってからもう一度試すか、「復元」をタップしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Apple 계정의 구매 내역을 확인하고 있어요. 잠시 후 다시 시도하거나 복원을 탭하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi sjekker fortsatt hva denne Apple-kontoen har kjøpt. Prøv igjen om et øyeblikk, eller trykk på Gjenopprett."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "We controleren nog welke aankopen bij dit Apple-account horen. Probeer het zo opnieuw of tik op Herstel."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверка покупок в этой учётной записи Apple ещё не закончена. Попробуйте снова через минуту или нажмите «Восстановить»."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi kontrollerar fortfarande vad det här Apple-kontot har köpt. Försök igen om en stund eller tryck på Återställ."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กำลังตรวจสอบว่าบัญชี Apple นี้มีอะไรบ้าง ลองอีกครั้งในอีกสักครู่ หรือแตะกู้คืน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Apple Hesabına bağlı satın alımları hâlâ kontrol ediyoruz. Biraz sonra tekrar deneyin veya Geri yükle'ye dokunun."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "仍在確認這個 Apple 帳號的購買項目。請稍後再試，或點一下「恢復」。"
          }
        }
      }
    },
    "Still learning what the cards even are": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lærer stadig kortene at kende"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich lerne noch, was die Karten überhaupt sind"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μαθαίνω ακόμη τι είναι τα φύλλα"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía estoy aprendiendo a reconocer las cartas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "J'apprends encore ce que sont les cartes"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sto ancora imparando cosa sono le carte"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カードのことから勉強中"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 카드가 어떤 건지도 배우는 중이에요"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lærer fortsatt kortene å kjenne"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik leer nog wat de kaarten zijn"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ещё учусь разбираться в картах"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Jag håller fortfarande på att lära mig vad korten är"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังเรียนรู้ว่าไพ่คืออะไร"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kartların ne olduğunu hâlâ öğreniyorum"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "還在認識這些牌"
          }
        }
      }
    },
    "Streaks make it stick": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Træning på stribe får det til at hænge ved"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Serien helfen dranzubleiben"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα σερί κάνουν την εξάσκηση συνήθεια"
          }
        },
        "es": {
