    "3NT is game. The other common game levels are 4♥, 4♠, 5♣, and 5♦.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "3NT er udgang. De andre almindelige udgangstrin er 4♥, 4♠, 5♣ og 5♦."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "3NT ist ein Vollspiel. Die anderen üblichen Vollspielstufen sind 4♥, 4♠, 5♣ und 5♦."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το 3NT είναι μανς. Τα άλλα συνηθισμένα συμβόλαια μανς είναι 4♥, 4♠, 5♣ και 5♦."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "3NT es un juego. Los otros niveles comunes del juego son 4♥, 4♠, 5♣ y 5♦."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "3NT est une manche. Les autres contrats de manche courants sont 4♥, 4♠, 5♣ et 5♦."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "3NT è manche. Gli altri livelli di manche comuni sono 4♥, 4♠, 5♣ e 5♦."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "3NTはゲームです。ほかによくあるゲームコントラクトは4♥、4♠、5♣、5♦です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "3NT는 게임입니다. 다른 일반적인 게임 레벨은 4♥, 4♣, 5♣ 및 5︎입니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "3NT er spill. De andre vanlige spillnivåene er 4♥, 4♠, 5♣ og 5♦."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "3NT is een manche. De andere gangbare mancheniveaus zijn 4♥, 4♠, 5♣ en 5♦."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "3NT ,  это игра. Другими распространенными игровыми уровнями являются 4♥, 4♠, 5♣ и 5♦."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "3NT är ett spel. De andra vanliga spelnivåerna är 4♥, 4♠, 5♣ och 5♦."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "3NT เป็นเกม ระดับเกมที่พบบ่อยอื่น ๆ คือ 4♥, 4♠, 5♣ และ 5♦"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "3NT manştır. Diğer yaygın manş seviyeleri 4♥, 4♠, 5♣ ve 5♦'dur."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "3NT 是成局。其他常見的成局階數是 4♥、4♠、5♣ 和 5♦。"
          }
        }
      }
    },
