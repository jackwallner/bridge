    "Knew it? Swipe right · Again? Swipe left": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne du det? Swipe til højre · Igen? Til venstre"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gewusst? Nach rechts · Nochmal? Nach links"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το ξέρατε; Σύρετε δεξιά · Ξανά; Αριστερά"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Su ? Glissez à droite · Encore ? À gauche"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapevi? Scorri a destra · Di nuovo? A sinistra"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "わかった？右にスワイプ · もう一度？左に"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geweten? Veeg naar rechts · Nog eens? Naar links"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รู้แล้ว? ปัดขวา · อีกครั้ง? ปัดซ้าย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildiniz mi? Sağa kaydırın · Tekrar mı? Sola"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "會了？右滑 · 再一次？左滑"
          }
        }
      }
    },
