    "It can crash partner's king": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det kan fælde makkers konge"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es kann den König des Partners fallen lassen"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μπορεί να πέσει πάνω στον ρήγα του συμπαίκτη"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il peut écraser le roi du partenaire"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Può far cadere il re del compagno"
