    "Third hand high": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tredje hånd højt"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dritte Hand hoch"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τρίτο χέρι ψηλά"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Monter en troisième"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Terzo di mano alto"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サードハンド・ハイ"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Derde hand hoog"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ผู้เล่นคนที่สามลงสูง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Üçüncü el büyük"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "三家出大"
          }
        }
      }
    },
    "Third hand high. You are trying to win the trick or force out a high card, since dummy has already passed on it.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tredje hånd højt. Du prøver at vinde stikket eller presse et højt kort ud, fordi bordet allerede har lagt lille."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dritte Hand hoch. Du willst den Stich gewinnen oder eine hohe Karte herausziehen, denn der Dummy hat schon klein gegeben."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τρίτο χέρι ψηλά. Προσπαθείτε να κερδίσετε τη λεβέ ή να βγάλετε ένα μεγάλο φύλλο, αφού ο μορ έχει ήδη ρίξει μικρό."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Monter en troisième. Vous cherchez à gagner la levée ou à faire tomber une carte plus forte du déclarant, puisque le mort a déjà fourni petit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Terzo di mano alto. Cerchi di vincere la presa o di far uscire una carta alta, visto che il morto ha già giocato piccola."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サードハンド・ハイ。ダミーはすでに小さいカードを出したので、トリックを取るか高いカードを引き出すことを狙います。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Derde hand hoog. Je probeert de slag te winnen of een hoge kaart eruit te drijven, want de dummy speelde al klein."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ผู้เล่นคนที่สามลงสูง คุณพยายามชนะทริกหรือบีบไพ่สูงออกมา เพราะดัมมี่ลงใบเล็กไปแล้ว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Üçüncü el büyük. Yer zaten küçük verdiği için löveyi almaya veya büyük bir kartı düşürmeye çalışırsınız."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "三家出大。夢家已經出小牌，你要贏下這墩或逼出大牌。"
          }
        }
      }
    },
    "Thirteen points and no five-card major, but too weak for 1NT. Open your longer minor, 1♦.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tretten point og ingen femkorts højfarve, men for svag til 1NT. Åbn din længste lavfarve, 1♦."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dreizehn Punkte, keine Fünferoberfarbe, aber zu schwach für 1NT. Eröffne die längere Unterfarbe, 1♦."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεκατρείς πόντοι χωρίς πεντάφυλλο μείζον, αλλά πολύ αδύναμο για 1NT. Ανοίξτε το μακρύτερο ελάσσον, 1♦."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Treize points, pas de majeure cinquième, mais trop faible pour 1NT. Ouvrez la plus longue mineure, 1♦."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tredici punti e nessun nobile quinto, ma troppo debole per 1NT. Apri il minore più lungo, 1♦."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "13点で5枚のメジャーはないが、1NTには弱い。長いマイナー1♦でオープンします。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dertien punten en geen vijfkaart hoge kleur, maar te zwak voor 1NT. Open je langste lage kleur, 1♦."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สิบสามแต้ม ไม่มีเมเจอร์ห้าใบ แต่อ่อนเกินไปสำหรับ 1NT เปิดไมเนอร์ที่ยาวกว่า 1♦"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "On üç puan ve beşli majör yok ama 1NT için zayıf. Uzun minörünüzü açın, 1♦."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "13 點、沒有五張高花，但牌力不足以開 1NT。開叫較長的低花 1♦。"
          }
        }
      }
    },
    "Thirteen points with a six-card heart suit. Open the major and tell partner about the length straight away.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tretten point med seks hjerter. Åbn højfarven og fortæl straks makker om længden."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dreizehn Punkte mit Sechser-Coeur. Eröffne die Oberfarbe und zeig dem Partner gleich die Länge."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεκατρείς πόντοι με εξάφυλλες κούπες. Ανοίξτε το μείζον και δείξτε αμέσως το μάκρος στον συμπαίκτη."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Treize points avec six cœurs. Ouvrez la majeure et montrez tout de suite la longueur au partenaire."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tredici punti con sei cuori. Apri il nobile e mostra subito la lunghezza al compagno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ハート6枚で13点。メジャーでオープンし、すぐに長さをパートナーに伝えます。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dertien punten met een zeskaart harten. Open de hoge kleur en vertel partner meteen over de lengte."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สิบสามแต้มกับโพแดงหกใบ เปิดเมเจอร์และบอกคู่เรื่องความยาวทันที"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Altılı kupa ile on üç puan. Majörü açın ve ortağa hemen uzunluğu bildirin."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "13 點、六張紅心。開叫高花，立刻讓同伴知道長度。"
          }
        }
      }
    },
    "This balanced hand has 16 HCP, right in the 15 to 17 range. Open 1NT.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne jævne hånd har 16 HP, midt i intervallet 15 til 17. Åbn 1NT."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese ausgeglichene Hand hat 16 FP, genau im Bereich 15 bis 17. Eröffne 1NT."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτό το ισόρροπο χέρι έχει 16 πόντους, μέσα στο εύρος 15 έως 17. Ανοίξτε 1NT."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette main régulière a 16 H, en plein dans la zone 15 à 17. Ouvrez 1NT."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa mano bilanciata ha 16 punti, in piena fascia 15-17. Apri 1NT."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このバランスハンドは16点で、15〜17点の範囲内です。1NTでオープンします。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze evenwichtige hand heeft 16 punten, precies in de zone van 15 tot 17. Open 1NT."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มือสมดุลนี้มี 16 แต้ม อยู่ในช่วง 15 ถึง 17 พอดี เปิด 1NT"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu dengeli elde 16 puan var, tam 15-17 aralığında. 1NT açın."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這手平均牌 16 點，正好在 15 到 17 點範圍內。開叫 1NT。"
          }
        }
      }
    },
    "This balanced hand has 16 HCP, so open the descriptive 1NT rather than a minor.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne jævne hånd har 16 HP, så åbn den beskrivende 1NT i stedet for en lavfarve."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese ausgeglichene Hand hat 16 FP, also eröffne das beschreibende 1NT statt einer Unterfarbe."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτό το ισόρροπο χέρι έχει 16 πόντους, άρα ανοίξτε το περιγραφικό 1NT αντί για ελάσσον."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette main régulière a 16 H, donc ouvrez le 1NT descriptif plutôt qu'une mineure."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa mano bilanciata ha 16 punti, quindi apri il descrittivo 1NT invece di un minore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このバランスハンドは16点なので、マイナーではなく、手の形を示す1NTでオープンします。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze evenwichtige hand heeft 16 punten, dus open het beschrijvende 1NT in plaats van een lage kleur."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มือสมดุลนี้มี 16 แต้ม จึงเปิด 1NT ที่บอกลักษณะมือแทนการเปิดไมเนอร์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu dengeli elde 16 puan var, o yüzden minör yerine tanımlayıcı 1NT'yi açın."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這手平均牌 16 點，所以開叫描述性的 1NT，而不是低花。"
          }
        }
      }
    },
    "This balanced hand has 16 HCP. The 1NT range takes priority over choosing between the minors.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne jævne hånd har 16 HP. 1NT-intervallet går forud for valget mellem lavfarverne."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese ausgeglichene Hand hat 16 FP. Der 1NT-Bereich hat Vorrang vor der Wahl zwischen den Unterfarben."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτό το ισόρροπο χέρι έχει 16 πόντους. Το εύρος του 1NT προηγείται της επιλογής ανάμεσα στα ελάσσονα."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette main régulière a 16 H. La zone du 1NT passe avant le choix entre les mineures."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa mano bilanciata ha 16 punti. La fascia di 1NT ha la precedenza sulla scelta tra i minori."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このバランスハンドは16点。マイナーの選択より1NTの範囲が優先です。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze evenwichtige hand heeft 16 punten. De 1NT-zone gaat voor de keuze tussen de lage kleuren."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มือสมดุลนี้มี 16 แต้ม ช่วงของ 1NT มาก่อนการเลือกระหว่างไมเนอร์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu dengeli elde 16 puan var. 1NT aralığı minörler arasındaki seçimden önce gelir."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這手平均牌 16 點。1NT 的範圍優先於在低花之間選擇。"
          }
        }
      }
    },
    "This hand has 14 HCP and five spades. Open the five-card major, 1♠.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne hånd har 14 HP og fem spar. Åbn femkorts højfarven, 1♠."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Hand hat 14 FP und fünf Pik. Eröffne die Fünferoberfarbe, 1♠."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτό το χέρι έχει 14 πόντους και πέντε πίκες. Ανοίξτε το πεντάφυλλο μείζον, 1♠."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette main a 14 H et cinq piques. Ouvrez la majeure cinquième, 1♠."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa mano ha 14 punti e cinque picche. Apri il nobile quinto, 1♠."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この手は14点でスペード5枚。5枚のメジャー1♠でオープンします。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze hand heeft 14 punten en vijf schoppen. Open de vijfkaart hoge kleur, 1♠."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มือนี้มี 14 แต้มและโพดำห้าใบ เปิดเมเจอร์ห้าใบ 1♠"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu elde 14 puan ve beş maça var. Beşli majörü açın, 1♠."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這手牌有 14 點和五張黑桃。開叫五張高花 1♠。"
          }
        }
      }
    },
    "This hand has 14 HCP, five clubs, and no five-card major. That is too weak for 1NT, which needs 15 to 17, so open your longer minor, 1♣.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne hånd har 14 HP, fem klør og ingen femkorts højfarve. Det er for svagt til 1NT, som kræver 15 til 17, så åbn din længste lavfarve, 1♣."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Hand hat 14 FP, fünf Treff und keine Fünferoberfarbe. Das ist zu schwach für 1NT, das 15 bis 17 verlangt, also eröffne die längere Unterfarbe, 1♣."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτό το χέρι έχει 14 πόντους, πέντε σπαθιά και κανένα πεντάφυλλο μείζον. Είναι πολύ αδύναμο για 1NT, που θέλει 15 έως 17, οπότε ανοίξτε το μακρύτερο ελάσσον, 1♣."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette main a 14 H, cinq trèfles et pas de majeure cinquième. C'est trop faible pour 1NT, qui demande 15 à 17, donc ouvrez votre plus longue mineure, 1♣."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa mano ha 14 punti, cinque fiori e nessun nobile quinto. È troppo debole per 1NT, che richiede 15-17, quindi apri il minore più lungo, 1♣."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この手は14点でクラブ5枚、5枚のメジャーはありません。15〜17点が必要な1NTには弱すぎるので、長いマイナー1♣でオープンします。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze hand heeft 14 punten, vijf klaveren en geen vijfkaart hoge kleur. Dat is te zwak voor 1NT, dat 15 tot 17 vraagt, dus open je langste lage kleur, 1♣."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มือนี้มี 14 แต้ม ดอกจิกห้าใบ และไม่มีเมเจอร์ห้าใบ อ่อนเกินไปสำหรับ 1NT ที่ต้องมี 15 ถึง 17 จึงเปิดไมเนอร์ที่ยาวกว่า 1♣"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu elde 14 puan, beş sinek var ve beşli majör yok. 15-17 isteyen 1NT için fazla zayıf, bu yüzden uzun minörünüzü açın, 1♣."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這手牌有 14 點、五張梅花，沒有五張高花。對需要 15 到 17 點的 1NT 來說太弱，所以開叫較長的低花 1♣。"
          }
        }
      }
    },
    "This hand has 6 HCP: Q=2, K=3, and J=1. It is below ordinary opening strength and has no preemptive long suit, so pass.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne hånd har 6 HP: Q=2, K=3 og J=1. Den er under almindelig åbningsstyrke og har ingen lang farve til en spærremelding, så pas."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Hand hat 6 FP: Q=2, K=3 und J=1. Sie liegt unter der normalen Eröffnungsstärke und hat keine lange Farbe für ein Sperrgebot, also passe."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτό το χέρι έχει 6 πόντους: Q=2, K=3 και J=1. Είναι κάτω από τη συνηθισμένη δύναμη ανοίγματος και δεν έχει μακρύ χρώμα για φράγμα, οπότε πάσο."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette main a 6 H : Q=2, K=3 et J=1. Elle est sous la force d'ouverture ordinaire et n'a pas de longue couleur pour un barrage, donc passez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa mano ha 6 punti: Q=2, K=3 e J=1. È sotto la normale forza d'apertura e non ha un seme lungo da sbarramento, quindi passa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この手は6点：Q=2、K=3、J=1。通常のオープンの強さに届かず、プリエンプトできる長いスートもないのでパスです。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze hand heeft 6 punten: Q=2, K=3 en J=1. Ze zit onder de gewone openingskracht en heeft geen lange kleur voor een preëmptief bod, dus pas."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มือนี้มี 6 แต้ม: Q=2, K=3 และ J=1 มือยังไม่แข็งพอเปิดตามปกติ ไม่มีชุดยาวสำหรับพรีเอ็มต์ จึงพาส"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu elde 6 puan var: Q=2, K=3 ve J=1. Normal açış gücünün altında ve baraj için uzun bir rengi yok, bu yüzden pas."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這手牌有 6 點：Q=2、K=3、J=1。低於一般開叫牌力，也沒有可以阻塞叫的長套，所以不叫。"
          }
        }
      }
    },
    "This hand has opening strength, five diamonds, and no five-card major. Open the longer minor, 1♦.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne hånd har åbningsstyrke, fem ruder og ingen femkorts højfarve. Åbn den længste lavfarve, 1♦."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Hand hat Eröffnungsstärke, fünf Karo und keine Fünferoberfarbe. Eröffne die längere Unterfarbe, 1♦."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτό το χέρι έχει δύναμη ανοίγματος, πέντε καρά και κανένα πεντάφυλλο μείζον. Ανοίξτε το μακρύτερο ελάσσον, 1♦."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette main a la force d'ouverture, cinq carreaux et pas de majeure cinquième. Ouvrez la plus longue mineure, 1♦."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa mano ha forza d'apertura, cinque quadri e nessun nobile quinto. Apri il minore più lungo, 1♦."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この手はオープンできる強さがあり、ダイヤ5枚で5枚のメジャーはありません。長いマイナー1♦でオープンします。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze hand heeft openingskracht, vijf ruiten en geen vijfkaart hoge kleur. Open de langste lage kleur, 1♦."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มือนี้แข็งพอเปิด มีข้าวหลามตัดห้าใบและไม่มีเมเจอร์ห้าใบ จึงเปิดไมเนอร์ที่ยาวกว่า คือ 1♦"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu elde açış gücü ve beş karo var, beşli majör yok. Uzun minörünüzü açın, 1♦."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這手牌有開叫實力、五張方塊、沒有五張高花。開叫較長的低花 1♦。"
          }
        }
      }
    },
    "This is an interior sequence. The jack is safe, describes the holding to partner, and keeps the king guarding the suit.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det er en indre sekvens. Knægten er sikker, beskriver holdingen for makker og lader kongen beskytte farven."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ist eine innere Sequenz. Der Bube ist sicher, beschreibt dem Partner die Haltung und lässt den König die Farbe schützen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Είναι εσωτερική σεκάνς. Ο βαλές είναι ασφαλής, περιγράφει το χρώμα στον συμπαίκτη και κρατά τον ρήγα να φυλά το χρώμα."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C'est une séquence brisée. Le valet est sûr, décrit la tenue au partenaire et garde le roi pour protéger la couleur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È una sequenza interna. Il fante è sicuro, descrive la tenuta al compagno e lascia il re a guardia del seme."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インテリアシークエンスです。ジャックは安全で、パートナーに持ち札を伝え、キングをスートの守りに残せます。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit is een binnensequentie. De boer is veilig, beschrijft je kleur voor partner en houdt de heer als bewaking."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "นี่คือไพ่เรียงภายใน แจ็คปลอดภัย บอกลักษณะไพ่ให้คู่ และเก็บคิงไว้คุ้มกันชุด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu bir iç sekans. Vale güvenlidir, elinizdeki kartları ortağa gösterir ve papazın rengi korumasını sağlar."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這是內連張。J 很安全，能向同伴描述持牌，也讓 K 留著保護這門花色。"
          }
        }
      }
    },
