    "Book is the first six tricks. Contract levels name the number of tricks required beyond book.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Bogen er de første seks stik. Kontraktens trin angiver, hvor mange stik der kræves ud over bogen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Buch umfasst die ersten sechs Stiche. Die Kontraktstufe gibt an, wie viele Stiche über das Buch hinaus nötig sind."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι πρώτες έξι λεβέ αποτελούν τη βάση. Το επίπεδο του συμβολαίου δείχνει πόσες επιπλέον λεβέ απαιτούνται."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El libro son las seis primeras bazas. El nivel del contrato indica cuántas bazas más debes ganar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les six premières levées constituent la base. Le palier du contrat indique le nombre de levées à réaliser en plus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le prime sei prese sono la base. Il livello del contratto indica quante prese servono in più."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブックとは最初の6トリックのことです。コントラクトのレベルは、ブックを超えて必要なトリック数を表します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "북은 첫 6트릭을 뜻해요. 계약 레벨은 그 뒤에 더 필요한 트릭 수를 나타내요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "De seks første stikkene er grunnstikkene. Kontraktsnivået viser hvor mange ekstra stikk som kreves."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het boek is de eerste zes slagen. Het contractniveau geeft aan hoeveel slagen je boven het boek moet halen."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Первые шесть взяток составляют базу. Уровень контракта показывает, сколько взяток нужно взять сверх них."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "De första sex sticken utgör boken. Kontraktsnivån anger hur många ytterligare stick du behöver ta."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บุ๊กคือหกทริกแรก ระดับสัญญาบอกจำนวนทริกที่ต้องทำเกินบุ๊ก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
