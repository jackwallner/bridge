    "Vulnerability changes which two things most directly?": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvilke to ting ændrer zonen mest direkte?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Welche zwei Dinge sind am unmittelbarsten von der Gefahrenlage betroffen?"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ποια δύο πράγματα αλλάζει πιο άμεσα η ευπάθεια;"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué dos cosas cambia directamente la vulnerabilidad?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelles sont les deux choses que la vulnérabilité modifie le plus directement ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quali due cose cambia più direttamente la zona?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バルネラビリティが直接変える2つのものは何ですか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "취약 여부에 따라 주로 달라지는 두 가지는 무엇일까요?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvilke to ting påvirkes mest direkte av sonen?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Welke twee dingen verandert kwetsbaarheid het meest direct?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На что в первую очередь влияет зона?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vilka två saker påverkas främst av om du är i zonen?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การอยู่ในโซนอันตรายส่งผลโดยตรงต่อสองเรื่องใดมากที่สุด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zon durumu en çok hangi iki şeyi doğrudan değiştirir?"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "身價最直接改變哪兩件事？"
          }
        }
      }
    },
    "Vulnerability increases the game bonus and the penalties for going down.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "I zonen stiger udgangsbonussen og straffen for at gå bet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In Gefahr gibt es eine höhere Vollspielprämie und höhere Strafen für Faller."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η ευπάθεια αυξάνει το μπόνους μανς και τις ποινές όταν πέφτετε."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estar en zona aumenta la bonificación de manga y las penalizaciones por caer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La vulnérabilité augmente la prime de manche et les pénalités de chute."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In zona aumentano il premio di manche e le penalità per andare sotto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バルネラブルではゲームボーナスとダウンしたときのペナルティが大きくなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "취약 상태에서는 게임 보너스가 커지고 다운 페널티도 늘어요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "I sonen øker utgangsbonusen og straffen for å gå bet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kwetsbaarheid verhoogt de manchepremie en de straffen als je down gaat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В зоне увеличивается гейм-бонус и штрафы за недобор."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "I zonen ökar utgångsbonusen och straffen för straffstick."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่ออยู่ในโซนอันตราย โบนัสเกมและค่าปรับเมื่อขาดทริกจะเพิ่มขึ้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zonda manş bonusu ve batma cezaları artar."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有身價時，成局獎分和倒約罰分都會提高。"
          }
        }
      }
    },
