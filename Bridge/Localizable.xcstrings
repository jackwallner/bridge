        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Rett opp feilene mine: spørsmål du bommer på kommer tilbake til du kan dem"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mijn fouten herstellen: missers komen terug tot ze blijven hangen"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разбор ошибок: неверные ответы возвращаются, пока вы не усвоите материал"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Repetera mina misstag: det du missar kommer tillbaka tills det sitter"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แก้ข้อที่พลาด: ข้อที่ผิดจะกลับมาจนกว่าจะจำได้"
