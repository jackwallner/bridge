    "Delay drawing trumps only when you need dummy's trumps for ruffing first.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Udskyd kun trumftrækket, hvis du først skal bruge bordets trumfer til at trumfe."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verzögere das Trumpfziehen nur, wenn du die Trümpfe des Dummys zuerst zum Schnappen brauchst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Καθυστερήστε το μάζεμα των ατού μόνο όταν χρειάζεστε πρώτα τα ατού του μορ για κοψίματα."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Retrasa el arrastre de triunfos solo si primero necesitas los del muerto para fallar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne retardez le tirage des atouts que si vous avez d'abord besoin des atouts du mort pour couper."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ritarda la battuta d'atout solo se prima ti servono gli atout del morto per tagliare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "切り札を抜くのを遅らせるのは、先にダミーの切り札でラフが必要なときだけです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼저 러프해야 해서 더미의 트럼프를 써야 할 때만 트럼프를 늦게 뽑으세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vent med å trekke trumf bare hvis du først trenger blindemanns trumf til stjeling."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stel het troeftrekken alleen uit als je de troeven van de dummy eerst nodig hebt om in te troeven."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откладывайте розыгрыш козырей, только если сначала нужно использовать козыри болвана для убитки."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vänta med att dra trumf bara om du först behöver träkarlens trumf för att stjäla."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลื่อนการดึงทรัมป์เฉพาะเมื่อต้องใช้ทรัมป์ของดัมมี่ตัดก่อน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Koz çekmeyi yalnızca önce yerin kozlarıyla çakmanız gerekiyorsa erteleyin."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只有需要先讓夢家王吃時，才延後清王。"
          }
        }
      }
    },
    "Describe a long suit and consume bidding space": {
      "extractionState": "manual",
      "localizations": {
        "da": {
