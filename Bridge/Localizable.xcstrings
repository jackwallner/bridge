    "Choose your usual bridge night and get a five-minute session built from your mistakes and weakest room when it matters.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg din faste bridgeaften, og få en femminutters runde bygget på dine fejl og dit svageste rum, når det gælder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle deinen üblichen Bridgeabend und bekomme eine Fünf-Minuten-Runde aus deinen Fehlern und deinem schwächsten Raum, genau wenn es zählt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Διαλέξτε τη συνηθισμένη βραδιά μπριτζ και πάρτε μια πεντάλεπτη συνεδρία από τα λάθη σας και την πιο αδύναμη αίθουσα, όταν μετράει."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez votre soirée bridge habituelle et recevez une séance de cinq minutes construite sur vos erreurs et votre salle la plus faible, au bon moment."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli la tua solita serata di bridge e ricevi una sessione di cinque minuti costruita sui tuoi errori e sulla sala più debole, quando serve."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いつものブリッジの夜を選ぶと、ミスと最も苦手な部屋から作った5分のセッションが、ちょうどよいときに届きます。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies je vaste bridgeavond en krijg een sessie van vijf minuten op basis van je fouten en je zwakste kamer, precies wanneer het telt."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกคืนเล่นบริดจ์ประจำของคุณ แล้วรับเซสชันห้านาทีจากข้อที่พลาดและห้องที่อ่อนที่สุดในเวลาที่ใช่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her zamanki briç gecenizi seçin, hatalarınızdan ve en zayıf odanızdan oluşan beş dakikalık oturumu tam zamanında alın."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選好你固定的橋牌之夜，在需要的時候收到根據錯題和最弱房間組成的五分鐘練習。"
          }
        }
      }
    },
