    "Protect the outside ace. Without an entry the established clubs are unreachable and the whole plan collapses.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Bevar esset i sidefarven. Uden en indgang kan de godspillede klør ikke nås, og hele planen falder sammen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schütze das Ass in der Nebenfarbe. Ohne Übergang sind die entwickelten Treffstiche unerreichbar und der ganze Spielplan bricht zusammen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Προστατέψτε τον άσο σε πλευρικό χρώμα. Χωρίς είσοδο, δεν μπορείτε να εισπράξετε τα σπαθιά που έχετε αναπτύξει και καταρρέει όλο το σχέδιο."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Protege el as lateral. Sin una entrada no podrás llegar a los tréboles afirmados y todo el plan se vendrá abajo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Protégez l'as extérieur. Sans reprise, les trèfles affranchis sont inaccessibles et tout le plan s'effondre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Proteggi l'asso esterno. Senza un rientro le fiori affrancate sono irraggiungibili e tutto il piano crolla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別スートのエースを守ります。エントリーがないと、確立したクラブの勝ち札を取れず、計画全体が崩れます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 수트의 에이스를 지켜 주세요. 엔트리가 없으면 굳힌 클럽에 들어갈 수 없어 계획 전체가 무너져요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta vare på esset i sidefargen. Uten et inntak får du ikke spilt de godspilte kløverne, og hele planen faller sammen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bescherm de aas in de bijkleur. Zonder entree zijn de vrijgespeelde klaveren onbereikbaar en valt het hele plan in duigen."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохраните туза в боковой масти. Без перехода вы не доберётесь до разработанных треф, и весь план сорвётся."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skydda esset i sidofärgen. Utan en ingång kommer du inte åt de godspelade klöverna, och hela planen faller."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เก็บเอซในชุดข้างไว้ ถ้าไม่มีไพ่เข้ามือก็ใช้ชุดดอกจิกที่ตั้งไพ่ชนะไว้แล้วไม่ได้ แผนทั้งหมดจะพัง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yan renkteki ası koruyun. Antre olmadan sağladığınız trefl renginden löve alamazsınız ve bütün plan çöker."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "保住旁門的 A。沒有進手，就無法兌現已建立的梅花贏墩，整個計畫就會失敗。"
          }
        }
      }
    },
