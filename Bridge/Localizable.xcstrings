    "Accuracy for every room, your weakest area, and how much you have practiced overall.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Træfsikkerhed for hvert rum, dit svageste område og hvor meget du har øvet i alt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Trefferquote für jeden Raum, dein schwächster Bereich und wie viel du insgesamt geübt hast."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ακρίβεια για κάθε αίθουσα, το πιο αδύναμο σημείο σας και πόση εξάσκηση κάνατε συνολικά."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Precisión para cada habitación, tu área más débil y cuánto has practicado en general."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La précision pour chaque salle, votre point faible et votre volume d'entraînement total."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Precisione per ogni sala, l'area più debole e quanto ti sei allenato in tutto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "部屋ごとの正答率、最も苦手な分野、これまでの練習量。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 공간, 가장 취약한 부분, 전반적으로 얼마나 연습했는지에 대한 정확성."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Nøyaktighet for hvert rom, ditt svakeste område og hvor mye du har trent totalt sett."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nauwkeurigheid per kamer, je zwakste onderdeel en hoeveel je in totaal hebt geoefend."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Точность для каждой комнаты, вашей самой слабой зоны и общего количества тренировок."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Noggrannhet för varje rum, ditt svagaste område och hur mycket du har tränat totalt."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ความแม่นยำของแต่ละห้อง จุดที่อ่อนที่สุด และปริมาณการฝึกทั้งหมด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her odadaki doğruluk oranınız, en zayıf alanınız ve toplam çalışma miktarınız."
