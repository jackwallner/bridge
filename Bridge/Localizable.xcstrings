    "When is second hand high right rather than second hand low?": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvornår skal anden hånd spille højt i stedet for lavt?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wann ist zweite Hand hoch richtig statt zweite Hand tief?"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πότε είναι σωστό να παίξετε ψηλά στο δεύτερο χέρι αντί να παίξετε χαμηλά;"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Cuándo el segundero está alto a la derecha en lugar de segundo bajo?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand faut-il jouer gros en second plutôt que petit en second ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando conviene giocare alto da secondo di mano invece che basso?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セカンドハンド・ローではなく、ハイで出すべきなのはいつ？"
