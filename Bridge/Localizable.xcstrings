    "%lld high-card points, %@, no five-card major and outside the 15 to 17 notrump range.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld honnørpoint, %2$@, ingen femkorts højfarve og uden for sans-intervallet på 15 til 17."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld Figurenpunkte, %2$@, keine Fünferoberfarbe und außerhalb des 1NT-Bereichs von 15 bis 17."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld πόντοι τιμής, %2$@, χωρίς πεντάφυλλο μείζον και εκτός του εύρους 15 έως 17 για χωρίς ατού."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld puntos de cartas altas, %2$@, sin mayor de cinco cartas y fuera del rango de 15 a 17 sin triunfo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld points H, %2$@, pas de majeure cinquième et hors de la zone 15 à 17 du sans-atout."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld punti onori, %2$@, senza un nobile quinto e fuori dalla fascia da 15 a 17 punti per l'apertura di 1NT."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ハイカードポイント%1$lld点、%2$@、5枚のメジャーなし、ノートランプの15〜17点の範囲外。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld 하이 카드 포인트, %2$@, 5개의 카드 메이저가 없고 15~17의 트럼프 범위를 벗어났습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld høykortpoeng, %2$@, ingen femkorts major og utenfor 15 til 17 ingen trumfområde."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld honneurpunten, %2$@, geen vijfkaart hoge kleur en buiten het sans-atoutbereik van 15 tot 17."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld с очками старших карт, %2$@, без пятикарточной мажорной карты и за пределами диапазона от 15 до 17, без козырей."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld högkortspoäng, %2$@, ingen femkorts major och utanför 15 till 17 inget trumfintervall."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แต้มไพ่สูง %1$lld แต้ม %2$@ ไม่มีเมเจอร์ห้าใบ และอยู่นอกช่วง 15 ถึง 17 แต้มสำหรับเปิด 1NT"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld onör puanı, %2$@, beşli majör yok ve 15-17 sanzatu aralığının dışında."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld 個大牌點，%2$@，沒有五張高花，也不在 15 到 17 的無王範圍內。"
          }
        }
      }
    },
