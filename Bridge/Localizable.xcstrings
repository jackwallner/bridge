            "value": "Du har to hjerter, og der spilles hjerter. Hvad skal du gøre?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast zwei Coeur und Coeur wird ausgespielt. Was musst du tun?"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Έχετε δύο κούπες και βγαίνει κούπα. Τι πρέπει να κάνετε;"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez deux cœurs et l'entame est à cœur. Que devez-vous faire ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai due cuori e viene giocato cuori. Cosa devi fare?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
