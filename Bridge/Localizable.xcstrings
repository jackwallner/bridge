        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "低く出すとダミーのシングルトンやダブルトンのオナーが勝ってしまうとき"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als laag spelen een singleton- of doubletonhonneur in de dummy laat winnen"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อการลงต่ำจะทำให้ออนเนอร์ซิงเกิลตันหรือดับเบิลตันของดัมมี่ชนะ"
