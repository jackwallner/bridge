          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Når er second hand høy høyre i stedet for second hand lav?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wanneer speel je als tweede hand hoog in plaats van laag?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда секундная стрелка правая, а не низкая?"
