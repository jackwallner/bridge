          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πότε το δεύτερο χέρι ψηλά είναι σωστό αντί για δεύτερο χέρι χαμηλά;"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand deuxième fort vaut-il mieux que deuxième petit ?"
