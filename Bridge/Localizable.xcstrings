    },
    "Compare only cards in the suit led when there is no trump.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Uden trumf sammenligner du kun kort i den spillede farve."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne Trumpf vergleichst du nur Karten der ausgespielten Farbe."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χωρίς ατού συγκρίνετε μόνο φύλλα του χρώματος που βγήκε."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sans atout, ne comparez que les cartes de la couleur jouée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Senza atout confronta solo le carte del seme giocato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "切り札がないときは、リードされたスートのカードだけを比べます。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zonder troef vergelijk je alleen kaarten in de gespeelde kleur."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อไม่มีทรัมป์ ให้เทียบเฉพาะไพ่ในชุดที่ลีด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Koz yokken yalnızca açılan rengin kartlarını karşılaştırın."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有王牌時，只比首引花色的牌。"
          }
        }
      }
    },
