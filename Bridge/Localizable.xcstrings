            "value": "7 günlük seri"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連續 7 天"
          }
        }
      }
    },
    "A balanced 15 to 17 HCP hand usually opens 1NT.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En jævn hånd med 15 til 17 HP åbner som regel 1NT."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine ausgeglichene Hand mit 15 bis 17 FP eröffnet meist 1NT."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ένα ισοκατανεμημένο χέρι 15 έως 17 πόντων συνήθως ανοίγει 1NT."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una mano equilibrada de 15 a 17 PH normalmente abre 1NT."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une main régulière de 15 à 17 H ouvre en général 1NT."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una mano bilanciata da 15-17 punti di solito apre 1NT."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "15〜17点のバランス型の手は、ふつう1NTでオープンします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "밸런스드 15~17 HCP 핸드는 일반적으로 1NT를 엽니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En balansert 15 til 17 HCP-hånd åpner vanligvis 1NT."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een evenwichtige hand met 15 tot 17 honneurpunten opent meestal 1NT."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сбалансированная рука с 15-17 HCP обычно открывает 1NT."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En balanserad 15 till 17 HCP-hand öppnar vanligtvis 1NT."
