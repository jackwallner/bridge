    "Prices aren't available right now. Check your connection and try again.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Priserne er ikke tilgængelige lige nu. Tjek din forbindelse, og prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Preise sind gerade nicht verfügbar. Prüfe deine Verbindung und versuche es erneut."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι τιμές δεν είναι διαθέσιμες τώρα. Ελέγξτε τη σύνδεσή σας και δοκιμάστε ξανά."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los precios no están disponibles ahora. Comprueba tu conexión e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les prix sont indisponibles pour le moment. Vérifiez votre connexion et réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I prezzi non sono disponibili ora. Controlla la connessione e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在、価格を取得できません。接続を確認してもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금은 가격을 확인할 수 없어요. 연결을 확인하고 다시 시도하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Prisene er ikke tilgjengelige akkurat nå. Sjekk tilkoblingen og prøv igjen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prijzen zijn nu niet beschikbaar. Controleer je verbinding en probeer het opnieuw."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сейчас цены недоступны. Проверьте подключение и попробуйте снова."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Priserna är inte tillgängliga just nu. Kontrollera anslutningen och försök igen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตอนนี้ยังโหลดราคาไม่ได้ ตรวจสอบการเชื่อมต่อแล้วลองใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fiyatlar şu an kullanılamıyor. Bağlantınızı kontrol edip tekrar deneyin."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前無法取得價格。請檢查網路連線後再試一次。"
          }
        }
      }
