    "The trick winner leads the next trick.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vinderen af stikket spiller ud til det næste."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Stichgewinner spielt zum nächsten Stich aus."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όποιος κερδίσει τη λεβέ βγάζει στην επόμενη."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El ganador de la baza lidera la siguiente baza."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le gagnant de la levée joue en premier à la suivante."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chi vince la presa gioca per primo la successiva."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トリックを取った人が次をリードします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "트릭 승자가 다음 트릭을 주도합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Triksvinneren leder neste stikk."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie de slag wint, komt uit voor de volgende."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Победитель взятки ведет следующую взятку."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Trickvinnaren leder nästa stick."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ผู้ชนะทริกจะเป็นคนลีดทริกถัดไป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Löveyi kazanan sonrakini açar."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "贏得這墩的人先出下一墩的牌。"
          }
        }
      }
    },
