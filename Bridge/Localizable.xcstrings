    "Vulnerability changes which two things most directly?": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvilke to ting ændrer zonen mest direkte?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Welche zwei Dinge sind am unmittelbarsten von der Gefahrenlage betroffen?"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ποια δύο πράγματα αλλάζει πιο άμεσα η ευπάθεια;"
          }
        },
        "es": {
          "stringUnit": {
