    "Keep going. Sharp means nearly everything here is holding.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fortsæt. Skarp betyder, at du har styr på næsten alt her."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Weiter so. Bei „Sicher“ sitzt hier fast alles."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Συνεχίστε. Το «Σε φόρμα» σημαίνει ότι σχεδόν όλα όσα μαθαίνετε εδώ έχουν εμπεδωθεί."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigue practicando. “Afinado” significa que ya dominas casi todo esto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuez. Le niveau « Solide » signifie que vous maîtrisez presque tout."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Continua così. «Solido» significa che hai quasi tutto sotto controllo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その調子です。「好調」は、この部屋の内容をほぼ身につけている状態です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계속 풀어 보세요. 능숙 단계는 이 영역의 거의 모든 문제를 계속 맞히는 상태예요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fortsett. Nesten alt sitter nå."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ga zo door. Scherp betekent dat bijna alles hier blijft hangen."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Продолжайте. Высокий показатель означает, что почти весь материал уже закреплён."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fortsätt. Vass betyder att nästan alla frågor här sitter."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไปต่อ! ระดับคล่องหมายถึงคุณจำเนื้อหาเกือบทุกข้อในห้องนี้ได้แล้ว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Devam edin. Keskin, buradakilerin neredeyse tamamının oturduğu anlamına gelir."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "繼續加油。「熟練」表示這裡幾乎都記牢了。"
          }
        }
      }
    },
