    "Second hand low protects honors that sit in front of dummy.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Anden hånd lavt beskytter honnører, der sidder foran bordet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zweite Hand tief schützt Honneurs, die vor dem Dummy sitzen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το δεύτερο χέρι χαμηλά προστατεύει τα ονέρ που βρίσκονται μπροστά από τον μορ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Jugar bajo en segunda posición protege los honores situados delante del muerto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le petit en second protège les honneurs placés devant le mort."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Giocare basso da secondo di mano protegge gli onori che stanno davanti al morto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セカンドハンド・ローは、ダミーの前にあるオナーを守ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "2번째 손에서 낮게 내면 더미 앞에 있는 고카드를 보호할 수 있어요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Å spille lavt som andrehånd beskytter honnørkortene foran blindemann."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tweede hand laag beschermt honneurs die voor de dummy zitten."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Игра младшей картой второй рукой защищает фигуры, расположенные перед болваном."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lågt på andra hand skyddar honnörer som sitter framför träkarlen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ผู้เล่นคนที่สองลงต่ำช่วยปกป้องออนเนอร์ที่อยู่หน้าดัมมี่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İkinci el küçük oynar, böylece yerin önündeki onörleri korur."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "二家出小，保護位在夢家前面的大牌。"
          }
        }
      }
    },
