    "At that time each %@, the notification opens directly into your personalized practice session.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hver %@ får du på det tidspunkt en notifikation, der åbner din personlige træningsrunde direkte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Mitteilung führt dich jeden %@ zu dieser Zeit direkt in deine persönliche Übungsrunde."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κάθε %@, την ώρα που έχετε ορίσει, η ειδοποίηση σάς μεταφέρει απευθείας στην εξατομικευμένη συνεδρία εξάσκησής σας."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En ese momento cada %@, la notificación se abre directamente en su sesión de práctica personalizada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque %@, à l'heure choisie, la notification vous mène directement à votre séance personnalisée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "A quell'ora, ogni %@, la notifica ti porta direttamente alla tua sessione di allenamento personalizzata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "毎週%@のその時刻に、通知からあなた専用の練習セッションを直接開きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그 때마다 %@마다 알림이 개인화된 연습 세션으로 직접 열립니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "På det tidspunktet hver %@ åpnes varselet direkte inn i din personlige treningsøkt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Op dat tijdstip brengt de melding je elke %@ meteen naar je persoonlijke oefensessie."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В это время каждый %@ уведомление открывается непосредственно в вашем индивидуальном сеансе тренировки."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vid den tiden varje %@ öppnas meddelandet direkt i din personliga träningssession."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ในแต่ละ %@ เมื่อถึงเวลานั้น การแจ้งเตือนจะพาคุณเข้าสู่เซสชันฝึกที่ปรับให้เหมาะกับคุณทันที"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her %@ o saatte bildirim doğrudan kişisel alıştırma oturumunuzu açar."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每到 %@ 的這個時間，通知會直接開啟你的個人化練習。"
          }
        }
      }
    },
    "At the same level, bids rank clubs, diamonds, hearts, spades, then notrump.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "På samme trin er rækkefølgen klør, ruder, hjerter, spar og så sans."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf derselben Stufe gilt: Treff, Karo, Coeur, Pik, dann Sans Atout."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Στο ίδιο επίπεδο η σειρά είναι σπαθιά, καρά, κούπες, πίκες και μετά χωρίς ατού."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En el mismo nivel, las ofertas clasifican tréboles, diamantes, corazones, picas y luego ningún triunfo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À palier égal, l'ordre est trèfle, carreau, cœur, pique, puis sans-atout."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Allo stesso livello l'ordine è fiori, quadri, cuori, picche, poi senza atout."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じレベルではクラブ、ダイヤ、ハート、スペード、ノートランプの順に高くなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "동일한 수준에서 입찰은 클럽, 다이아몬드, 하트, 스페이드 순위를 매기고 트럼프는 없습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "På samme nivå rangerer bud kløver, ruter, hjerter, spar, deretter ingen trumf."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Op hetzelfde niveau is de volgorde klaveren, ruiten, harten, schoppen en dan sans atout."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На одном уровне ставки ранжируются трефами, бубнами, червами, пиками и отсутствием козыря."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "På samma nivå rankas bud klöver, ruter, hjärter, spader, sedan ingen trumf."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ในระดับเดียวกัน ลำดับคือดอกจิก ข้าวหลามตัด โพแดง โพดำ แล้วจึงเป็นโนทรัมป์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aynı seviyede sıra sinek, karo, kupa, maça ve ardından sanzatudur."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "同一階中，由小到大是梅花、方塊、紅心、黑桃，再來是無王。"
          }
        }
      }
    },
