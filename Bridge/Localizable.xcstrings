    "%@ one-time. Not a subscription, nothing renews.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ én gang. Intet abonnement, intet fornyes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ einmalig. Kein Abo, nichts verlängert sich."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ εφάπαξ. Χωρίς συνδρομή, τίποτα δεν ανανεώνεται."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ en une fois. Pas d'abonnement, rien ne se renouvelle."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ una tantum. Nessun abbonamento, niente rinnovi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@の買い切り。サブスクリプションではなく、更新されません。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ eenmalig. Geen abonnement, geen automatische verlenging."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ครั้งเดียว ไม่ใช่การสมัครสมาชิก ไม่มีการต่ออายุ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tek seferlik. Abonelik yok, yenilenmez."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 一次付清。不是訂閱，不會續訂。"
          }
        }
      }
    },
