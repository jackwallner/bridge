    },
    "This hand has 14 HCP and five hearts, below the 15 to 17 notrump range. Open the five-card major, 1♥.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne hånd har 14 HP og fem hjerter, under sans-intervallet på 15 til 17. Åbn femkorts højfarven, 1♥."
