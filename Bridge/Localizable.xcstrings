    "%@ Which card do you play?": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Hvilket kort spiller du?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Welche Karte spielst du?"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Ποιο φύλλο παίζετε;"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Quelle carte jouez-vous ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Quale carta giochi?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@どのカードを出しますか？"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Welke kaart speel je?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ คุณจะเล่นไพ่ใบไหน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Hangi kartı oynarsınız?"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@你要出哪張牌？"
          }
        }
      }
    },
