        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пять персонализированных минут теперь могут сделать стол более спокойным позже."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fem personliga minuter nu kan få bordet att kännas lugnare senare."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ฝึกห้านาทีที่ปรับให้เหมาะกับคุณตอนนี้ แล้วคุณจะเล่นที่โต๊ะได้สบายใจขึ้น"
          }
        },
        "tr": {
          "stringUnit": {
