    "A heart is led and you hold a heart. What must you do?": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der spilles hjerter, og du har hjerter. Hvad skal du gøre?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Coeur wird ausgespielt und du hältst eine Coeur-Karte. Was musst du tun?"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Βγαίνει κούπα και έχετε κούπα. Τι πρέπει να κάνετε;"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Salen de corazones y tienes una carta de ese palo. ¿Qué debes hacer?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "On entame à cœur et vous avez un cœur. Que devez-vous faire ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'attacco è a cuori e hai una carta di cuori. Cosa devi fare?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ハートがリードされ、あなたはハートを持っています。どうする？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하트가 리드됐고 나도 하트를 갖고 있어요. 어떻게 해야 할까요?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det spilles ut hjerter, og du har hjerter. Hva må du gjøre?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er wordt met harten uitgekomen en je hebt harten. Wat moet je doen?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вышли червой, у вас есть червы. Что вы обязаны сделать?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
