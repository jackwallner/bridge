          "stringUnit": {
            "state": "translated",
            "value": "Repetera de %1$lld felaktiga svaren först, fortsätt sedan med extra övning i %2$@."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เริ่มจากข้อที่พลาด %1$lld ข้อ แล้วฝึกเพิ่ม: %2$@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önce tekrar sırası gelen %1$lld hatayı gözden geçirin, ardından %2$@ odasında ek alıştırma yapın."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "先複習 %1$lld 道錯題，再加練：%2$@。"
          }
        }
      }
    },
