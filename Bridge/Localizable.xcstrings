        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il compagno attacca piccola"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パートナーが小さいカードをリード"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파트너가 낮은 카드를 리드해요"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Makker spiller ut lavt"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Partner komt klein uit"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Партнёр вышел младшей картой"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Partnern spelar ut lågt"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คู่ลีดใบเล็ก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ortak küçükle atak yaptı"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "同伴首攻小牌"
          }
        }
      }
    },
    "Partner leads the ace and you hold Q-8-4. Playing standard signals, which card encourages a continuation?": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Makker spiller esset ud, og du har Q-8-4. I spiller standardsignaler. Hvilket kort opfordrer til fortsættelse?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Partner spielt das Ass aus und du hältst Q-8-4. Welche Karte ermutigt bei Standardsignalen zum Weiterspielen?"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο συμπαίκτης βγάζει τον άσο και έχετε Q-8-4. Με κλασικά σινιάλα, ποιο φύλλο ενθαρρύνει τη συνέχεια;"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu pareja sale del as y tienes Q-8-4. Según las señales habituales, ¿qué carta anima a continuar?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le partenaire entame l'as et vous tenez Q-8-4. En signalisation standard, quelle carte encourage la continuation ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il compagno attacca con l'asso e tu hai Q-8-4. Con segnali standard, quale carta incoraggia a continuare?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パートナーがエースをリードし、あなたはQ-8-4。標準のシグナルで続行を促すカードは？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파트너가 에이스를 리드했고 나는 Q-8-4를 들고 있어요. 표준 신호에서 계속 리드해 달라는 뜻을 나타내려면 어떤 카드를 낼까요?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Makker spiller ut esset, og du har Q-8-4. Hvilket kort viser at du vil ha fortsettelse etter standardsignalene?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Partner komt uit met de aas en jij hebt Q-8-4. Welke kaart geef je volgens de standaardafspraken als aanmoedigingssignaal?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Партнёр вышел тузом, у вас Q-8-4. Какой картой по стандартным сигналам показать, что вы хотите продолжения?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Partnern spelar ut esset och du har Q-8-4. Vilket kort visar enligt standardmarkeringar att du vill att partnern fortsätter?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คู่ลีดเอซและคุณถือ Q-8-4 ตามสัญญาณมาตรฐาน ไพ่ใบไหนเชิญให้เล่นต่อ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ortağınız as çıktı ve elinizde Q-8-4 var. Standart sinyallere göre devamı teşvik etmek için hangi kartı oynarsınız?"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "同伴首攻 A，你持有 Q-8-4。按照標準信號，哪張牌鼓勵續攻？"
          }
        }
      }
    },
    "Partner overcalled hearts during the auction. What is a reasonable opening lead?": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Makker har meldt hjerter ind. Hvad er et fornuftigt udspil?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Partner hat in der Reizung mit Coeur gegengereizt. Was ist ein vernünftiges Ausspiel?"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο συμπαίκτης έκανε παρεμβολή με κούπες στην αγορά. Ποια θα ήταν μια λογική αντάμ;"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu pareja intervino con corazones. ¿Qué salida inicial tiene sentido?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le partenaire est intervenu à cœur. Quelle entame est raisonnable ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il compagno è intervenuto a cuori. Qual è un attacco ragionevole?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パートナーがオークションでハートをオーバーコールしました。妥当なオープニングリードは？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파트너가 경매에서 하트로 오버콜했어요. 어떤 오프닝 리드가 합리적일까요?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Makker meldte inn hjerter under meldingsforløpet. Hva er et fornuftig utspill?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Partner deed een volgbod in harten. Wat is een redelijke uitkomst?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Партнёр вмешался в торговлю заявкой червой. Какой первый выход будет разумным?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Partnern har gjort inkliv i hjärter. Vilket öppningsutspel är rimligt?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คู่โอเวอร์คอลโพแดงระหว่างการประมูล การลีดเปิดที่สมเหตุสมผลคืออะไร"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ortak ihalede körle araya girdi. Makul bir ilk atak nedir?"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "同伴在叫牌時以紅心蓋叫。合理的首攻是？"
          }
        }
      }
    },
    "Partner told you where their strength is. Leading their suit is usually the friendliest start, unless you have a strong reason of your own.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Makker har fortalt dig, hvor styrken sidder. At spille makkers farve ud er som regel det bedste, medmindre du selv har en god grund til at vælge noget andet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Partner hat dir gesagt, wo seine Stärke liegt. Seine Farbe auszuspielen ist meist die beste Wahl, außer du hast selbst einen guten Grund dagegen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο συμπαίκτης σας έδειξε πού βρίσκεται η δύναμή του. Συνήθως, η αντάμ στο χρώμα του είναι η καλύτερη επιλογή, εκτός αν έχετε σοβαρό λόγο να κάνετε κάτι άλλο."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu pareja te ha mostrado dónde tiene fuerza. Salir de ese palo suele ser la mejor ayuda, salvo que tengas un motivo claro para elegir otro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le partenaire vous a indiqué où se trouve sa force. Entamer sa couleur est généralement le choix le plus naturel, sauf bonne raison de faire autrement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il compagno ti ha indicato dove è forte. Attaccare nel suo seme è di solito la scelta più naturale, salvo un buon motivo per fare diversamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パートナーが強さを示したスートをリードするのが、通常はいちばん無難です。ただし、自分なりの明確な理由があれば別です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파트너가 강한 수트를 알려 줬어요. 특별한 이유가 없다면 그 수트를 리드하는 게 보통 가장 좋은 출발이에요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Makker har vist hvor styrken ligger. Som regel er det best å spille ut i makkers farge, med mindre du har en god grunn til å velge noe annet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Partner heeft laten zien in welke kleur zijn kracht zit. Meestal is uitkomen in die kleur de beste keuze, tenzij je zelf een sterke reden hebt om iets anders te doen."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Партнёр показал, в какой масти у него сила. Обычно лучше начать с его масти, если только у вас нет веской причины для другого выхода."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Partnern har visat var styrkan finns. Att spela ut den färgen är oftast ett bra val, om du inte har ett starkt eget skäl att välja något annat."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คู่บอกแล้วว่ามีไพ่แข็งในชุดไหน การลีดชุดของคู่มักเป็นการเริ่มที่ดีที่สุด เว้นแต่คุณมีเหตุผลหนักแน่นของตัวเอง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ortağınız gücünün hangi renkte olduğunu gösterdi. Güçlü bir gerekçeniz yoksa genellikle ortağınızın renginden atak yapmak en mantıklısıdır."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "同伴在叫牌中已表明牌力所在。除非你有充分理由，否則首攻同伴的花色通常最合適。"
          }
        }
      }
    },
    "Partners sit opposite each other. A 52-card deck is dealt evenly, giving every player 13 cards. North-South compete against East-West.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Makkere sidder over for hinanden. 52 kort deles ligeligt, 13 til hver. Nord-Syd spiller mod Øst-Vest."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Partner sitzen sich gegenüber. 52 Karten werden gleichmäßig verteilt, jeder bekommt 13. Nord-Süd spielt gegen Ost-West."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι συμπαίκτες κάθονται αντικριστά. Η τράπουλα των 52 φύλλων μοιράζεται εξίσου, 13 φύλλα στον καθένα. Το ζευγάρι Βορράς-Νότος παίζει εναντίον του ζευγαριού Ανατολή-Δύση."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las parejas se sientan frente a frente. Se reparten las 52 cartas por igual y cada jugador recibe 13. Norte-Sur juega contra Este-Oeste."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les partenaires sont assis face à face. Les 52 cartes sont distribuées équitablement, 13 pour chacun. Nord-Sud affronte Est-Ouest."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I compagni siedono uno di fronte all'altro. Il mazzo da 52 carte viene distribuito in parti uguali, 13 carte a testa. Nord-Sud giocano contro Est-Ovest."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パートナー同士は向かい合って座ります。52枚を均等に配り、1人13枚です。南北と東西が対戦します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파트너들은 서로 마주 보고 앉아요. 카드 52장을 똑같이 나누면 각 플레이어가 13장씩 받아요. 남북 팀이 동서 팀과 경쟁해요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Makkere sitter overfor hverandre. En kortstokk med 52 kort deles likt, så hver spiller får 13. Nord-Sør spiller mot Øst-Vest."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Partners zitten tegenover elkaar. 52 kaarten worden gelijk verdeeld, 13 per speler. Noord-Zuid speelt tegen Oost-West."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Партнёры сидят друг напротив друга. Колоду из 52 карт делят поровну, по 13 каждому. Пара Север-Юг играет против пары Восток-Запад."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Partnerna sitter mitt emot varandra. En kortlek med 52 kort delas jämnt, så att varje spelare får 13 kort. Nord–syd spelar mot öst–väst."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ผู้เล่นที่เป็นคู่กันนั่งตรงข้ามกัน ไพ่ 52 ใบแจกเท่า ๆ กัน คนละ 13 ใบ คู่เหนือ-ใต้แข่งกับคู่ตะวันออก-ตะวันตก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ortaklar karşılıklı oturur. 52 kartlık deste eşit dağıtılır, herkese 13 kart düşer. Kuzey-Güney, Doğu-Batı'ya karşı oynar."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "搭檔面對面而坐。52 張牌平均發給四人，每人 13 張。南北家對抗東西家。"
          }
        }
      }
    },
