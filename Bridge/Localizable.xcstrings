          "stringUnit": {
            "state": "translated",
            "value": "มือสมดุลที่มีแต้มไพ่สูง 15 ถึง 17 แต้มมักเปิด 1NT"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
