        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณมีโพแดงสองใบและมีการลีดโพแดง ต้องทำอย่างไร"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İki kupanız var ve kupa açıldı. Ne yapmalısınız?"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你有兩張紅心，對手首引紅心。你必須怎麼做？"
          }
        }
      }
    },
    "You lead low toward A-Q of hearts. Left-hand opponent follows low. Which card executes the finesse?": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du spiller lille mod A-Q i hjerter. Venstre modstander lægger lille. Hvilket kort tager masken?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du spielst klein zu A-Q in Coeur. Der linke Gegner gibt klein. Mit welcher Karte schneidest du?"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Παίζετε μικρό προς τα A-Q κούπα. Ο αριστερός αντίπαλος ρίχνει μικρό. Ποιο φύλλο εκτελεί το εμπάς;"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous jouez petit vers A-Q de cœur. L'adversaire de gauche fournit petit. Quelle carte faut-il jouer pour tenter l'impasse ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Giochi piccola verso A-Q di cuori. L'avversario di sinistra gioca piccola. Quale carta esegue l'impasse?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ハートのA-Qに向けて低いカードをリードすると、左の相手も低いカードを出しました。フィネスをかけるにはどのカードを出しますか？"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je speelt klein naar A-Q in harten. De linkertegenstander speelt klein. Met welke kaart snijd je?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณลีดใบเล็กไปหา A-Q โพแดง คู่แข่งทางซ้ายลงใบเล็ก ไพ่ใบไหนทำไฟเนส"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kupada A-Q'ya doğru küçük oynuyorsunuz. Soldaki rakip küçük verdi. Empası hangi kart yapar?"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你朝紅心 A-Q 出小牌，左手對手跟小牌。哪張牌執行飛牌？"
          }
        }
      }
    },
