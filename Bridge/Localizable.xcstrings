        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κατά συμβολαίου με ατού έχετε A-K-4"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Contre un contrat à la couleur, vous tenez A-K-4"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Contro un contratto a colore hai A-K-4"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スートコントラクトに対してA-K-4を持っている"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tegen een troefcontract heb je A-K-4"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เจอสัญญามีทรัมป์ และคุณถือ A-K-4"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kozlu kontrata karşı elinizde A-K-4 var"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "對有王合約，你持有 A-K-4"
          }
        }
      }
    },
    "Against notrump": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Mod sans"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gegen Sans Atout"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κατά χωρίς ατού"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Contre sans-atout"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Contro il senza atout"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ノートランプに対して"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tegen sans atout"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อเจอโนทรัมป์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sanzatuya karşı"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "對無王"
          }
        }
      }
    },
    "Against notrump you lead your longest suit. From K-9-7-4-2, which card is the standard lead?": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Mod sans spiller du din længste farve ud. Hvilket kort er standardudspillet fra K-9-7-4-2?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gegen Sans Atout spielst du deine längste Farbe aus. Welche Karte ist aus K-9-7-4-2 das Standardausspiel?"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κατά χωρίς ατού βγάζετε το μακρύτερο χρώμα. Από K-9-7-4-2, ποιο είναι το κλασικό βγάλσιμο;"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Contre sans-atout, vous entamez votre plus longue. De K-9-7-4-2, quelle est l'entame standard ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Contro il senza attacchi nel seme più lungo. Da K-9-7-4-2, qual è l'attacco standard?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ノートランプに対しては最も長いスートをリードします。K-9-7-4-2からの標準的なリードは？"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tegen sans atout kom je uit in je langste kleur. Welke kaart is uit K-9-7-4-2 de standaarduitkomst?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อเจอโนทรัมป์ให้ลีดชุดที่ยาวที่สุด จาก K-9-7-4-2 ไพ่ลีดมาตรฐานคือใบไหน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sanzatuya karşı en uzun renginizden atak yaparsınız. K-9-7-4-2'den standart atak hangi karttır?"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "對無王首攻最長的花色。K-9-7-4-2 的標準首攻是哪張？"
          }
        }
      }
    },
    "Against notrump, a long suit is your best chance to establish extra tricks. Without a sequence, lead a low card.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Mod sans er en lang farve din bedste chance for at spille ekstra stik fri. Uden sekvens spiller du et lille kort ud."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gegen Sans Atout ist eine lange Farbe deine beste Chance, Extrastiche zu entwickeln. Ohne Sequenz spielst du eine kleine Karte aus."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κατά χωρίς ατού, ένα μακρύ χρώμα είναι η καλύτερη ευκαιρία να ελευθερώσετε επιπλέον λεβέ. Χωρίς σεκάνς βγάλτε μικρό φύλλο."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Contre sans-atout, une longue couleur est votre meilleure chance d'affranchir des levées. Sans séquence, entamez petit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Contro il senza, un seme lungo è la tua migliore occasione per affrancare prese extra. Senza sequenza, attacca con una piccola."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ノートランプに対しては、長いスートが追加のトリックを確立する最大のチャンスです。シークエンスがなければ小さいカードをリードします。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tegen sans atout is een lange kleur je beste kans om extra slagen vrij te spelen. Zonder sequentie kom je klein uit."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อเจอโนทรัมป์ ชุดยาวคือโอกาสดีที่สุดในการสร้างทริกเพิ่ม ถ้าไม่มีไพ่เรียงให้ลีดใบเล็ก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sanzatuya karşı uzun renk, ek löve kurmak için en iyi şansınızdır. Sekans yoksa küçük kartla atak yapın."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "對無王時，長門是樹立額外贏墩的最佳機會。沒有連張就首攻小牌。"
          }
        }
      }
    },
    "All %lld cards down. They'll stick a little better every pass.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle %lld kort sidder. De hænger lidt bedre fast for hver runde."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle %lld Karten sitzen. Mit jeder Runde bleiben sie etwas besser hängen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Και οι %lld κάρτες εμπεδώθηκαν. Με κάθε πέρασμα μένουν λίγο περισσότερο."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les %lld fiches sont acquises. Elles resteront un peu mieux à chaque passage."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutte le %lld schede imparate. A ogni giro restano un po' di più."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld枚すべてクリア。繰り返すほど身につきます。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle %lld kaarten zitten erin. Bij elke ronde blijven ze beter hangen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จำได้ครบทั้ง %lld ใบ ทุกรอบจะยิ่งจำได้แม่นขึ้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld kartın hepsi tamam. Her turda biraz daha akılda kalırlar."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 張卡片都熟了。每練一輪都記得更牢。"
          }
        }
      }
    },
    "Always play an ace": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Spil altid et es"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Immer ein Ass spielen"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Παίζετε πάντα άσο"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toujours jouer un as"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Giocare sempre un asso"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "必ずエースを出す"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Altijd een aas spelen"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลงเอซเสมอ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her zaman as oynamak"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一定出 A"
          }
        }
      }
    },
    "An ace is worth 4 HCP. Kings are 3, queens 2, and jacks 1.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Et es er 4 HP værd. Konger tæller 3, damer 2 og knægte 1."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Ass ist 4 FP wert. Könige zählen 3, Damen 2 und Buben 1."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ένας άσος αξίζει 4 πόντους. Οι ρηγάδες 3, οι ντάμες 2 και οι βαλέδες 1."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un as vaut 4 points H. Les rois valent 3, les dames 2 et les valets 1."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un asso vale 4 punti. I re valgono 3, le donne 2 e i fanti 1."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エースは4点。キングは3点、クイーンは2点、ジャックは1点です。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een aas is 4 punten waard. Heren tellen 3, vrouwen 2 en boeren 1."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เอซมีค่า 4 แต้ม คิง 3 ควีน 2 และแจ็ค 1"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir as 4 puan eder. Papazlar 3, kızlar 2, valeler 1 sayılır."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "A 值 4 點，K 3 點，Q 2 點，J 1 點。"
          }
        }
      }
    },
    "An ace with no king behind it is worth more later, when it can capture a king or queen. Leading it early can let declarer's king or queen win a trick it could never have won otherwise.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Et es uden kongen bag sig er mere værd senere, når det kan fange en konge eller dame. Spilles det ud tidligt, kan spilførerens konge eller dame få et stik, de aldrig ellers ville have fået."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Ass ohne König dahinter ist später mehr wert, wenn es einen König oder eine Dame fangen kann. Früh ausgespielt, kann es dem König oder der Dame des Alleinspielers einen Stich schenken, den sie sonst nie gemacht hätten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ένας άσος χωρίς ρήγα πίσω του αξίζει περισσότερο αργότερα, όταν μπορεί να πιάσει ρήγα ή ντάμα. Αν βγει νωρίς, μπορεί να χαρίσει στον ρήγα ή τη ντάμα του εκτελεστή μια λεβέ που αλλιώς δεν θα έπαιρναν ποτέ."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un as sans le roi derrière vaut davantage plus tard, quand il peut capturer un roi ou une dame. L'entamer tôt peut offrir au roi ou à la dame du déclarant une levée qu'ils n'auraient jamais faite."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un asso senza il re dietro vale di più più tardi, quando può catturare un re o una donna. Attaccarlo presto può regalare al re o alla donna del dichiarante una presa che non avrebbero mai fatto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "後ろにキングのないエースは、キングやクイーンを捕まえられる後半のほうが価値があります。早くリードすると、ディクレアラーのキングやクイーンが本来取れないトリックを取ってしまうことがあります。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een aas zonder heer erachter is later meer waard, als hij een heer of vrouw kan vangen. Te vroeg uitkomen kan de heer of vrouw van de leider een slag geven die ze anders nooit hadden gemaakt."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เอซที่ไม่มีคิงหนุนจะมีค่ามากกว่าในภายหลังเมื่อจับคิงหรือควีนได้ การลีดเร็วอาจทำให้คิงหรือควีนของดีแคลร์เรอร์ได้ทริกที่ไม่มีทางได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arkasında papaz olmayan as, bir papaz veya kızı yakalayabileceği sonraki anlarda daha değerlidir. Erken oynanırsa deklaranın papaz veya kızına asla alamayacağı bir löve hediye edebilir."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "後面沒有 K 的 A，留到能抓 K 或 Q 時更有價值。太早首攻，可能讓莊家的 K 或 Q 拿到本來拿不到的一墩。"
          }
        }
      }
    },
    "An unsupported ace is often more valuable as an entry or capture later. Do not automatically cash aces on opening lead.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Et ubeskyttet es er ofte mere værd senere, som indkomst eller til at fange med. Indkassér ikke automatisk esser i udspillet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein ungestütztes Ass ist später oft mehr wert, als Übergang oder um etwas zu fangen. Ziehe beim Ausspiel nicht automatisch Asse ab."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ένας ακάλυπτος άσος συχνά αξίζει περισσότερο αργότερα, ως είσοδος ή για να πιάσει κάτι. Μην εισπράττετε άσους αυτόματα στο πρώτο βγάλσιμο."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un as non soutenu vaut souvent plus tard, comme reprise ou pour capturer. N'encaissez pas vos as d'office à l'entame."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un asso non protetto spesso vale di più più tardi, come rientro o per catturare. Non incassare gli assi d'attacco per abitudine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サポートのないエースは、後でエントリーや捕獲に使うほうが価値があることが多いです。オープニングリードで機械的にエースを取らないこと。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een kale aas is later vaak meer waard, als ingang of om iets te vangen. Incasseer azen niet automatisch bij de uitkomst."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เอซที่ไม่มีไพ่หนุนมักมีค่ามากกว่าในภายหลัง เป็นทางเข้าหรือจับไพ่สูง อย่าเก็บเอซตอนลีดเปิดโดยอัตโนมัติ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Desteksiz bir as çoğu zaman sonra, giriş veya yakalama kartı olarak daha değerlidir. İlk atakta asları otomatik almayın."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有搭配的 A 常常留到後面更有價值，可以當橋引或抓大牌。首攻時不要反射性地兌現 A。"
          }
        }
      }
    },
    "Announcing your points aloud": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "At sige sine point højt"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die eigenen Punkte laut ansagen"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Να ανακοινώσετε τους πόντους σας δυνατά"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Annoncer ses points à voix haute"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Annunciare i propri punti ad alta voce"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分の点数を声に出す"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je punten hardop noemen"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "พูดแต้มของตัวเองออกมา"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Puanlarınızı yüksek sesle söylemek"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "大聲報出點數"
          }
        }
      }
    },
    "Answer a few questions and your accuracy for every room shows up here.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Svar på et par spørgsmål, så vises din træfsikkerhed for hvert rum her."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beantworte ein paar Fragen, dann erscheint hier deine Trefferquote für jeden Raum."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Απαντήστε σε μερικές ερωτήσεις και η ακρίβειά σας για κάθε αίθουσα θα εμφανιστεί εδώ."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Répondez à quelques questions et votre précision pour chaque salle s'affichera ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rispondi a qualche domanda e qui vedrai la precisione per ogni sala."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いくつか問題に答えると、部屋ごとの正答率がここに表示されます。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Beantwoord een paar vragen en hier verschijnt je nauwkeurigheid per kamer."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตอบคำถามสักหน่อย ความแม่นยำของแต่ละห้องจะแสดงที่นี่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Birkaç soru cevaplayın, her odanın isabeti burada görünsün."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "回答幾題後，每個房間的正確率就會顯示在這裡。"
          }
        }
      }
    },
    "Answer a few questions here to start tracking.": {
      "extractionState": "manual",
      "localizations": {
