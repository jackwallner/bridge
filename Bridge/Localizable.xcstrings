          "stringUnit": {
            "state": "translated",
            "value": "Bridge Minute, Spielabend-Vorbereitung, Endlosmodi und %lld weitere Übungen in allen Räumen"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Bridge Minute, προετοιμασία βραδιάς, ατελείωτες λειτουργίες και %lld ακόμη ασκήσεις σε κάθε αίθουσα"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bridge Minute, la prépa soirée, les modes infinis et %lld exercices de plus dans toutes les salles"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Bridge Minute, Prepara la serata, modalità infinite e %lld esercizi in più in tutte le sale"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Bridge Minute、ブリッジの夜の準備、エンドレスモード、さらに全部屋で%lld個の練習"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bridge Minute, speelavond-prep, eindeloze modi en nog %lld oefeningen in elke kamer"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Bridge Minute เตรียมคืนบริดจ์ โหมดไม่จำกัด และอีก %lld ชุดฝึกในทุกห้อง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bridge Minute, briç gecesi hazırlığı, sonsuz modlar ve tüm odalarda %lld alıştırma daha"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Bridge Minute、牌局夜準備、無限模式，以及各房間再多 %lld 項練習"
          }
        }
      }
    },
