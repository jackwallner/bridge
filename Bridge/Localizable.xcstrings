    "Lead the top of a touching honor sequence. It describes the holding and avoids giving away a cheap trick.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Spil det højeste kort fra en sammenhængende honnørsekvens ud. Det viser, hvilke honnører du har, og forærer ikke et billigt stik væk."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spiel die oberste Karte einer Honneursequenz aus. Sie zeigt deinem Partner, welche Karten du in der Farbe hältst, und verschenkt keinen billigen Stich."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Βγάλτε το πάνω φύλλο από σεκάνς ονέρ. Περιγράφει το χρώμα και δεν χαρίζει φτηνή λεβέ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desde una secuencia de honores consecutivos, sal con la carta más alta. Muestra tu tenencia y evita regalar una baza."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Entamez la carte la plus forte d'une séquence d'honneurs consécutifs. Cela décrit votre tenue et évite d'offrir une levée bon marché."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attacca l'onore più alto di una sequenza di onori contigui. Così descrivi la tenuta ed eviti di regalare una presa facile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "連続したオナーのシークエンスのトップをリードします。持ち札を伝え、安いトリックを与えません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이어지는 고카드 시퀀스에서는 가장 높은 카드를 리드하세요. 가진 카드를 알리면서 불필요한 트릭을 내주지 않을 수 있어요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Spill ut det øverste kortet i en sammenhengende honnørsekvens. Det viser makker kortene dine og unngår å gi bort et billig stikk."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kom uit met de hoogste van een aansluitende honneursequentie. Dat beschrijft je kleur en geeft geen goedkope slag weg."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Из готовой последовательности фигур выходят старшей картой. Это показывает партнёру вашу комбинацию и не отдаёт соперникам дешёвую взятку."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Från en sammanhängande honnörssekvens spelar du ut det högsta kortet. Det visar din hand och undviker att ge bort ett billigt stick."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลีดใบบนสุดของออนเนอร์ที่เรียงติดกัน บอกลักษณะไพ่และไม่เสียทริกง่าย ๆ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitişik onör sekansının en üstüyle atak yapın. Elinizi anlatır ve ucuz bir löve vermenizi önler."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "首攻連張大牌的頂張，既能說明你的持牌，也不會白送對手一墩。"
          }
        }
      }
    },
