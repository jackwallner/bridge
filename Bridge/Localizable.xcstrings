    "Ninety seconds, as many correct calls as you can manage, and a personal best to chase.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Halvfems sekunder, så mange rigtige meldinger som muligt og en personlig rekord at jagte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neunzig Sekunden, so viele richtige Gebote wie möglich und eine persönliche Bestmarke, die du knacken kannst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ενενήντα δευτερόλεπτα για όσες σωστές δηλώσεις προλάβετε και ένα προσωπικό ρεκόρ για να καταρρίψετε."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Noventa segundos, tantas llamadas correctas como puedas gestionar y una mejor marca personal que perseguir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quatre-vingt-dix secondes, un maximum de bonnes enchères et un record personnel à battre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Novanta secondi, quante più dichiarazioni giuste possibile e un record personale da inseguire."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "90秒でできるだけ多くのコールに正解して、自己ベストを目指しましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "90초, 관리할 수 있는 만큼의 정확한 통화 및 추적할 수 있는 개인 최고 기록입니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Nitti sekunder, så mange riktige anrop som du klarer, og en personlig rekord å jage."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Negentig seconden, zoveel mogelijk goede biedingen en een persoonlijk record om te verbeteren."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Девяносто секунд, столько правильных вызовов, сколько сможете, и личный рекорд, к которому нужно стремиться."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nittio sekunder, så många korrekta samtal du kan hantera och ett personbästa att jaga."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ในเวลา 90 วินาที เลือกคำประมูลให้ถูกให้ได้มากที่สุด แล้วไล่ทำสถิติส่วนตัว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Doksan saniyede olabildiğince çok doğru deklare verin, kişisel rekorunuzu kırmaya çalışın."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "九十秒內答對越多越好，挑戰個人紀錄。"
          }
        }
      }
    },
