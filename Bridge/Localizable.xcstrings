    "Keep going. Sharp means nearly everything here is holding.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fortsæt. Skarp betyder, at næsten alt her sidder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Weiter so. Sicher heißt, fast alles hier sitzt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Συνεχίστε. Το «Σε φόρμα» σημαίνει ότι σχεδόν όλα όσα μαθαίνετε εδώ έχουν εμπεδωθεί."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuez. Solide signifie que presque tout est acquis ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Continua così. Solido significa che quasi tutto qui regge."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その調子です。「好調」は、この部屋の内容をほぼ身につけている状態です。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ga zo door. Scherp betekent dat bijna alles hier blijft hangen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไปต่อ! ระดับคล่องหมายถึงคุณจำเนื้อหาเกือบทุกข้อในห้องนี้ได้แล้ว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Devam edin. Keskin, buradakilerin neredeyse tamamının oturduğu anlamına gelir."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "繼續加油。「熟練」表示這裡幾乎都記牢了。"
          }
        }
      }
    },
