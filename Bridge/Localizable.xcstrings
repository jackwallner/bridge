          "stringUnit": {
            "state": "translated",
            "value": "เริ่มทดลองใช้ฟรี"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ücretsiz denemenizi başlatın"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開始你的免費試用"
          }
        }
      }
    },
    "Stayman asks the 1NT opener whether they hold a four-card major.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Stayman spørger, om 1NT-åbneren har en firkorts højfarve."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stayman fragt den 1NT-Eröffner, ob er eine Viereroberfarbe hält."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Stayman ρωτά αυτόν που άνοιξε 1NT αν έχει τετράφυλλο μείζον."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Stayman le pregunta al abridor 1NT si tiene un mayor de cuatro cartas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le Stayman demande à l'ouvreur de 1NT s'il tient une majeure quatrième."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La Stayman chiede a chi ha aperto 1NT se ha un nobile quarto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ステイマンは、1NTでオープンした人に4枚のメジャーがあるかを尋ねます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Stayman은 1NT 오프너에게 4카드 메이저를 보유하고 있는지 묻습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Stayman spør 1NT-åpneren om de har en firekorts major."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stayman vraagt de 1NT-openaar of hij een vierkaart hoog heeft."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Стейман спрашивает открывающего игрока 1NT, есть ли у него четырехкарточная мажорная карта."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Stayman frågar 1NT-öppnaren om de har en fyra-korts major."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สเตย์แมนถามผู้เปิด 1NT ว่ามีเมเจอร์สี่ใบหรือไม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Stayman, 1NT açan oyuncuya elinde dörtlü majör olup olmadığını sorar."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "斯台曼詢問 1NT 開叫者是否有四張高花。"
          }
        }
      }
    },
    "Still checking what this Apple Account owns. Try again in a moment, or tap Restore.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi tjekker stadig, hvad denne Apple-konto ejer. Prøv igen om lidt, eller tryk på Gendan."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir prüfen noch, was zu diesem Apple Account gehört. Versuch es gleich noch einmal oder tippe auf Wiederherstellen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ελέγχουμε ακόμη ποιες αγορές συνδέονται με αυτόν τον λογαριασμό Apple. Δοκιμάστε ξανά σε λίγο ή πατήστε Επαναφορά."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía comprobando qué posee esta cuenta de Apple. Inténtalo de nuevo en un momento o toca Restaurar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous vérifions encore ce que possède ce compte Apple. Réessayez dans un instant ou touchez Restaurer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Stiamo ancora verificando cosa possiede questo Account Apple. Riprova tra un attimo o tocca Ripristina."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このApple Accountの購入内容を確認中です。少し待ってからもう一度試すか、「復元」をタップしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Apple 계정이 무엇을 소유하고 있는지 확인하는 중입니다. 잠시 후에 다시 시도하거나 복원을 탭하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sjekker fortsatt hva denne Apple-kontoen eier. Prøv igjen om et øyeblikk, eller trykk på Gjenopprett."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "We controleren nog welke aankopen bij dit Apple-account horen. Probeer het zo opnieuw of tik op Herstel."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все еще проверяю, чем владеет эта учетная запись Apple. Повторите попытку через минуту или нажмите «Восстановить»."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrollerar fortfarande vad detta Apple-konto äger. Försök igen om ett ögonblick eller tryck på Återställ."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กำลังตรวจสอบว่าบัญชี Apple นี้มีอะไรบ้าง ลองอีกครั้งในอีกสักครู่ หรือแตะกู้คืน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Apple Hesabına bağlı satın alımları hâlâ kontrol ediyoruz. Biraz sonra tekrar deneyin veya Geri yükle'ye dokunun."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "仍在確認這個 Apple 帳號的購買項目。請稍後再試，或點一下「恢復」。"
          }
        }
      }
    },
    "Still learning what the cards even are": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lærer stadig kortene at kende"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich lerne noch, was die Karten überhaupt sind"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μαθαίνω ακόμη τι είναι τα φύλλα"
          }
        },
        "es": {
