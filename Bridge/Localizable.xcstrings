    "%@, billed today. Auto-renews until canceled.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, betales i dag. Fornyes automatisk, indtil du opsiger det."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, Zahlung heute. Verlängert sich bis zur Kündigung."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, χρέωση σήμερα. Ανανεώνεται αυτόματα μέχρι να ακυρωθεί."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, con cargo hoy. Se renueva automáticamente hasta que canceles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, facturé aujourd'hui. Renouvellement automatique jusqu'à résiliation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, addebito oggi. Si rinnova fino alla disdetta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@、本日請求されます。解約するまで自動更新されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, 오늘 결제돼요. 취소할 때까지 자동 갱신돼요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ belastes i dag. Fornyes automatisk til du sier opp."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, vandaag gefactureerd. Je abonnement wordt automatisch verlengd tot je opzegt."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сегодня списывается %@. Автопродление до отмены."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ debiteras i dag. Förnyas automatiskt tills du säger upp det."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ชำระวันนี้ ต่ออายุอัตโนมัติจนกว่าจะยกเลิก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, bugün ödenir. İptal edene kadar yenilenir."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@，今天付款。取消前會自動續訂。"
          }
        }
      }
    },
