    "The five honors are ace, king, queen, jack, and ten. Only the top four carry high-card points.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "De fem honnører er es, konge, dame, knægt og ti. Kun de fire øverste giver honnørpoint."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die fünf Honneurs sind Ass, König, Dame, Bube und Zehn. Nur die oberen vier zählen Figurenpunkte."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι πέντε τιμές είναι άσος, ρήγας, ντάμα, βαλές και δέκα. Μόνο οι τέσσερις πρώτες δίνουν πόντους τιμής."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les cinq honneurs sont l'as, le roi, la dame, le valet et le dix. Seuls les quatre premiers comptent des points H."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I cinque onori sono asso, re, donna, fante e dieci. Solo i primi quattro valgono punti onori."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "5枚のオナーはエース、キング、クイーン、ジャック、10です。ハイカードポイントがあるのは上の4枚だけです。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De vijf honneurs zijn aas, heer, vrouw, boer en tien. Alleen de bovenste vier tellen honneurpunten."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ออนเนอร์ห้าใบคือเอซ คิง ควีน แจ็ค และสิบ มีแต้มไพ่สูงเฉพาะสี่ใบบน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Beş onör as, papaz, kız, vale ve ondur. Yalnızca ilk dördü onör puanı taşır."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "五張大牌是 A、K、Q、J 和 10。只有前四張計算大牌點。"
          }
        }
      }
    },
    "The five-card heart suit and opening strength point to 1♥.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Femkorts hjerter og åbningsstyrke peger på 1♥."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Fünfer-Coeur-Farbe und die Eröffnungsstärke sprechen für 1♥."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι πεντάφυλλες κούπες και η δύναμη ανοίγματος οδηγούν στο 1♥."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La couleur cinquième à cœur et la force d'ouverture mènent à 1♥."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il quinto di cuori e la forza d'apertura portano a 1♥."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "5枚のハートとオープンできる強さで1♥です。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De vijfkaart harten en de openingskracht wijzen naar 1♥."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โพแดงห้าใบและกำลังเปิดชี้ไปที่ 1♥"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Beşli kupa ve açış gücü 1♥'yi gösterir."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "五張紅心加上開叫實力，指向 1♥。"
          }
        }
      }
    },
    "The guideline is strongest when partner may hold the next lower honor.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Retningslinjen er stærkest, når makker kan have den næstlaveste honnør."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Regel greift am stärksten, wenn der Partner den nächstniedrigeren Honneur haben könnte."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η οδηγία ισχύει περισσότερο όταν ο συμπαίκτης μπορεί να έχει την αμέσως μικρότερη τιμή."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le principe est le plus fort quand le partenaire peut tenir l'honneur juste en dessous."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La regola vale di più quando il compagno può avere l'onore immediatamente inferiore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この指針は、パートナーがすぐ下のオナーを持っている可能性があるときに最も有効です。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De richtlijn is het sterkst als partner de eerstvolgende lagere honneur kan hebben."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หลักนี้ได้ผลที่สุดเมื่อคู่อาจถือออนเนอร์ที่ต่ำลงมาหนึ่งขั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kural, ortağın bir alttaki onöre sahip olabileceği durumda en güçlüdür."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "同伴可能持有下一張較小的大牌時，這個原則最有效。"
          }
        }
      }
    },
    "The opening lead": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Udspillet"
          }
        },
        "de": {
